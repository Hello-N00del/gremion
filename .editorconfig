# Keep a drive-by pull request from arriving as a whole-file reformat.
# Matches what the tree already is; this only stops an editor from disagreeing.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Tabs are syntax here, not style.
[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces is a markdown line break.
trim_trailing_whitespace = false
