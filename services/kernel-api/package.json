{
  "name": "@gremion/kernel-api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "The Gremion kernel API: tenancy resolution and the module registry (TASK-077, L3-17), spec-first on @gremion/fastify-service-template",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:integration": "node test/harness/stack.mjs",
    "test:authz-int": "node test/authz/stack.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.2",
    "@gremion/db": "workspace:*",
    "@gremion/events": "workspace:*",
    "@gremion/fastify-service-template": "workspace:*",
    "@gremion/nats-auth": "workspace:*",
    "@gremion/ports": "workspace:*",
    "@gremion/tenancy-core": "workspace:*",
    "@gremion/tenant-store": "workspace:*",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.6",
    "jose": "^6.2.12",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@gremion/module-catalogue": "workspace:*",
    "@types/node": "26.6.0",
    "esbuild": "^0.28.1",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "gremion": {
    "fastifyService": {
      "spec": "openapi/kernel-core.json",
      "app": "src/index.ts"
    }
  }
}
