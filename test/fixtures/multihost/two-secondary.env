collabora.DONT_GEN_SSL_CERT=YES
collabora.aliasgroup1=http://nextcloud:80
collabora.dictionaries=de_DE en_GB en_US
collabora.extra_params=--o:ssl.enable=false --o:ssl.termination=true --o:net.service_root=/office
collabora.gremion_unset_server_name=a.example.test
nextcloud.COLLABORA_PUBLIC_URL=https://a.example.test/office
nextcloud.NEXTCLOUD_PUBLIC_HOSTS=a.example.test,b.example.test,c.example.test
