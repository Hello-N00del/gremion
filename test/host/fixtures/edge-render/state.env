# test/host/fixtures/edge-render/state.env
#
# The FIXED env file scripts/check-compose-edge.test.mjs renders the production
# composition with (TASK-022). It is shaped like the host's rendered state.env
# (infra/host/templates/env/state.env.tmpl) so the guard measures the command
# the host runs -- `docker compose --env-file <state.env> config` -- and never
# the developer's own .env or shell.
#
# Documentation-range addresses only (RFC 5737 / RFC 3849): this repository is
# public, and the guard needs values it can tell apart from loopback and from
# the all-interfaces wildcard, not real ones.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
COMPOSE_PATH_SEPARATOR=:
COMPOSE_PROFILES=production

STACK=guardstack
GREMION_ROOT=/srv/guardstack
DOMAIN=guard.example.org
PLATFORM_DOMAIN=guard.example.org

EDGE_BIND_IP=203.0.113.10
EDGE_BIND_IP6=2001:db8::10
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
TRAEFIK_API_PORT=8080
INTERNALTEST_PORT=8081
EDGE_V4_SUBNET=10.90.0.0/24
EDGE_V6_SUBNET=fd5a:90::/64

ACME_EMAIL=acme@guard.example.org
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
TRAEFIK_CERT_RESOLVER=le-http
