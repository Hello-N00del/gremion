# test/host/fixtures/pooled-stack/state.env
#
# The FIXED env file scripts/check-pooled-stack.mjs renders the STATE project
# with (TASK-040). Shaped like the host's rendered state.env
# (infra/host/templates/env/state.env.tmpl): COMPOSE_FILE names the two state
# files plus a fixture STATE pins layer, because docker-compose.state-pins.yml
# (TASK-048b) is a release output that is never committed. Documentation-range addresses only (RFC 5737 /
# RFC 3849); no value here is a real host, address or credential.
COMPOSE_PROJECT_NAME=guardstack-state
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml:test/host/fixtures/pooled-stack/docker-compose.state-pins.yml
COMPOSE_PATH_SEPARATOR=:
COMPOSE_PROFILES=production

STACK=guardstack
GREMION_ROOT=/srv/guardstack
PLATFORM_DOMAIN=guard.example.org
DOMAIN=guard.example.org
IMAGE_TAG=dist-v0.0.0

EDGE_BIND_IP=203.0.113.10
EDGE_BIND_IP6=2001:db8::10
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
TRAEFIK_API_PORT=8080
INTERNALTEST_PORT=8081
EDGE_V4_SUBNET=10.90.0.0/24
EDGE_V6_SUBNET=fd5a:90::/64
STATE_V4_SUBNET=10.90.1.0/24
STATE_V6_SUBNET=fd5a:91::/64

ACME_EMAIL=acme@guard.example.org
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
TRAEFIK_CERT_RESOLVER=le-http
