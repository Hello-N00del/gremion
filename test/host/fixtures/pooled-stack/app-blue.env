# test/host/fixtures/pooled-stack/app-blue.env
#
# The FIXED env file scripts/check-pooled-stack.mjs renders the app-blue project
# with (TASK-040). Shaped like infra/host/templates/env/app.env.tmpl rendered for
# COLOUR=blue. Every secret is a placeholder, never a credential.
STACK=guardstack
COLOUR=blue
COMPOSE_PROJECT_NAME=guardstack-app-blue
COMPOSE_FILE=docker-compose.app.yml:test/host/fixtures/pooled-stack/docker-compose.pins.yml
COMPOSE_PATH_SEPARATOR=:
COMPOSE_PROFILES=production

APP_V4_SUBNET=10.90.2.0/24
APP_V6_SUBNET=fd5a:92::/64

PLATFORM_DOMAIN=guard.example.org
IMAGE_TAG=dist-v0.0.0

INTERNAL_BASE_URL=http://gremion-ui-blue:3000
KERNEL_BASE_URL=http://gremion-ui-blue:3000

GREMION_DB_USER=gremion
GREMION_DB_NAME=gremion
GREMION_DB_PASSWORD=fixture-not-a-secret
CONTROL_DB_USER=control
CONTROL_DB_NAME=control
CONTROL_DB_PASSWORD=fixture-not-a-secret
PUBLIC_DB_PASSWORD=fixture-not-a-secret
PLATFORM_DB_USER=gremion_platform
PLATFORM_DB_PASSWORD=fixture-not-a-secret
PANEL_DB_USER=gremion_panel
PANEL_DB_PASSWORD=fixture-not-a-secret

AUTH_SECRET=fixture-not-a-secret
AUTH_KEYCLOAK_ID=gremion-ui
AUTH_KEYCLOAK_SECRET=fixture-not-a-secret
KEYCLOAK_ADMIN_CLIENT_SECRET=fixture-not-a-secret
INTERNAL_PUSH_SECRET=fixture-not-a-secret
TENANT_PROXY_SHARED_SECRET=fixture-not-a-secret

SEED_TOKEN=
GREMION_DISABLE_SEEDS=true
# TASK-077: kernel-api / kernel-api-migrate
KERNEL_API_DB_PASSWORD=fixture-not-a-secret
UI_OAC_DB_PASSWORD=fixture-not-a-secret
UI_MODULES_DB_PASSWORD=fixture-not-a-secret
KARENZ_FINAL_DELETION=off
POSTGRES_PASSWORD=fixture-not-a-secret
GREMION_MIGRATION_DUMP_DIR=/opt/gremion/migration-dumps

# The pilot's services and leaves (infra/host/templates/env/app.env.tmpl): placeholders, never credentials.
PILOT_TENANT_HOST=pilot.guard.example.org
NEXTCLOUD_ADMIN_PASSWORD=fixture-not-a-secret
LIVEKIT_API_KEY=fixture-livekit-key
LIVEKIT_API_SECRET=fixture-not-a-secret
INTERNAL_CALENDAR_SECRET=fixture-not-a-secret
INTERNAL_CONTENT_SECRET=fixture-not-a-secret
INTERNAL_NEWSLETTER_SECRET=fixture-not-a-secret
CALENDAR_PG_PASSWORD=fixture-not-a-secret
CONTENT_PG_PASSWORD=fixture-not-a-secret
NEWSLETTER_PG_PASSWORD=fixture-not-a-secret
