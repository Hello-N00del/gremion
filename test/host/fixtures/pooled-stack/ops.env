# test/host/fixtures/pooled-stack/ops.env
#
# The FIXED env file scripts/check-pooled-stack.mjs renders the non-council ops
# project with (TASK-040), from infra/host/ops. Shaped like
# infra/host/templates/env/ops.env.tmpl rendered.
STACK=guardstack
COMPOSE_PROJECT_NAME=guardstack-ops
COMPOSE_FILE=docker-compose.yml
COMPOSE_PATH_SEPARATOR=:
COMPOSE_PROFILES=production
OPS_V4_SUBNET=10.90.8.0/24
OPS_V6_SUBNET=fd5a:98::/64
GREMION_ROOT_DIR=/srv/guardstack
OPS_BIND_IP=127.0.0.1
OPS_UID=1000
OPS_GID=1000
PROM_RETENTION_TIME=90d
