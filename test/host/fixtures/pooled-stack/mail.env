# test/host/fixtures/pooled-stack/mail.env
#
# The FIXED env file scripts/check-pooled-stack.mjs renders the non-council mail
# project with (TASK-040), from infra/host/mail. Shaped like
# infra/host/templates/env/mail.env.tmpl rendered; documentation-range
# addresses only, and a placeholder image reference (the guard renders, it
# never pulls).
STACK=guardstack
GREMION_ROOT=/srv/guardstack
COMPOSE_PROJECT_NAME=guardstack-mail
COMPOSE_FILE=docker-compose.yml
COMPOSE_PATH_SEPARATOR=:
COMPOSE_PROFILES=mail
PLATFORM_DOMAIN=guard.example.org
MAIL_BIND_IP=203.0.113.20
MAIL_BIND_IP6=2001:db8::20
MAIL_V4_SUBNET=10.90.9.0/24
MAIL_V6_SUBNET=fd5a:99::/64
MAIL_LOG_RETENTION_DAYS=7
STALWART_IMAGE=docker.io/stalwartlabs/stalwart:fixture
