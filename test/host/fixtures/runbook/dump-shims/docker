#!/usr/bin/env bash
# Shim for runbook.bats' behavioural test of upgrade.md step 3 (R29-MD-A).
# It stands in for `docker compose ... exec -T <svc> pg_dump ...` and records HOW
# the file it is about to write was created: its own fd 1 is that file, and its
# mode at this instant is the mode the file had from its first byte (a chmod
# afterwards cannot change what this reads). $SIDE and $CALLS name the record.
case "$*" in
    *pg_dump*)
        m="$(stat -L -c %a /proc/$$/fd/1)"
        printf '%s\n' "$m" > "$SIDE"
        printf 'pg_dump\n' >> "$CALLS"
        printf 'PGDMP-shim-bytes\n'
        ;;
    *)
        printf 'docker-shim: unexpected call: %s\n' "$*" >&2
        exit 64
        ;;
esac
