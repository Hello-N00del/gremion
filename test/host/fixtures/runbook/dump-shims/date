#!/usr/bin/env bash
# Shim for runbook.bats (R29-MD-A): with FAKE_STAMP set, the runbook's own
# `date -u +%Y%m%dT%H%M%SZ` prints that stamp, so two attempts can be made to
# land in the same second. Every other call is the real date.
if [ -n "${FAKE_STAMP:-}" ] && [[ "$*" == *'%Y%m%dT%H%M%SZ'* ]]; then
    printf '%s\n' "$FAKE_STAMP"
else
    exec /bin/date "$@"
fi
