#!/usr/bin/env bash
# gremion-tenant of a fake release tree, called by the reconcile stage as `reconcile <slug> --apply ...`.
# One line per call: the verb, whether the host lock is declared held, whether a request id was given,
# the tree this very file lives in, and what the host lock looks like to a second descriptor.
slug="${2:-}"
lockrc=0
flock -n "$GREMION_ROOT/runtime/hostd.lock" true || lockrc=$?
printf 'tenant verb=%s held=%s request=%s tree=%s lockrc=%s\n' "${1:-}" "${GREMION_HOST_LOCK_HELD:-unset}" \
    "$([ -n "${GREMION_EXECUTOR_REQUEST_ID:-}" ] && echo set || echo unset)" \
    "$(basename "$(dirname "$(dirname "$(dirname "$0")")")")" "$lockrc" >> "$DK/tenant.log"
printf '%s\n' "$slug" >> "$DK/tenant.slugs"
echo "reconciled"
[ -f "$DK/tenant.fail.$slug" ] && exit 1
exit 0
