# ops.env — the ${STACK}-ops compose project (section K, N15; TASK-039:
# compose/observability/, COMPOSE_FILE is relative to that directory).
#
#     docker compose --env-file /opt/gremion/etc/env/ops.env <verb>
#
# On-box observability only. The off-box uptime probe and the off-box alert
# channel of N15 are the signals that survive the host being down, and they are
# configured outside this file, by the operator.
#
# OWNERSHIP. Task 11's render-ops.sh CONSUMES ALERT_SMTP_USER,
# ALERT_SMTP_PASSWORD and STALWART_API_KEY from this file and must not append
# its own copy of any of them: load_env refuses a duplicated key with exit 2,
# which would disable every ops.env consumer at once. The bats test
# "no rendered env file declares a key twice" is the guard.

STACK=${STACK}
COMPOSE_PROJECT_NAME=${STACK}-ops
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROFILES=production

OPS_V4_SUBNET=10.90.8.0/24
OPS_V6_SUBNET=fd5a:98::/64

PLATFORM_DOMAIN=CHANGE_ME_OPERATOR_platform_domain
# Both edge bind addresses are declared HERE, not only in state.env: Task 11's
# render-ops.sh loads ops.env and nothing else, and a key it cannot read is a
# listener bound to every address instead of the one the operator chose. Same
# spelling and same operator sentinel as state.env, so the two files are filled
# in from one answer.
EDGE_BIND_IP=CHANGE_ME_OPERATOR_edge_bind_ip
EDGE_BIND_IP6=CHANGE_ME_OPERATOR_edge_bind_ip6
EDGE_HTTP_PORT=80

# The mail transport (mail.env owns it; render-ops refuses a value that differs
# from mail.env). REQUIRED, NO DEFAULT. relay: no stalwart scrape, no mail
# probes, no MailQueueOldest1h rule, and Grafana's alert mail goes through the
# relay (ALERT_SMTP_HOST/PORT/USER below must equal the RELAY_* keys, the
# password is read from the relay's file secret ref, never from this file).
MAIL_TRANSPORT=CHANGE_ME_OPERATOR_mail_transport
RELAY_SMTP_HOST=smtp-relay.gmail.com
RELAY_SMTP_PORT=587
RELAY_SMTP_USER=
RELAY_SMTP_PASSWORD_REF=secret:mail/relay-password

ALERT_WEBHOOK_URL=CHANGE_ME_OPERATOR_alert_webhook_url
ALERT_EMAIL_TO=CHANGE_ME_OPERATOR_alert_email_to

# Grafana's alerting (TASK-039; Alertmanager until then) authenticates to the
# vendor's own Stalwart on submission as alerts@<PLATFORM_DOMAIN> (TASK-015),
# at ALERT_SMTP_HOST:ALERT_SMTP_PORT (mail.<PLATFORM_DOMAIN>:587). ALERT_SMTP_PASSWORD is the alert_smtp
# sentinel group, shared with mail.env's ALERT_SMTP_PASSWORD (provision-roles.sh
# sets the principal from there) and with nothing else: no council-facing tier
# holds it. This is the key name Task 11's render-ops.sh reads from this file;
# it appends no copy of it. ALERT_SMTP_USER and ALERT_EMAIL_FROM below must both
# be alerts@<PLATFORM_DOMAIN>; ops/vendor-mail/check-identities.mjs asserts it.
ALERT_SMTP_HOST=CHANGE_ME_OPERATOR_alert_smtp_host
ALERT_SMTP_PORT=587
# MandatoryStartTLS for 587. Port 465 (implicit TLS) must set NoStartTLS; render-ops refuses any other pairing.
ALERT_SMTP_STARTTLS_POLICY=MandatoryStartTLS
ALERT_SMTP_USER=CHANGE_ME_OPERATOR_alert_smtp_user
ALERT_SMTP_PASSWORD=CHANGE_ME_GEN_alnum32_alert_smtp

# Read by Task 11's render-ops.sh for the Stalwart queue/health integration.
# Same sentinel group as mail.env, so both are equal (state.env no longer
# carries it: it had no reader there, TASK-015).
STALWART_API_KEY=CHANGE_ME_GEN_hex32_stalwart_api

# NOTE: no BACKUP_STATE_FILE / VERIFY_STATE_FILE keys. Task 11's
# metrics-textfile.sh reads /opt/gremion/runtime/last-backup.json and
# last-verify.json by their fixed section-A layout paths; a second, editable
# spelling of the same path is a divergence waiting to happen and no task
# would read it.
HEALTH_EXEMPT_SERVICES=

# --- ops project (Task 11) -------------------------------------------------
# GREMION_ROOT_DIR is what the compose file interpolates into its bind mounts;
# it must equal the host root the units pass as GREMION_ROOT. It is a LITERAL
# path, never a render token: gremion-init-secrets substitutes only the STACK
# and COLOUR placeholders in this template, and its own post-condition refuses
# any other placeholder that survives into etc/env/ops.env, because compose
# would then mount a path beginning "/current/".
GREMION_ROOT_DIR=/opt/gremion
# Loopback only. render-ops.sh refuses a wildcard here (exit 2). Grafana is
# the only published port of the project; reach it with:
#   ssh -N -L 3000:127.0.0.1:3000 <deploy-user>@<host>
OPS_BIND_IP=127.0.0.1
OPS_UID=CHANGE_ME_OPERATOR_ops_uid
OPS_GID=CHANGE_ME_OPERATOR_ops_gid
# R29-I6: 30 days at most for every store, worst case. Prometheus deletes whole
# blocks (up to 10 % of the window) after a 2-hourly compaction, so 27d keeps
# the oldest sample under 30 days (27 + 2.7 d + 2 h); render-ops.sh refuses more.
PROM_RETENTION_TIME=27d
ALERT_EMAIL_FROM=CHANGE_ME_OPERATOR_alert_email_from
# STALWART_API_KEY is declared above in this file (sentinel group stalwart_api,
# shared with mail.env) and is NOT repeated here.
OPS_TENANT_HOSTS_FILE=/opt/gremion/etc/tenant-hosts.txt

# --- observability (TASK-039) ----------------------------------------------
# Q15: the receive-only OTLP ingest (Alloy, 4317/4318) is published on the
# ${STACK}_state bridge's gateway address (STATE_V4_SUBNET in state.env), where
# a council container reaches it through the host. Never a wildcard.
OPS_INGEST_BIND_IP=10.90.1.1
# The bearer token every OTLP sender presents (TASK-116 builds the senders).
OTLP_INGEST_TOKEN=CHANGE_ME_GEN_hex32_otlp_ingest
# PRD-DEP-002: <service>=<url> pairs, space-separated, probed from the ops
# network (probe_success{kind="third_party"}). Empty: no third-party probe.
OPS_THIRD_PARTY_PROBES=
# TRD-205 quiet hours: the operator's active hours. Outside them non-critical
# alerts are held and sent as one digest when the window opens; critical
# alerts always go out at once. TZ is an IANA name, START/END are HH:MM (END may
# be 24:00), WEEKDAYS a Grafana weekday range or comma list (monday:friday).
OPS_ACTIVE_HOURS_TZ=Europe/Berlin
OPS_ACTIVE_HOURS_START=08:00
OPS_ACTIVE_HOURS_END=20:00
OPS_ACTIVE_HOURS_WEEKDAYS=monday:friday
# TRD-224, read by the host collector (metrics-textfile.sh). Empty
# GREMION_DISK_ROOT = Docker's data root (docker info). Empty
# GREMION_STORAGE_COMPONENTS = every Postgres and the Vector volume of the
# state project; otherwise space-separated <component>=<path> pairs.
GREMION_DISK_ROOT=
GREMION_STORAGE_COMPONENTS=
# TRD-223, read by the weekly footprint script (footprint.sh, TASK-039-FU): the
# host directory that holds the councils' file store, laid out as
# <root>/<tenant uuid>/... (the @gremion/storage local backend). Empty = the
# council file-store component is reported ABSENT, never 0: no compose file
# mounts the storage root yet (the app-compose owner does, then sets this).
GREMION_FOOTPRINT_FILESTORE_ROOT=
# Optional: the compose project holding postgres and nats when it is not
# ${STACK}-state (a single-project layout). Empty: ${STACK}-state.
GREMION_STATE_PROJECT=
