# state.env — the ${STACK}-state compose project (spec A section E, N20).
#
# Rendered by gremion-init-secrets from templates/env/state.env.tmpl.
# The ONE permitted host command against this project is:
#     docker compose --env-file /opt/gremion/etc/env/state.env <verb>
# No -f, no --profile, no -p (N20): COMPOSE_PROJECT_NAME, COMPOSE_FILE and
# COMPOSE_PROFILES below carry all three.
#
# TWO SENTINEL SHAPES, both matching CHANGE_ME_ so one grep covers them:
#   a GENERATED sentinel (kind hex32 or alnum32, per <group>) -> gremion-init-secrets
#   CHANGE_ME_OPERATOR_<name>                                 -> the operator fills in before any `up`
# Keys sharing a <group> receive the SAME generated value. That is how the
# doubly-keyed OIDC secrets stay equal by construction rather than by a check
# somebody has to remember to run.
#
# No host literal ever belongs in this file's TEMPLATE. Real addresses and
# hostnames exist only in the rendered file on the host.

# -- Identity and composition --------------------------------------------
STACK=${STACK}
COMPOSE_PROJECT_NAME=${STACK}-state
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml:docker-compose.pins.yml
COMPOSE_PROFILES=production

# -- Domain and identity (section E) -------------------------------------
PLATFORM_DOMAIN=CHANGE_ME_OPERATOR_platform_domain
ACME_EMAIL=CHANGE_ME_OPERATOR_acme_email
# Empty means "internal CA" (staging). A non-empty value is all-or-nothing:
# either every router carries it, or no router carries a tls section (section C).
#
# STAGING PRECONDITION: a staging unit MUST BLANK this key before its first
# `gremion-render --staging`. That command exits 2 while TRAEFIK_CERT_RESOLVER is
# non-empty, so a staging root rendered from this template is unrenderable until
# the operator empties the value. Production leaves it exactly as shipped.
TRAEFIK_CERT_RESOLVER=le-http
# Fail-closed when empty: control.<domain> then admits nobody (N6, section C).
CONTROL_ALLOWLIST_CIDRS=CHANGE_ME_OPERATOR_control_allowlist_cidrs
KC_ADMIN_ALLOWLIST_CIDRS=127.0.0.1/32

# -- Bind addresses and ports (section A: nothing binds 0.0.0.0) ----------
EDGE_BIND_IP=CHANGE_ME_OPERATOR_edge_bind_ip
EDGE_BIND_IP6=CHANGE_ME_OPERATOR_edge_bind_ip6
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
MAIL_BIND_IP=CHANGE_ME_OPERATOR_mail_bind_ip
MAIL_BIND_IP6=CHANGE_ME_OPERATOR_mail_bind_ip6

# -- Pinned Docker subnets (section B; dual-stack, ULA v6) ---------------
EDGE_V4_SUBNET=10.90.0.0/24
EDGE_V6_SUBNET=fd5a:90::/64
STATE_V4_SUBNET=10.90.1.0/24
STATE_V6_SUBNET=fd5a:91::/64
APP_BLUE_V4_SUBNET=10.90.2.0/24
APP_BLUE_V6_SUBNET=fd5a:92::/64
APP_GREEN_V4_SUBNET=10.90.3.0/24
APP_GREEN_V6_SUBNET=fd5a:93::/64
MAIL_V4_SUBNET=10.90.9.0/24
MAIL_V6_SUBNET=fd5a:99::/64
OPS_V4_SUBNET=10.90.8.0/24
OPS_V6_SUBNET=fd5a:98::/64

# -- Release identity (section E) ----------------------------------------
# Set by gremion-deploy from the tag; the pins layer resolves every first-party
# image to a digest, so IMAGE_TAG is identity, not the pull reference.
IMAGE_TAG=CHANGE_ME_OPERATOR_image_tag
GREMION_DIST_MANIFEST=/opt/gremion/etc/gremion.dist.json

# -- Reserved names and health policy (section C, section K) -------------
RESERVED_HOSTS=www control rs1 mail mta-sts autoconfig autodiscover _dmarc
HEALTH_EXEMPT_SERVICES=minio-mc
# Byte-stable marker endpoint gremion-verify fetches per host (Task 6; spec B contract).
VERIFY_MARKER_PATH=/healthz
SOAK_MINUTES=30

# -- Backups (section J, N14, N21) ---------------------------------------
RESTIC_REPOSITORY=/opt/gremion/backups/repo
RESTIC_PASSWORD=CHANGE_ME_GEN_alnum32_restic_repo
RCLONE_REMOTE=backup
RCLONE_BUCKET=CHANGE_ME_OPERATOR_rclone_bucket
RCLONE_REMOTE_PATH=gremion-restic
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=6
# rclone reads a remote's definition from RCLONE_CONFIG_<REMOTE>_<OPTION>, so
# the remote named by RCLONE_REMOTE above is defined entirely by these keys and
# no rclone.conf file exists on the host. Provider-supplied: OPERATOR, not
# generated (N14 leaves the provider to the operator).
#
# gremion-backup's require_keys refuses the run, exit 2, while ANY of the five
# keys it names is unset, and REGION is one of them. It was missing here, so a
# freshly bootstrapped host could not produce a state.env its own backup would
# accept: the first live run died at the precondition and nothing in the render
# path or the suite said so beforehand. test/host/backup.bats now drives
# require_keys against the RENDERED file and compares its key list to this
# template, so the next drift in either direction is red without a host.
RCLONE_CONFIG_BACKUP_TYPE=CHANGE_ME_OPERATOR_rclone_type
RCLONE_CONFIG_BACKUP_PROVIDER=CHANGE_ME_OPERATOR_rclone_provider
RCLONE_CONFIG_BACKUP_ENDPOINT=CHANGE_ME_OPERATOR_rclone_endpoint
RCLONE_CONFIG_BACKUP_REGION=CHANGE_ME_OPERATOR_rclone_region
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=CHANGE_ME_OPERATOR_rclone_access_key_id
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=CHANGE_ME_OPERATOR_rclone_secret_access_key

# -- Alerting (N15, section K) -------------------------------------------
ALERT_WEBHOOK_URL=CHANGE_ME_OPERATOR_alert_webhook_url
ALERT_EMAIL_TO=CHANGE_ME_OPERATOR_alert_email_to

# -- PostgreSQL ----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_GEN_alnum32_postgres_root
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME_GEN_alnum32_keycloak_db
GREMION_DB_USER=gremion
GREMION_DB_NAME=gremion
GREMION_DB_PASSWORD=CHANGE_ME_GEN_alnum32_gremion_db
CONTROL_DB_USER=control
CONTROL_DB_NAME=control
CONTROL_DB_PASSWORD=CHANGE_ME_GEN_alnum32_control_db
PGBOUNCER_AUTH_PASSWORD=CHANGE_ME_GEN_alnum32_pgbouncer_auth
PUBLIC_DB_PASSWORD=CHANGE_ME_GEN_alnum32_public_reader
GREMION_PUBLIC_DB_URL=postgresql://gremion_public_reader:CHANGE_ME_GEN_alnum32_public_reader@postgres:5432/gremion

# -- Keycloak and OIDC ---------------------------------------------------
# The two aliased pairs: each pair shares one sentinel group, so both keys of a
# pair always hold the same value. substitute-realm-secrets.sh writes the
# GREMION_*_OIDC_CLIENT_SECRET half into the realm; the app reads the other.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_GEN_alnum32_keycloak_admin
AUTH_SECRET=CHANGE_ME_GEN_hex32_auth_secret
AUTH_KEYCLOAK_ID=gremion-ui
AUTH_KEYCLOAK_SECRET=CHANGE_ME_GEN_hex32_gremion_ui_oidc
GREMION_UI_OIDC_CLIENT_SECRET=CHANGE_ME_GEN_hex32_gremion_ui_oidc
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_GEN_hex32_gremion_admin_oidc
GREMION_ADMIN_OIDC_CLIENT_SECRET=CHANGE_ME_GEN_hex32_gremion_admin_oidc

# -- Secrets that ship EMPTY in the kernel .env.example (section G) ------
# All of them are generated here so validate-env's CHANGE_ME_ sweep covers them.
SYNAPSE_REGISTRATION_SHARED_SECRET=CHANGE_ME_GEN_hex32_synapse_registration
SYNAPSE_ADMIN_TOKEN=CHANGE_ME_GEN_hex32_synapse_admin
HELIOS_SECRET_KEY=CHANGE_ME_GEN_hex32_helios_secret
HELIOS_KEYCLOAK_CLIENT_SECRET=CHANGE_ME_GEN_hex32_helios_oidc
FINTS_PASSWORD_KEY=CHANGE_ME_GEN_hex32_fints_password_key

# -- Internal transport secrets ------------------------------------------
INTERNAL_PUSH_SECRET=CHANGE_ME_GEN_hex32_internal_push
TENANT_PROXY_SHARED_SECRET=CHANGE_ME_GEN_hex32_tenant_proxy
# Non-rotatable in place (section G): rotating it requires the documented
# re-encryption procedure, not a new value.
VAULT_ENCRYPTION_KEY=CHANGE_ME_GEN_hex32_vault_encryption

# -- Mail credentials the state tier hands to other projects -------------
STALWART_ADMIN_PASSWORD=CHANGE_ME_GEN_alnum32_stalwart_admin
STALWART_API_KEY=CHANGE_ME_GEN_hex32_stalwart_api
PLATFORM_SMTP_PASSWORD=CHANGE_ME_GEN_alnum32_platform_smtp

# -- Seeding: OFF, deliberately ------------------------------------------
# Go-live gate item 5 forbids fixture users in production. An EMPTY SEED_TOKEN
# disables POST /api/setup/seed outright, so these two keys are present (the
# parity guard requires the kernel's key set) and empty on purpose.
SEED_TOKEN=
SEED_USER_PASSWORD=
GREMION_DISABLE_SEEDS=true

# -- Log retention (hard caps enforced server-side) ----------------------
LOG_ACCESS_RETENTION_SECONDS=1209600
LOG_APP_RETENTION_SECONDS=2592000
LOG_SECURITY_RETENTION_SECONDS=7776000
LOG_SECURITY_NOPII_RETENTION_SECONDS=7776000
