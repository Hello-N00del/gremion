# etc/cd.env -- the configuration of gremion-cd (continuous deployment of this host).
#
# Written ONCE by `bootstrap.sh cd` and never overwritten after that: this file is the operator's.
# Mode 0640, owner the deploy user. The program PARSES it (it is never sourced): a line is
# KEY=VALUE, the value is taken literally, an unknown key stops the whole program (exit 2), and so
# does any value that still carries a CHANGE_ME_OPERATOR_ marker. A key you delete falls back to
# its default below; a key with no default (the operator values) must be set.
#
# Every operator value below is a placeholder. Nothing here names a real host, address or person.

# ---- operator values (no default: set them before the first run) ---------------------------
# https URL of the public repository the releases come from.
CD_REPO_URL=CHANGE_ME_OPERATOR_REPO_URL
# The ONE address every mail goes to. No second recipient exists.
CD_MAIL_TO=CHANGE_ME_OPERATOR_MAIL
# A short label for this host in mails and logs: lower case letters, digits and "-", at most 32.
# It must not be a host name or an address.
CD_HOST_LABEL=CHANGE_ME_OPERATOR_LABEL
# A customer host name the probes use. Empty means the first line of etc/tenant-hosts.txt.
CD_PROBE_HOST=CHANGE_ME_OPERATOR_PROBE_HOST
# Optional dead-man URL, called once per tick (never logged). Empty switches the ping off.
CD_PING_URL=
# The date the release-cadence agreement was recorded. Empty: no release starts.
CD_POLICY_ACK=
# Optional absolute path of a file that holds a GitHub token (read as a file, never an argument).
CD_GITHUB_TOKEN_FILE=
# Proof mode only: where the proof branches are fetched from, an https address or the absolute path of a
# local bare repository (a path is refused unless CD_PROOF_MODE=1). Empty otherwise.
CD_PROOF_REPO=

# ---- switches ------------------------------------------------------------------------------
# 1 lets a host without a working mail path release (the program then says so in its status).
CD_ALLOW_NO_MAIL=0
# 1 accepts a repository that allows more than squash merges. Leave it at 0.
CD_ALLOW_ANY_MERGE_METHOD=0
# 0: a failed gremion-verify is only reported. 1: it fails the release. Set it to 1 after
# gremion-verify has passed by hand on this host.
CD_VERIFY_ENFORCE=0
# PROOF MODE: 0 is the only value a host runs on. 1 is for the proof run before a real
# customer exists and shows in every status line and mail.
CD_PROOF_MODE=0

# ---- pick-up -------------------------------------------------------------------------------
# Hour of day (host time) of the daily "alive" mail.
CD_ALIVE_HOUR=8
# GitHub API calls per hour the program may spend.
CD_API_BUDGET_PER_HOUR=30
# Most commits one release may carry; a bigger batch is held.
CD_MAX_BATCH=50
# How far back the walk over the history of the main branch goes.
CD_WALKBACK=10
# How long a pending check run is waited for, in minutes.
CD_PENDING_MAX_MIN=90
# Windows (HH:MM-HH:MM, comma separated, host time) in which no release starts.
CD_QUIET_WINDOWS="01:45-03:15"

# ---- locks and the nightly jobs ------------------------------------------------------------
# Minutes of host-lock time after which the "released" mail says how long the lock was held, and
# the worst case the timer guard plans for: a release does not start when that span would overlap
# the next backup or purge run.
CD_LOCK_SPAN_MIN=60
CD_LOCK_SPAN_MAX_MIN=180
# The longest the nightly backup and the daily purge are taken to run, in minutes.
CD_BACKUP_MAX_MIN=90
CD_PURGE_MAX_MIN=5
# Seconds a command waits for the host lock before it reports busy.
CD_LOCK_WAIT_S=300

# ---- build and disk ------------------------------------------------------------------------
# Free disk (GB) below which no release starts, and the build cache kept after a build.
CD_MIN_FREE_GB=15
CD_BUILD_CACHE_KEEP_GB=12
# Minutes one image build may take, and how often an infrastructure failure is retried.
CD_BUILD_TIMEOUT_MIN=60
CD_BUILD_RETRIES=2

# ---- data steps ----------------------------------------------------------------------------
# What is dumped before a release changes a database. "always" is the only value.
CD_DUMP_POLICY=always
# Seconds the module step and the leaf step may take.
CD_MODULE_UPGRADE_TIMEOUT_S=900
CD_LEAF_MIGRATE_TIMEOUT_S=600

# ---- watch and rollback --------------------------------------------------------------------
# Minutes the new colour is watched before the release is committed, and the sample rhythm.
CD_WATCH_MINUTES=20
CD_WATCH_INTERVAL_S=15
CD_SAMPLE_TIMEOUT_S=12
# The longest a shared outage pauses the watch, in minutes.
CD_PAUSE_MAX_MIN=15
# Consecutive samples with a failed readiness probe that roll the release back.
CD_FAIL_SAMPLES=3
# 5xx rule of the new colour: the window in seconds, the least count, the factor over the baseline.
CD_5XX_WINDOW_S=300
CD_5XX_MIN=10
CD_5XX_FACTOR=3
# Seconds of the live colour's traffic the baseline is taken over.
CD_BASELINE_S=3600
# Minutes without a verdict or without progress after which the watchdog mails.
CD_STALL_MINUTES=360
# Minutes the commit point may retry before the release is rolled back.
CD_COMMIT_MAX_MIN=30
# Seconds the old colour is given to serve again after a rollback.
CD_POST_ROLLBACK_S=180

# ---- after the commit point ----------------------------------------------------------------
# 1 reconciles every customer once the release is committed.
CD_RECONCILE=1
# Seconds one customer may take, minutes the whole stage may take, seconds one customer waits for
# the host lock, seconds the host is probed after the stage ends.
CD_RECONCILE_TIMEOUT_S=300
CD_RECONCILE_MAX_MIN=20
CD_RECONCILE_LOCK_WAIT_S=120
CD_POST_RECONCILE_S=120
