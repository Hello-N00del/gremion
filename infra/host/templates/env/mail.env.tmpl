# infra/host/templates/env/mail.env.tmpl
# Rendered by gremion-init-secrets into <GREMION_ROOT>/etc/env/mail.env, 0600,
# owner gremion. One env file per compose project (N20); the only permitted
# host command against this project is
#   docker compose --env-file /opt/gremion/etc/env/mail.env <verb>
#
# SENTINELS (Task 1's grammar, and nothing else):
#   a generated sentinel of kind hex32   -> generated: openssl rand -hex 32
#   a generated sentinel of kind alnum32 -> generated: 32 alnum chars
#   an operator sentinel                 -> survives rendering, listed by
#                                           print_operator_todo, filled by
#                                           the operator
# The sentinel tokens themselves are NOT spelled out in this comment, and no
# comment below writes a brace-dollar render placeholder (the only ones in this
# file are the two STACK value lines, which the renderer substitutes). Both
# omissions are deliberate: gremion-init-secrets' verify_outputs greps the
# RENDERED file for a surviving generated sentinel and for a surviving
# placeholder, and grepping a rendered file for the sentinel prefix is how an
# operator asks "is anything still unfilled?". A comment that quotes either
# token answers that question wrong on a file that is in fact complete.
#
# One value per generator group across every template, so a group named here
# and in state.env.tmpl is the SAME secret in both files.
# No value line may carry a trailing comment: load_env exports the whole
# right-hand side, comment included.

# -- host layout ------------------------------------------------------------
GREMION_ROOT=/opt/gremion

# -- compose identity (section E, N20) --------------------------------------
STACK=${STACK}
COMPOSE_PROJECT_NAME=${STACK}-mail
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROFILES=mail

# -- mail transport: a DEPLOY-TIME choice (PLAN-mail-transport) --------------
# How the platform sends its mail. REQUIRED, NO DEFAULT: an operator sentinel
# that survives rendering and is listed by print_operator_todo, because a silent
# guess would send through a server that is not running.
#   relay      an external authenticated SMTP relay (the Google Workspace SMTP
#              relay of the platform domain, below). No per-realm principal:
#              every realm sends through the ONE relay credential, an accepted
#              loss of per-tenant sender isolation. No mail project is started.
#   stalwart   the bundled Stalwart (this project): each customer realm sends as
#              its own kc-<token>@ principal.
# Switching mode on an initialised host is a procedure (re-stamp every realm,
# docs/runbooks/email-smtp.md), not a hot toggle.
MAIL_TRANSPORT=CHANGE_ME_OPERATOR_mail_transport

# -- relay mode only (ignored when MAIL_TRANSPORT=stalwart) -------------------
# The defaults are the Google Workspace SMTP relay: STARTTLS on 587 (465 is
# implicit TLS), SMTP AUTH with an app password. Senders are system@,
# no-reply@ and alerts@ of the platform domain; the relay must DKIM-sign that
# domain (DMARC stays p=reject).
RELAY_SMTP_HOST=smtp-relay.gmail.com
RELAY_SMTP_PORT=587
# The account the app password belongs to. Empty = an IP-allow-listed relay
# with no authentication.
RELAY_SMTP_USER=
# The password is NEVER a value in this file: a file secret ref, secret:<name>
# = <root>/etc/secrets/<name> (0600), or file:<absolute path>. It reaches
# kcadm on stdin and Grafana as a file, never an env value or an argv.
RELAY_SMTP_PASSWORD_REF=secret:mail/relay-password
# The From domain the relay signs. Empty = PLATFORM_DOMAIN.
RELAY_FROM_DOMAIN=

# -- platform identity ------------------------------------------------------
# The mail hostname is NOT a key here: gremion-mail-bringup derives it as
# mail.<PLATFORM_DOMAIN>, so the config and the env cannot disagree.
PLATFORM_DOMAIN=CHANGE_ME_OPERATOR_platform_domain
ACME_EMAIL=CHANGE_ME_OPERATOR_acme_email

# -- binding: nothing binds 0.0.0.0 (section A) -----------------------------
MAIL_BIND_IP=CHANGE_ME_OPERATOR_mail_bind_ip
MAIL_BIND_IP6=CHANGE_ME_OPERATOR_mail_bind_ip6
# The bring-up ordering guard calls gremion-dns-check, which needs the edge
# addresses to check DNS edits 1 and 3.
EDGE_BIND_IP=CHANGE_ME_OPERATOR_edge_bind_ip
EDGE_BIND_IP6=CHANGE_ME_OPERATOR_edge_bind_ip6

# -- project network (section B); no name:, so it is project-scoped ---------
MAIL_V4_SUBNET=10.90.9.0/24
MAIL_V6_SUBNET=fd5a:99::/64

# -- app-tier subnets permitted to submit (section I) -----------------------
APP_BLUE_V4_SUBNET=10.90.2.0/24
APP_GREEN_V4_SUBNET=10.90.3.0/24

# -- images: digest-pinned, never auto-updated (section E, section I) -------
# A digest is a supply-chain pin, not a site value: it is resolved from the
# registry and committed here, so every host that renders this template runs
# the byte-identical image. Upgrading is an edit to this line plus a re-render,
# never an implicit pull.
#
# WHY v0.15.5-alpine and not the newest release (spike S4, rows 1 and 2):
#   * v0.16.x parses its bootstrap --config file as JSON only. Fed this
#     project's config.toml it dies at boot with
#       Failed to parse data store settings ...: expected value at line 1 column 2
#     Observed against v0.16.21 on 2026-09-09. Moving to v0.16 is a config
#     rewrite, not a version bump, and has its own follow-up.
#   * the DEBIAN v0.15.5 image carries neither curl nor wget, so the compose
#     healthcheck could never pass on it; the ALPINE variant carries busybox
#     wget. Weakening the healthcheck instead would report a live container
#     that answers nothing.
STALWART_IMAGE=docker.io/stalwartlabs/stalwart@sha256:0620ceba9165c104789d5cacb0aa209e7f16295f54edead631b1925b1ccc1ccf
PROBE_CURL_IMAGE=docker.io/curlimages/curl@sha256:d94d07ba9e7d6de898b6d96c1a072f6f8266c687af78a74f380087a0addf5d17
# The runtime of the ops/vendor-mail checks. The host carries no Node
# (bootstrap.sh installs none), so infra/host/bin/gremion-vendor-mail runs each
# check as `docker run --rm` of THIS image and reads the value from this file
# only: there is no default, and a tag without a digest is refused (TRD-350).
VENDOR_MAIL_NODE_IMAGE=docker.io/library/node@sha256:662933cf47f013bc8e4beb31a6116448427a82057ba7c42c97e4c5ba766504c2

# -- DKIM: two selectors from day one so a rotation needs no new record -----
DKIM_SELECTOR_A=g2026a
DKIM_SELECTOR_B=g2026b

# -- quotas, limits, logs (section I) ---------------------------------------
MAIL_ACCOUNT_QUOTA=5368709120
MAIL_RATE_LIMIT_RCPT=100/1h
MAIL_LOG_RETENTION_DAYS=7

# -- management API: published on loopback only -----------------------------
STALWART_ADMIN_URL=http://127.0.0.1:8086
STALWART_ADMIN_USER=admin
STALWART_ADMIN_PASSWORD=CHANGE_ME_GEN_alnum32_stalwart_admin
STALWART_API_KEY=CHANGE_ME_GEN_hex32_stalwart_api

# -- sending identities (TASK-015, TRD-251, TRD-049) -------------------------
# One generator group per identity, never one secret for all of them:
#   vendor_smtp    system@   the vendor's own mail (password resets of the
#                            operator realm, vendor news, invoices). Declared
#                            in THIS file only.
#   alert_smtp     alerts@   Alertmanager; the same group as ops.env.tmpl's
#                            ALERT_SMTP_PASSWORD, because Alertmanager is the
#                            one other reader of this identity.
#   platform_smtp  platform@ TRANSITIONAL: the app tier's realm sender until
#                            TASK-043 moves each realm onto its own kc- principal
#                            (ops/vendor-mail/allowances.json names the pair;
#                            TASK-015-FU retires it).
# Per-customer principals (kc-<tenant token>) are never declared here: their
# app password is generated at issue by ops/vendor-mail/principals.mjs and held
# only by Stalwart and the realm's smtpServer.
VENDOR_SMTP_PASSWORD=CHANGE_ME_GEN_alnum32_vendor_smtp
ALERT_SMTP_PASSWORD=CHANGE_ME_GEN_alnum32_alert_smtp
PLATFORM_SMTP_PASSWORD=CHANGE_ME_GEN_alnum32_platform_smtp
ROLES_IMAP_PASSWORD=CHANGE_ME_GEN_alnum32_roles_imap

# -- probes -----------------------------------------------------------------
MAIL_DNS_RESOLVER=1.1.1.1
# B-01 (spec B §T.4): `platform` is RESERVED for spec C's operator realm and is
# not created by spec B. `master` is the one realm a Keycloak with no boot
# import always has, so the reset-mail probe has a realm on day one. Consumed
# unchanged by infra/host/bin/gremion-mail-bringup:662,665,669. This key is the
# binding spelling — B30 declares the same `KEYCLOAK_PROBE_REALM` (default
# `master`) on the compose keycloak block; `KC_PROBE_REALM` is not used.
KEYCLOAK_PROBE_REALM=master
KEYCLOAK_PROBE_USER=CHANGE_ME_OPERATOR_keycloak_probe_username
