# mail.env — the ${STACK}-mail compose project (section I, N2, N18).
#
#     docker compose --env-file /opt/gremion/etc/env/mail.env <verb>
#
# Stalwart binds MAIL_BIND_IP / MAIL_BIND_IP6 only. Its image digest is pinned
# in the project's own docker-compose.yml, not here: a digest is composition,
# not configuration, and must not be changeable by editing an env file.
#
# OWNERSHIP. This file's key set and its sentinel grammar are owned by Task 1.
# Task 8 EXTENDS it and must not replace it:
#   * every key it adds uses a GENERATED sentinel (kind hex32 or alnum32, per
#     <group>) or a CHANGE_ME_OPERATOR_<name> sentinel. No other placeholder shape is ever generated,
#     listed as operator-pending, or caught by verify_outputs — a
#     "CHANGE_ME_<name>   # gremion:secret" line would ship to production
#     unfilled and silently;
#   * DKIM_SELECTOR_A, DKIM_SELECTOR_B and
#     DKIM_KEY_DIR keep these exact spellings. There is no DKIM_SELECTOR_PRIMARY/SECONDARY.

STACK=${STACK}
COMPOSE_PROJECT_NAME=${STACK}-mail
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROFILES=production

PLATFORM_DOMAIN=CHANGE_ME_OPERATOR_platform_domain
# The mail hostname is NOT an env key: gremion-mail-bringup derives it as
# mail.<PLATFORM_DOMAIN> (Task 8), so the config and the env cannot disagree.
ACME_EMAIL=CHANGE_ME_OPERATOR_acme_email

MAIL_BIND_IP=CHANGE_ME_OPERATOR_mail_bind_ip
MAIL_BIND_IP6=CHANGE_ME_OPERATOR_mail_bind_ip6
MAIL_V4_SUBNET=10.90.9.0/24
MAIL_V6_SUBNET=fd5a:99::/64

# provision-roles.sh restricts the platform app password to these two subnets,
# so a stolen app password is useless from anywhere but an app-tier container.
APP_BLUE_V4_SUBNET=10.90.2.0/24
APP_GREEN_V4_SUBNET=10.90.3.0/24

# Two selectors from day one so a rotation never needs a flag day (section I).
DKIM_SELECTOR_A=g2026a
DKIM_SELECTOR_B=g2026b
DKIM_KEY_DIR=/opt/gremion/etc/secrets/mail

STALWART_ADMIN_PASSWORD=CHANGE_ME_GEN_alnum32_stalwart_admin
STALWART_API_KEY=CHANGE_ME_GEN_hex32_stalwart_api
PLATFORM_SMTP_PASSWORD=CHANGE_ME_GEN_alnum32_platform_smtp
