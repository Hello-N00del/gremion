# app-<colour>.env — one app-tier compose project per colour (section E, section F).
#
# Rendered TWICE by gremion-init-secrets, once as app-blue.env and once as
# app-green.env. ${COLOUR} is the render-time colour; ${APP_V4_SUBNET} and
# ${APP_V6_SUBNET} are read back out of the rendered state.env so the subnets
# live in exactly one place.
#
#     docker compose --env-file /opt/gremion/etc/env/app-${COLOUR}.env <verb>
#
# COLOUR RULE (section E): no value here may name a first-party service without
# its colour suffix. A bare gremion-ui or content-service would resolve to
# whichever colour Docker answered with, which is the whole class of bug the
# blue/green switch exists to make impossible.

STACK=${STACK}
COLOUR=${COLOUR}
COMPOSE_PROJECT_NAME=${STACK}-app-${COLOUR}
COMPOSE_FILE=docker-compose.app.yml:docker-compose.pins.yml
COMPOSE_PROFILES=production

# The truncating-harness guard (spec B section 6, AM-B-05): the STACK of the
# PRODUCTION unit on this host, or the literal `none` on a host that has none.
# NO default -- a harness that truncates or drops refuses to start while it is
# unset, and a guessed value would be exactly the silent fallback that lets it
# run against production. GREMION_STACK is this project's own stack.
GREMION_PRODUCTION_STACK=CHANGE_ME_OPERATOR_production_stack
GREMION_STACK=${STACK}

APP_V4_SUBNET=${APP_V4_SUBNET}
APP_V6_SUBNET=${APP_V6_SUBNET}

PLATFORM_DOMAIN=CHANGE_ME_OPERATOR_platform_domain
IMAGE_TAG=CHANGE_ME_OPERATOR_image_tag
GREMION_DIST_MANIFEST=/opt/gremion/etc/gremion.dist.json

# -- Colour-bound internal URLs ------------------------------------------
INTERNAL_BASE_URL=http://gremion-ui-${COLOUR}:3000
KERNEL_BASE_URL=http://gremion-ui-${COLOUR}:3000
CONTENT_SERVICE_URL=http://content-service-${COLOUR}:8080
FINANCE_SERVICE_URL=http://finance-service-${COLOUR}:8080
FILES_SERVICE_URL=http://files-service-${COLOUR}:8080
VOTES_SERVICE_URL=http://votes-service-${COLOUR}:8080
MESSAGES_SERVICE_URL=http://messages-service-${COLOUR}:8080
NEWSLETTER_SERVICE_URL=http://newsletter-service-${COLOUR}:8080
CALENDAR_SERVICE_URL=http://calendar-service-${COLOUR}:8080
BOARD_SERVICE_URL=http://board-service-${COLOUR}:8080
VAULT_SERVICE_URL=http://vault-service-${COLOUR}:8080
# TASK-077: the kernel API (tenancy + module registry), internal only.
KERNEL_API_URL=http://kernel-api-${COLOUR}:3000

# -- Database access (the leaves keep their databases in the state tier) --
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_GEN_alnum32_postgres_root
GREMION_DB_USER=gremion
GREMION_DB_NAME=gremion
GREMION_DB_PASSWORD=CHANGE_ME_GEN_alnum32_gremion_db
CONTROL_DB_USER=control
CONTROL_DB_NAME=control
CONTROL_DB_PASSWORD=CHANGE_ME_GEN_alnum32_control_db
PUBLIC_DB_PASSWORD=CHANGE_ME_GEN_alnum32_public_reader
# TASK-043: gremion_platform's owner role (tenant-create reaches it direct on
# postgres-${STACK}:5432; `gremion-tenant init` creates the role and the
# database from these).
PLATFORM_DB_USER=gremion_platform
PLATFORM_DB_PASSWORD=CHANGE_ME_GEN_alnum32_platform_db
# The control panel's READ-ONLY role (SELECT on tenant, tenant_domain and
# plt.provisioning_step only); `gremion-tenant init` creates it from these.
PANEL_DB_USER=gremion_panel
PANEL_DB_PASSWORD=CHANGE_ME_GEN_alnum32_panel_db
# TASK-077: the kernel API's READ-ONLY role (SELECT on the control registry's
# tenant/tenant_domain and plt.module*, nothing else; ensureKernelApiReader).
KERNEL_API_DB_USER=gremion_kernel_api
# The durable pre-migration dump dir (same value as state.env's): kernel-api-migrate
# bind-mounts it at this path. 0700, owned by uid 1000 (the deploy user).
GREMION_MIGRATION_DUMP_DIR=/opt/gremion/migration-dumps
# The per-customer secret files (#85): gremion-ui, migrate and kernel-api mount it read-only,
# tenant-create writes it. Outside the release tree on purpose: compose's default,
# ./secrets/tenants, is INSIDE it, so a redeploy would replace it and a build context would copy
# it. A leaf apart from etc/secrets/tenant-create and etc/secrets/governance (nothing in there may
# sit inside what gremion-ui mounts); `gremion-tenant` makes it 0700 before every run
# (ensure_tenant_secrets_dir) and refuses any other place.
TENANT_SECRETS_DIR=/opt/gremion/etc/secrets/tenants
KERNEL_API_DB_PASSWORD=CHANGE_ME_GEN_alnum32_kernel_api_db
# TRD-092: the council-admin access-record view's reader role (ensureAccessReader; EXECUTE on oac.list_access_records only).
UI_OAC_DB_PASSWORD=CHANGE_ME_GEN_alnum32_ui_oac_db
# Council module self-service role (ensureCouncilRequester; EXECUTE on the three council request functions only).
UI_MODULES_DB_PASSWORD=CHANGE_ME_GEN_alnum32_ui_modules_db
# The URI repeats PUBLIC_DB_PASSWORD's generated-secret sentinel, which
# gremion-init-secrets replaces; the secrets scanner cannot tell it from a
# credential. (The sentinel prefix itself must not appear in this comment:
# the renderer asserts that no trace of it survives in the output.)
# nosemgrep: generic.secrets.security.detected-username-and-password-in-uri.detected-username-and-password-in-uri
GREMION_PUBLIC_DB_URL=postgresql://gremion_public_reader:CHANGE_ME_GEN_alnum32_public_reader@postgres:5432/gremion

# -- Identity and internal transport (same values as the state project) --
AUTH_SECRET=CHANGE_ME_GEN_hex32_auth_secret
AUTH_KEYCLOAK_ID=gremion-ui
AUTH_KEYCLOAK_SECRET=CHANGE_ME_GEN_hex32_gremion_ui_oidc
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_GEN_hex32_gremion_admin_oidc
INTERNAL_PUSH_SECRET=CHANGE_ME_GEN_hex32_internal_push
TENANT_PROXY_SHARED_SECRET=CHANGE_ME_GEN_hex32_tenant_proxy
# TASK-077 (Q8): the service token each module presents to the kernel API;
# a module with no secret has no trust. One generated secret per module key.
KERNEL_API_MODULE_SECRET_BOARD=CHANGE_ME_GEN_hex32_kernel_api_module_board
KERNEL_API_MODULE_SECRET_CALENDAR=CHANGE_ME_GEN_hex32_kernel_api_module_calendar
KERNEL_API_MODULE_SECRET_CONTENT=CHANGE_ME_GEN_hex32_kernel_api_module_content
KERNEL_API_MODULE_SECRET_ELECTIONS=CHANGE_ME_GEN_hex32_kernel_api_module_elections
KERNEL_API_MODULE_SECRET_FILES=CHANGE_ME_GEN_hex32_kernel_api_module_files
KERNEL_API_MODULE_SECRET_FINANCE=CHANGE_ME_GEN_hex32_kernel_api_module_finance
KERNEL_API_MODULE_SECRET_HANDOVER=CHANGE_ME_GEN_hex32_kernel_api_module_handover
KERNEL_API_MODULE_SECRET_MESSAGING=CHANGE_ME_GEN_hex32_kernel_api_module_messaging
KERNEL_API_MODULE_SECRET_PUBLISHING=CHANGE_ME_GEN_hex32_kernel_api_module_publishing
KERNEL_API_MODULE_SECRET_VAULT=CHANGE_ME_GEN_hex32_kernel_api_module_vault
KERNEL_API_MODULE_SECRET_VOTES=CHANGE_ME_GEN_hex32_kernel_api_module_votes
VAULT_ENCRYPTION_KEY=CHANGE_ME_GEN_hex32_vault_encryption
FINTS_PASSWORD_KEY=CHANGE_ME_GEN_hex32_fints_password_key
# NOT a free secret (see state.env.tmpl): a placeholder that `gremion-services wire <slug>`
# replaces with the admin bot's real access token.
SYNAPSE_ADMIN_TOKEN=CHANGE_ME_GEN_hex32_synapse_admin

# -- The pilot's services (docs/ops/pilot-services.md) -------------------
# The single pilot customer's host (the same value as state.env's), the public base of the
# leaves' links and of the Element Call frame URL.
PILOT_TENANT_HOST=CHANGE_ME_OPERATOR_pilot_tenant_host
# -- The control panel on its own host (OPT-IN; docs/runbooks/control-panel-access.md) --
# Off by default: the panel is reached through `gremion-tenant panel` (an ssh -L tunnel to
# 127.0.0.1:3043). To make it reachable at https://control.<PLATFORM_DOMAIN> behind a TLS
# CLIENT-CERTIFICATE gate at the edge (then the ops-realm login, password plus TOTP), add the
# line below with EXACTLY that origin to this file, the other app-<colour>.env AND state.env,
# name docker-compose.control-public.yml after docker-compose.app.yml in the COMPOSE_FILE line
# of this file and the other app-<colour>.env (it is what puts the panel on the edge network;
# without the opt-in the panel is not there), install the operator CA certificate
# (gremion-operator-ca install), and run gremion-deploy. Empty or absent = off. Any other value
# is refused by gremion-render, and so is an opt-in without the CA or the overlay, or an overlay
# without the opt-in: neither leaves a router behind. Deliberately NOT a template key: an existing host's env
# files stay valid without it. The same value everywhere, like PILOT_TENANT_HOST.
# On an install that serves the panel on another name (CONTROL_PANEL_HOST in state.env, see
# there) the origin is https:// followed by that name, not control.<PLATFORM_DOMAIN>.
# CONTROL_PANEL_ORIGIN=https://control.<PLATFORM_DOMAIN>
# Nextcloud's admin login (the files, votes and calendar halves) and the LiveKit API pair
# gremion-ui signs call tokens with: the same sentinel groups as state.env.
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_GEN_alnum32_nextcloud_admin
LIVEKIT_API_KEY=CHANGE_ME_GEN_alnum32_livekit_key
LIVEKIT_API_SECRET=CHANGE_ME_GEN_alnum32_livekit_secret
# The shared secret each leaf presents back to gremion-ui (tenant/leaf-trust.ts): one
# generated value per leaf, held by gremion-ui and that leaf only.
INTERNAL_CALENDAR_SECRET=CHANGE_ME_GEN_hex32_internal_calendar
INTERNAL_CONTENT_SECRET=CHANGE_ME_GEN_hex32_internal_content
INTERNAL_NEWSLETTER_SECRET=CHANGE_ME_GEN_hex32_internal_newsletter
# The leaves connect to their module's database server (the state project's <id>-postgres) as its
# admin and create one database per customer themselves: the same sentinel groups as state.env.
CALENDAR_PG_USER=calendar
CALENDAR_PG_PASSWORD=CHANGE_ME_GEN_alnum32_calendar_pg
CONTENT_PG_USER=content
CONTENT_PG_PASSWORD=CHANGE_ME_GEN_alnum32_content_pg
NEWSLETTER_PG_USER=newsletter
NEWSLETTER_PG_PASSWORD=CHANGE_ME_GEN_alnum32_newsletter_pg

# -- The public portal on the customer's own host (optional) -------------
# docs/runbooks/public-portal-host.md. Read by gremion-public only. All three stay
# commented until the portal gets its own host; an absent or empty key keeps the
# value named as its fallback. Set them in BOTH app-<colour>.env files: the colour
# that takes over at the next switch reads its own file.
#
# The one extra host name the edge serves the portal under (a subdomain the customer
# points at this host). It carries the portal only. Fallback: public.<PLATFORM_DOMAIN>.
#PUBLIC_PORTAL_HOST=
# The database the portal's read-only role reads: the customer's own,
# t_<tenant id>__kernel. The name carries the tenant id, so it exists only AFTER the
# tenant was created, and it changes when the tenant is created again.
# Fallback: GREMION_DB_NAME.
#PUBLIC_PORTAL_DB_NAME=
# Where the portal's Login and protocol-PDF links point (an origin, no trailing
# slash). Fallback: https://<PILOT_TENANT_HOST>, else https://<PLATFORM_DOMAIN>.
#PUBLIC_MAIN_APP_URL=

# -- Module Karenz: the day-30 deletion switch --------------------------
# `off` makes karenz-run a dry run that only reports what it would delete
# (platform side and tenant side). Flip to `on` only after the dry-run line
# was read on this environment AND the phase-3 finance extraction is verified
# (the finance export is deleted with the blocked database on day 30; the
# per-class extraction is what keeps the statutory finance records). Read by
# the tenant-create one-shot only; gremion-ui takes the mode from the row.
KARENZ_FINAL_DELETION=off

# -- Seeding: OFF (go-live gate item 5) ----------------------------------
SEED_TOKEN=
GREMION_DISABLE_SEEDS=true
