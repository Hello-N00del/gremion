[Unit]
Description=Gremion scheduled purge run (TRD-144, TRD-145, TASK-033-a)
Documentation=file://${GREMION_ROOT}/current/infra/host/ops/README.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=${DEPLOY_USER}
Group=${DEPLOY_USER}
# purge.sh runs `docker compose run tenant-create purge-run` in the active
# colour; the one-shot writes one plt.job_run row through gremion_platform.
SupplementaryGroups=docker
Environment=GREMION_ROOT=${GREMION_ROOT}
ExecStart=${GREMION_ROOT}/current/infra/host/ops/purge.sh
# A stuck call dies inside the 4-minute rule instead of hanging the unit. The
# purge deletes in batches and every rule is "older than now - window", so a
# run cut short here is finished by the next day's.
TimeoutStartSec=170
ProtectSystem=full
NoNewPrivileges=true
