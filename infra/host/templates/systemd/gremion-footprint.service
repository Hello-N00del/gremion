[Unit]
Description=Gremion weekly storage footprint record (TRD-223, TASK-039-FU)
Documentation=file://${GREMION_ROOT}/current/infra/host/ops/README.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=${DEPLOY_USER}
Group=${DEPLOY_USER}
# footprint.sh reads sizes with `docker exec` / `docker system df` and writes
# one plt.job_run row through the state Postgres.
SupplementaryGroups=docker
Environment=GREMION_ROOT=${GREMION_ROOT}
ExecStart=${GREMION_ROOT}/current/infra/host/ops/footprint.sh
# A stuck call dies inside the 4-minute rule instead of hanging the unit.
TimeoutStartSec=170
ProtectSystem=full
NoNewPrivileges=true
