[Unit]
Description=Gremion host agent (control socket)
Documentation=https://github.com/Hello-N00del/gremion/blob/main/docs/ops/host-tooling.md
After=docker.service
Wants=docker.service

[Service]
Type=simple
User=${DEPLOY_USER}
Group=${DEPLOY_USER}
# The agent drives docker compose on behalf of a deploy.
SupplementaryGroups=docker
# /run/gremion, owned by the deploy user, mode 0750; the socket the agent
# creates inside it is 0660 (UMask below).
RuntimeDirectory=gremion
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=${GREMION_ROOT}/bin/gremion-hostd --socket
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
# ProtectSystem=full keeps /usr, /boot and /etc read-only while leaving the
# install root writable. It is deliberately not `strict`, and ProtectHome is
# deliberately absent: a deploy writes ~/.docker/config.json on `docker login`
# and the N12 guard reads it back after the logout trap.
ProtectSystem=full

[Install]
WantedBy=multi-user.target
