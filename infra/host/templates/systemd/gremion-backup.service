[Unit]
Description=Gremion backup (restic repository + off-site copy)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=${DEPLOY_USER}
Group=${DEPLOY_USER}
SupplementaryGroups=docker
ExecStart=${GREMION_ROOT}/bin/gremion-backup --class daily
# A backup must never compete with the platform for IO.
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=6h
ProtectSystem=full
NoNewPrivileges=true
