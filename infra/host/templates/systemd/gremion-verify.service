[Unit]
Description=Gremion reboot gate (verification contract)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=${DEPLOY_USER}
Group=${DEPLOY_USER}
SupplementaryGroups=docker
ExecStart=${GREMION_ROOT}/bin/gremion-verify
TimeoutStartSec=30m
ProtectSystem=full
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
