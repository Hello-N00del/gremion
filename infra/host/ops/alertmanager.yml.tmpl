# infra/host/ops/alertmanager.yml.tmpl — rendered by render-ops.sh into
# runtime/ops/alertmanager.yml. It holds NO secret: the SMTP app password is
# read by Alertmanager from /etc/alertmanager/smtp-password, which is mounted
# from etc/secrets/ops (§G: platform secrets live only in etc/).
global:
  resolve_timeout: 5m
  smtp_smarthost: 'mail.${PLATFORM_DOMAIN}:587'
  smtp_from: '${ALERT_EMAIL_FROM}'
  smtp_auth_username: '${ALERT_SMTP_USER}'
  smtp_auth_password_file: '/etc/alertmanager/smtp-password'
  smtp_require_tls: true

route:
  receiver: platform
  group_by: ['alertname']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: platform
    webhook_configs:
      - url: '${ALERT_WEBHOOK_URL}'
        send_resolved: true
