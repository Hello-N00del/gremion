#!/usr/bin/env bash
set -euo pipefail
#
# gremion-executor — the host-side executor of the control panel's requests
# (TASK-043d-1, D R31-I4: "ops panel should be able to create the pilot. so
# ops fully decommissions CLI").
#
#   gremion-executor --loop     the daemon (gremion-executor.service)
#   gremion-executor --once     claim at most ONE request, run it, exit
#                               (tests, the proofs, a by-hand drain)
#
# WHY IT EXISTS: the panel holds no docker, no host tool and no table write;
# it inserts a request through ONE narrow SECURITY DEFINER function
# (gremion_platform plt.submit_provisioning_request). This program PULLS
# those requests -- it opens no socket and listens on nothing (CIS Docker
# Benchmark 5.31: the panel container never gets the docker socket; NIST SP
# 800-53 AC-6: only the host component holds docker). Per cycle:
#   1. plt.executor_beat (the panel greys "Neuer Mandant" out when the beat
#      is older than 60 s);
#   2. runtime/hostd.lock taken NON-blocking: a deploy, switch or rollback in
#      progress skips the cycle (provisioning never races a colour switch);
#   3. plt.claim_provisioning_request (expires stale requests, re-queues
#      expired leases, claims the oldest queued one whose customer has no
#      running request, FOR UPDATE SKIP LOCKED);
#   4. `tenant-create request-verify <id>` in the active colour (the trusted
#      layer: kind, args, the operator's signed loa2 evidence or the
#      break-glass reason, the operator re-read in the ops realm) -> refused:
#      finished `refused`, nothing runs; ok: plt.mark_provisioning_request_
#      verified (clears the token), then the kind's handler from
#      infra/host/lib/executor/registry.sh, every output line an event
#      (credential lines withheld, 1000 characters at most), the lease renewed
#      at each step, the request finished `succeeded` or `failed` naming the
#      step. Every event also goes to runtime/executor/audit.log (append-only;
#      NIST AC-6(9)).
# At --loop start its own orphaned `running` requests are re-queued at once
# (crash-resume; the engine resumes from the ledger).
#
# The handlers and customer-ops.sh are sourced from the RELEASE
# (GREMION_RELEASE_DIR, default <root>/current): the authenticated tree whose
# tenant-create image the colour runs. The database is reached by docker exec
# into the state postgres as gremion_executor (lib/executor/db.sh).
#
# EXIT CODES: 0 ok (or nothing to do) - 1 the request failed or was refused,
# or a step of the executor itself failed - 2 usage/precondition - 3 blocked
# (--once while the host lock is held).

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

umask 077

EXECUTOR_VERSION="043d-1"
LEASE_SECONDS=600
# create-harden H4: the lease is renewed every RENEW_SECONDS by a background
# renewer while a handler runs (not only at step markers: one step can outlast
# the lease). The holder FENCES ITSELF: when no renewal has succeeded for
# FENCE_SECONDS (default lease - lease/5, always shorter than the lease) it
# kills its handler's process group. The database re-queues a lapsed lease
# only 60 s after lease_until (migration 0011), so the kill is complete before
# attempt + 1 can be claimed.
#
# WHAT "THE KILL" COVERS (H4 HIGH-1/HIGH-2):
#   - the handler's process group (TERM, 5 s, KILL, confirmed empty);
#   - the request's CONTAINERS: a `docker compose run` container is a child of
#     the docker daemon, not of the compose client, so killing the client does
#     not stop it. Every tenant-create run of a request carries the label
#     gremion.request=<id> (customer-ops.sh tc); the kill is `docker kill` by
#     that label until `docker ps --filter label=...` comes back empty twice
#     (CONTAINER_WAIT seconds at most, then a LOUD failure and the request is
#     NOT finished -- a finished request is retryable at once);
#   - the renewer, a DEAD-MAN SWITCH: it checks every second that this
#     process lives and that its own fence deadline has not passed, and if
#     either fails it kills the handler's group and the containers itself
#     (this process may have been KILLed: no trap runs then). It needs no
#     workdir; every database and docker call it makes is under timeout(1).
#   - INT/TERM/HUP of this process: the trap kills all of the above, then
#     exits 128+n (the request stays `running`: --loop re-queues it at start,
#     after the same container sweep; otherwise it lapses after the grace).
# Every clock is MONOTONIC (/proc/uptime): a wall-clock step cannot move the
# fence. A renewal's timestamp is taken BEFORE the call (the lease the
# database grants starts no earlier than that).
#
# THE TIMING BOUND (defaults): the fence fires at FENCE (480 s) after the last
# successful renewal's start, seen by the supervisor within 0.2 s, by the
# renewer within its tick + one timed-out call (SQL_TIMEOUT 30 s + 5 s);
# the kill takes <= 10 s (group) + CONTAINER_WAIT (30 s) + docker call
# timeouts. 480 + 35 + 10 + 30 + 20 < 600 (lease) + 60 (re-queue grace).
RENEW_SECONDS="${GREMION_EXECUTOR_RENEW_SECONDS:-60}"
FENCE_SECONDS="${GREMION_EXECUTOR_FENCE_SECONDS:-$((LEASE_SECONDS - LEASE_SECONDS / 5))}"
SQL_TIMEOUT="${GREMION_EXECUTOR_SQL_TIMEOUT:-30}"
CONTAINER_WAIT="${GREMION_EXECUTOR_CONTAINER_WAIT:-30}"
DOCKER_TIMEOUT=10
CONTAINER_LABEL="gremion.request"
for _v in "$RENEW_SECONDS" "$FENCE_SECONDS" "$SQL_TIMEOUT" "$CONTAINER_WAIT"; do
    [[ "$_v" =~ ^[1-9][0-9]*$ ]] \
        || die "GREMION_EXECUTOR_RENEW_SECONDS / _FENCE_SECONDS / _SQL_TIMEOUT / _CONTAINER_WAIT must be positive integers" "$GREMION_EXIT_USAGE"
done
unset _v
# db.sh's platform_sql puts every psql `docker exec` under timeout(1) with it
export PLATFORM_SQL_TIMEOUT="$SQL_TIMEOUT"
POLL_SECONDS="${GREMION_EXECUTOR_POLL_SECONDS:-5}"
HOST_ID_RE='^[a-z0-9][a-z0-9._-]{0,62}$'
# The panel's SECRET_LINE rule (TASK-043 executor.ts), moved here with the
# spawning it guarded: a line that looks like it carries a credential is
# never copied into an event or the audit log.
SECRET_LINE_RE='(PASSWORD|SECRET|TOKEN)[[:space:]]*[:=]'
WITHHELD='[a line carrying a credential was withheld]'

usage() {
    cat <<'EOF'
usage: gremion-executor --loop | --once
EOF
}

ROOT=""
RELEASE_DIR=""
HOST_ID=""
WORK_ROOT=""
AUDIT_LOG=""
CURRENT_WORK=""
# the request this process runs now (the signal trap's view of it)
RUN_ID=""
RUN_HPID=""
RUN_RPID=""
# MONO: the monotonic clock in whole seconds (mono sets it; no fork)
MONO=0
CLAIM_MONO=0

cleanup_work() {
    if [[ -n "$CURRENT_WORK" && -d "$CURRENT_WORK" ]]; then rm -rf -- "$CURRENT_WORK"; fi
    CURRENT_WORK=""
    RUN_ID=""
    unset GREMION_EXECUTOR_REQUEST_ID
}
trap cleanup_work EXIT

mono() {
    local up _idle
    read -r up _idle < /proc/uptime || die "/proc/uptime is unreadable (the monotonic clock of the lease fence)" "$GREMION_EXIT_ASSERT"
    MONO="${up%%.*}"
}

host_id() {
    local h="${GREMION_EXECUTOR_HOST:-}"
    [[ -n "$h" ]] || h="$(hostname 2>/dev/null || true)"
    h="$(printf '%s' "$h" | tr '[:upper:]' '[:lower:]')"
    [[ "$h" =~ $HOST_ID_RE ]] || die "executor host id '${h}' is not ${HOST_ID_RE} (set GREMION_EXECUTOR_HOST)" "$GREMION_EXIT_USAGE"
    printf '%s' "$h"
}

load_release_libs() {
    local lib="${RELEASE_DIR}/infra/host/lib"
    [[ -f "${lib}/customer-ops.sh" && -f "${lib}/executor/registry.sh" && -f "${lib}/executor/db.sh" ]] \
        || die "the release at ${RELEASE_DIR} carries no executor library (infra/host/lib/customer-ops.sh, executor/)" "$GREMION_EXIT_USAGE"
    # shellcheck source=../lib/customer-ops.sh
    . "${lib}/customer-ops.sh"
    # shellcheck source=../lib/executor/db.sh
    . "${lib}/executor/db.sh"
    # shellcheck source=../lib/executor/registry.sh
    . "${lib}/executor/registry.sh"
}

# redact <line> — the panel's rule, then at most 1000 characters.
redact() {
    local line="$1"
    if [[ "${line^^}" =~ $SECRET_LINE_RE ]]; then line="$WITHHELD"; fi
    printf '%s' "${line:0:1000}"
}

audit() {   # <request-id> <text>
    printf '%s host=%s pid=%d req=%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$HOST_ID" "$$" "$1" "$(redact "$2")" >> "$AUDIT_LOG"
}

event() {   # <request-id> <info|error> <step> <message>
    local msg
    msg="$(redact "$4")"
    audit "$1" "event ${2} ${3}: ${msg}"
    executor_sql "SELECT plt.record_provisioning_event(:'id'::uuid, :'host', :'level', :'step', :'msg');" \
        -v id="$1" -v host="$HOST_ID" -v level="$2" -v step="$3" -v msg="$msg" >/dev/null \
        || bad "could not record an event of request $1 (step $3)"
}

finish() {   # <request-id> <succeeded|failed|refused> <outcome>
    local outcome
    outcome="$(redact "$3")"
    audit "$1" "finish ${2}: ${outcome}"
    executor_sql "SELECT plt.finish_provisioning_request(:'id'::uuid, :'host', :'state', :'outcome');" \
        -v id="$1" -v host="$HOST_ID" -v state="$2" -v outcome="${outcome:0:2000}" >/dev/null \
        || die "could not finish request $1 as $2" "$GREMION_EXIT_ASSERT"
    info "request $1: ${2} (${outcome})"
}

beat() {
    executor_sql "SELECT plt.executor_beat(:'host', :'version');" -v host="$HOST_ID" -v version="$EXECUTOR_VERSION" >/dev/null \
        || die "the executor heartbeat could not be written (gremion_platform unreachable, or init has not made the executor role)" "$GREMION_EXIT_ASSERT"
}

# take_lock — runtime/hostd.lock (gremion-hostd's mutating-verb lock) on fd 9,
# NON-blocking. 1 when another host operation holds it.
take_lock() {
    command -v flock >/dev/null 2>&1 || die "flock is not installed (util-linux); refusing to provision without the host lock" "$GREMION_EXIT_USAGE"
    local lock="${ROOT}/runtime/hostd.lock"
    mkdir -p "$(dirname "$lock")"
    exec 9>>"$lock" || die "cannot open the host lock ${lock}" "$GREMION_EXIT_USAGE"
    if ! flock -n 9; then
        exec 9>&-
        return 1
    fi
    return 0
}
release_lock() { exec 9>&- 2>/dev/null || true; }

# renew_lease <request-id> — 0 renewed, 1 REFUSED by the database (the request
# is no longer ours: re-queued, finished, lapsed -- psql exit 3), 2 not
# answered (database unreachable, or the call timed out -- the fence deadline
# decides). Its stderr is captured, never written into the workdir (the
# renewer must work when the workdir is gone).
renew_lease() {
    local rc=0 err
    err="$(executor_sql "SELECT plt.renew_provisioning_lease(:'id'::uuid, :'host', ${LEASE_SECONDS});" -v id="$1" -v host="$HOST_ID" 2>&1 >/dev/null)" || rc=$?
    (( rc == 0 )) && return 0
    bad "lease renewal of request $1: exit ${rc}${err:+: ${err%%$'\n'*}}" 2>/dev/null || true
    (( rc == 3 )) && return 1
    return 2
}
# mark_renewed <mono> — the start time of the last successful renewal.
mark_renewed() { printf '%s' "$1" > "${CURRENT_WORK}/renewed.tmp" && mv -f -- "${CURRENT_WORK}/renewed.tmp" "${CURRENT_WORK}/renewed"; }
# try_renew <request-id> — renew_lease's 0/1/2, timestamped BEFORE the call
# (MED-3), plus 4: renewed, but the local record could not be written (LOW-5:
# never reported as a database refusal).
try_renew() {
    local t rr=0
    mono; t="$MONO"
    renew_lease "$1" || rr=$?
    (( rr == 0 )) || return "$rr"
    mark_renewed "$t" 2>/dev/null || return 4
    return 0
}
# raise_abort <reason> — first reason wins; the supervisor kills the handler.
# Best effort (the renewer calls it after this process may be gone).
raise_abort() {
    [[ -n "$CURRENT_WORK" && -d "$CURRENT_WORK" ]] || return 0
    [[ -e "${CURRENT_WORK}/abort" ]] && return 0
    { printf '%s' "$1" > "${CURRENT_WORK}/abort.tmp" && mv -f -- "${CURRENT_WORK}/abort.tmp" "${CURRENT_WORK}/abort"; } 2>/dev/null || true
}

# A step marker on STDERR (stdout of `tc render-router` is the router file).
executor_step() { printf '@@executor-step %s\n' "$1" >&2; }

# Inside the handler's subshell: tc and mail_step announce their step first.
# The library bodies stay as moved (D10); these wrappers only add the marker.
executor_wrap_steps() {
    eval "executor_orig_$(declare -f tc)"
    eval "executor_orig_$(declare -f mail_step)"
    eval "executor_orig_$(declare -f container_fingerprint)"
    # shellcheck disable=SC2329  # redefined here, called by customer_create
    tc() {
        case "${1:-}" in
            phase-a|phase-b|record-step|activate) executor_step "$1" ;;
            render-router) executor_step router ;;
        esac
        local rc=0 name="${1:-tc}"
        [[ "$name" == render-router ]] && name=router
        executor_orig_tc "$@" || rc=$?
        # H7: the step's exit status, not its text, decides the event level
        (( rc == 0 )) || printf '@@executor-step-failed %s %d\n' "$name" "$rc" >&2
        return "$rc"
    }
    # shellcheck disable=SC2329  # redefined here, called by customer_create
    mail_step() {
        local rc=0
        executor_step mail
        executor_orig_mail_step "$@" || rc=$?
        (( rc == 0 )) || printf '@@executor-step-failed mail %d\n' "$rc" >&2
        return "$rc"
    }
    # LOW-7: the TRD-440 measurement (before phase A and after activate) is a
    # step of its own -- a moved container set fails "in trd-440", not in the
    # step before it.
    # shellcheck disable=SC2329  # redefined here, called by customer_create
    container_fingerprint() {
        executor_step trd-440
        executor_orig_container_fingerprint
    }
}

# record_stream <request-id> <first step> <workdir> — every line an event; a
# step marker renews the lease and is remembered (the failure names it).
record_stream() {
    local id="$1" step="$2" work="$3" line level
    printf '%s' "$step" > "${work}/step"
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%$'\r'}"
        [[ -n "$line" ]] || continue
        if [[ "$line" == "@@executor-step "* ]]; then
            step="${line#@@executor-step }"
            printf '%s' "$step" > "${work}/step"
            local rr=0
            try_renew "$id" || rr=$?
            if (( rr == 1 )); then
                raise_abort "lease lost: the database refused the renewal of request ${id} at step ${step}"
            elif (( rr == 2 )); then
                bad "could not renew the lease of request ${id} (database unreachable or timed out; the fence deadline applies)"
            elif (( rr == 4 )); then
                bad "the lease of request ${id} was renewed, but the local renewal record could not be written (the fence counts from the previous one)"
            fi
            event "$id" info "$step" "step ${step} started"
            continue
        fi
        if [[ "$line" == "@@executor-step-failed "* ]]; then
            local f="${line#@@executor-step-failed }"
            event "$id" error "${f%% *}" "step ${f%% *} exited ${f##* }"
            continue
        fi
        level=info
        # H7: the exit status is authoritative (the marker above); the text
        # match stays as the fallback for a step that prints FAIL and exits 0.
        [[ "$line" == *"FAIL"* ]] && level=error
        event "$id" "$level" "$step" "$line"
    done
}

# kill_group <pgid> — TERM, up to 5 s of grace, then KILL, then confirm the
# group is empty before returning (nothing of the handler may outlive this).
kill_group() {
    local g="$1" i
    kill -TERM -- "-${g}" 2>/dev/null || true
    for ((i = 0; i < 25; i++)); do
        kill -0 -- "-${g}" 2>/dev/null || return 0
        sleep 0.2
    done
    kill -KILL -- "-${g}" 2>/dev/null || true
    for ((i = 0; i < 25; i++)); do
        kill -0 -- "-${g}" 2>/dev/null || return 0
        sleep 0.2
    done
    bad "the process group ${g} did not die"
    return 1
}

# docker_t <args...> — docker under timeout(1), in this process group
# (--foreground: a kill of the group reaches it; a wedged daemon cannot stall
# the kill path).
docker_t() { timeout --foreground -k 5 "$DOCKER_TIMEOUT" docker "$@"; }

# kill_request_containers <label filter> — `docker kill` every RUNNING
# container carrying the label (gremion.request=<id>, or gremion.request for
# all of this host's) until `docker ps` finds none TWICE in a row 0.5 s apart
# (a start the dead client had already sent may still land). 0 confirmed
# gone; 1 (LOUD) still running, or docker could not be asked, after
# CONTAINER_WAIT seconds.
kill_request_containers() {
    local filter="label=$1" ids="" empty=0 deadline rc
    mono; deadline=$((MONO + CONTAINER_WAIT))
    while :; do
        rc=0
        ids="$(docker_t ps -q --filter "$filter" 2>/dev/null)" || rc=$?
        ids="${ids//$'\n'/ }"
        if (( rc == 0 )) && [[ -z "${ids// /}" ]]; then
            empty=$((empty + 1))
            (( empty >= 2 )) && return 0
        else
            empty=0
            # shellcheck disable=SC2086  # one argument per container id
            (( rc == 0 )) && { docker_t kill $ids >/dev/null 2>&1 || true; }
        fi
        mono
        (( MONO < deadline )) || break
        sleep 0.5
    done
    bad "the container(s) with ${filter} are still running (or docker could not be asked: exit ${rc}) after ${CONTAINER_WAIT} s: ${ids:-?}" 2>/dev/null || true
    return 1
}

# stop_request <request-id> <handler pgid> [renewer pgid] — the whole kill:
# the renewer's and the handler's process groups, then the request's
# containers. 0 only when everything is confirmed gone.
stop_request() {
    local ok=0
    if [[ -n "${3:-}" ]]; then kill_group "$3" || ok=1; fi
    if [[ -n "${2:-}" ]]; then kill_group "$2" || ok=1; fi
    kill_request_containers "${CONTAINER_LABEL}=$1" || ok=1
    return "$ok"
}

# renewer <request-id> <handler pgid> <executor pid> <base mono> — the
# background renewer AND dead-man switch (its own process group). Every
# second: is the executor alive, has the fence deadline passed; every
# RENEW_SECONDS: renew. A refusal, the fence, or the executor gone: it kills
# the handler's group and the request's containers itself, then exits. It
# never needs the workdir (the abort / renewed files are best effort), and it
# ignores SIGPIPE (a dead terminal or journal pipe must not kill the switch).
# It closes executor.lock (fd 8: a restarted daemon must get it) but KEEPS
# hostd.lock (fd 9) until it exits: no deploy, and no restarted daemon's
# sweep-and-re-queue, starts while a container of this request may run.
renewer() {
    local id="$1" hp="$2" parent="$3" last="$4" next f rr t why=""
    trap '' PIPE
    exec 8>&-
    mono; next=$((MONO + RENEW_SECONDS))
    while sleep 1; do
        if ! kill -0 "$parent" 2>/dev/null; then
            why="the executor (pid ${parent}) is gone"
        else
            # a step marker's renewal (record_stream) moves the base too
            f=""
            { read -r f < "${CURRENT_WORK}/renewed"; } 2>/dev/null || true
            [[ "$f" =~ ^[0-9]+$ ]] && (( f > last )) && last="$f"
            mono
            if (( MONO - last >= FENCE_SECONDS )); then
                why="lease fence: no successful renewal for ${FENCE_SECONDS} s (the lease is ${LEASE_SECONDS} s); aborting before it can lapse"
                raise_abort "$why"
            elif (( MONO >= next )); then
                t="$MONO"; rr=0
                renew_lease "$id" || rr=$?
                if (( rr == 0 )); then
                    last="$t"
                    mark_renewed "$t" 2>/dev/null || true
                elif (( rr == 1 )); then
                    why="lease lost: the database refused the renewal of request ${id}"
                    raise_abort "$why"
                fi
                mono; next=$((MONO + RENEW_SECONDS))
                # the executor may have died during a long (timed-out) call
                kill -0 "$parent" 2>/dev/null || why="${why:-the executor (pid ${parent}) is gone}"
            fi
        fi
        [[ -z "$why" ]] && continue
        audit "$id" "renewer: ${why}; killing the handler's process group and the request's containers" 2>/dev/null || true
        if stop_request "$id" "$hp"; then
            audit "$id" "renewer: the handler and the request's containers are gone" 2>/dev/null || true
        else
            audit "$id" "renewer: the handler or a container of the request is still running" 2>/dev/null || true
        fi
        exit 0
    done
}

# supervise_handler <handler pid/pgid> <renewer pid/pgid> — wait for the
# handler; abort it when a renewal was refused (abort file) or no renewal has
# succeeded for FENCE_SECONDS (monotonic). Sets rc (the handler's status; 143
# aborted) and STOPPED (0 when the handler's group and the request's
# containers are confirmed gone).
STOPPED=0
supervise_handler() {
    local hp="$1" rp="$2" id="$3" last
    while kill -0 "$hp" 2>/dev/null; do
        if [[ -e "${CURRENT_WORK}/abort" ]]; then break; fi
        last=0
        { read -r last < "${CURRENT_WORK}/renewed"; } 2>/dev/null || true
        [[ "$last" =~ ^[0-9]+$ ]] || last=0
        mono
        if (( MONO - last >= FENCE_SECONDS )); then
            raise_abort "lease fence: no successful renewal for ${FENCE_SECONDS} s (the lease is ${LEASE_SECONDS} s); aborting before it can lapse"
            break
        fi
        sleep 0.2
    done
    STOPPED=0
    if [[ -e "${CURRENT_WORK}/abort" ]]; then
        stop_request "$id" "$hp" "$rp" || STOPPED=1
        wait "$hp" 2>/dev/null
        wait "$rp" 2>/dev/null
        rc=143
        return 0
    fi
    wait "$hp" 2>/dev/null
    rc="$(cat "${CURRENT_WORK}/rc" 2>/dev/null || printf '1')"
    # the handler returned: nothing of it, and no container of the request,
    # may be left (a straggler in the group, a container of a killed client)
    stop_request "$id" "$hp" "$rp" || STOPPED=1
    wait "$rp" 2>/dev/null
    return 0
}

# on_signal <name> <exit code> — INT/TERM/HUP of the executor (HIGH-2): the
# handler runs in its own process group, so a Ctrl-C or a TERM to this
# process alone would not reach it. Kill the renewer, the handler and the
# request's containers, record it, exit non-zero. The request stays
# `running` (not finished: --loop re-queues it at its next start, after the
# same container sweep; otherwise it lapses and is re-queued after the grace).
on_signal() {
    trap '' INT TERM HUP
    local sig="$1" code="$2" step
    bad "gremion-executor: SIG${sig} received; stopping" 2>/dev/null || true
    if [[ -n "$RUN_ID" ]]; then
        audit "$RUN_ID" "signal SIG${sig}: killing the renewer, the handler's process group and the request's containers" 2>/dev/null || true
        step="$(cat "${CURRENT_WORK}/step" 2>/dev/null || printf 'executor')"
        if stop_request "$RUN_ID" "$RUN_HPID" "$RUN_RPID"; then
            event "$RUN_ID" error "$step" "the executor stopped on SIG${sig}; the handler and the request's containers were terminated; the request is re-queued by this host's next start (or after its lease lapses)" 2>/dev/null || true
        else
            audit "$RUN_ID" "signal SIG${sig}: a process or container of the request is still running" 2>/dev/null || true
            event "$RUN_ID" error "$step" "the executor stopped on SIG${sig}, but a process or container of the request is still running: investigate before it is retried" 2>/dev/null || true
        fi
    fi
    exit "$code"
}

# run_request <id> <kind> <slug> <origin> <operator> <attempt> — one claimed
# request to its terminal state; RUN_RESULT 0 succeeded, 1 otherwise. It
# always RETURNS 0 and is never called in an `||` / `if` context: there bash
# switches errexit off for the whole function body, and for the handler's
# subshell too, whatever `set -e` it says.
RUN_RESULT=1
run_request() {
    local id="$1" kind="$2" slug="$3" origin="$4" operator="$5" attempt="$6"
    local out rc=0 line verdict reason handler step hpid rpid
    local base rr
    RUN_RESULT=1
    [[ "$id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] \
        || die "the claim returned a request id that is not a uuid: '${id}'" "$GREMION_EXIT_ASSERT"
    CURRENT_WORK="${WORK_ROOT}/${id}"
    mkdir -p "$CURRENT_WORK"
    chmod 700 "$CURRENT_WORK"
    RUN_ID="$id"
    # HIGH-1: every tenant-create container of this request carries the label
    # gremion.request=<id> (customer-ops.sh tc), so it can be killed by it
    export GREMION_EXECUTOR_REQUEST_ID="$id"
    event "$id" info claim "claimed by ${HOST_ID}: ${kind} ${slug} (origin ${origin}, attempt ${attempt})"
    active_colour
    # 1. the trusted layer's verdict; nothing runs before it
    out="$(tc request-verify "$id" 2>"${CURRENT_WORK}/verify.log")" || rc=$?
    record_stream "$id" verify "$CURRENT_WORK" < "${CURRENT_WORK}/verify.log"
    if (( rc != 0 )); then
        event "$id" error verify "request-verify exited ${rc}; nothing ran"
        finish "$id" failed "verify: request-verify could not decide (exit ${rc}); nothing ran"
        cleanup_work
        return 0
    fi
    line="$(grep '^{' <<< "$out" | tail -n 1 || true)"
    verdict="$(jq -r '.verdict // empty' <<< "$line" 2>/dev/null || true)"
    case "$verdict" in
        ok) ;;
        refused)
            reason="$(jq -r '.reason // "no reason"' <<< "$line")"
            event "$id" error verify "refused: ${reason}"
            finish "$id" refused "refused: ${reason}"
            cleanup_work
            return 0 ;;
        *)
            finish "$id" failed "verify: request-verify printed no verdict; nothing ran"
            cleanup_work
            return 0 ;;
    esac
    if ! executor_sql "SELECT plt.mark_provisioning_request_verified(:'id'::uuid, :'host');" -v id="$id" -v host="$HOST_ID" >/dev/null; then
        finish "$id" failed "verify: could not mark the request verified; nothing ran"
        cleanup_work
        return 0
    fi
    event "$id" info verify "verified: $(jq -r '.evidence // ""' <<< "$line")"
    # 2. the kind's handler, on the VERIFIED args only
    if ! handler="$(handler_for "$kind")"; then
        event "$id" error dispatch "no handler for ${kind}"
        finish "$id" refused "no handler for ${kind}"
        cleanup_work
        return 0
    fi
    jq -c '.args' <<< "$line" > "${CURRENT_WORK}/args.json"
    # MED-3: a REAL renewal before the handler starts (timestamped before the
    # call). Refused: the request is no longer ours, nothing runs (and no
    # finish: the database would refuse it). Unreachable: the fence counts
    # from the claim, and a passed deadline starts nothing.
    rr=0
    try_renew "$id" || rr=$?
    case "$rr" in
        0) ;;
        1)
            event "$id" error dispatch "lease lost: the database refused the renewal of request ${id} before the handler started; nothing ran" || true
            bad "request ${id}: lease lost before the handler started; nothing ran"
            cleanup_work
            RUN_ID=""
            return 0 ;;
        *)
            bad "could not renew the lease of request ${id} before the handler (exit ${rr}); the fence counts from the claim"
            mark_renewed "$CLAIM_MONO" || die "cannot write the renewal record in ${CURRENT_WORK}" "$GREMION_EXIT_ASSERT" ;;
    esac
    base="$(cat "${CURRENT_WORK}/renewed")"
    mono
    if (( MONO - base >= FENCE_SECONDS )); then
        event "$id" error dispatch "lease fence: no successful renewal for ${FENCE_SECONDS} s; the handler is not started" || true
        bad "request ${id}: lease fence passed before the handler started; nothing ran"
        cleanup_work
        RUN_ID=""
        return 0
    fi
    rc=0
    set +e
    # The handler and the renewer run in THEIR OWN process groups (job control
    # on for the forks), so a lost lease can kill the handler and everything
    # it started (H4); the trap on INT/TERM/HUP reaches them (HIGH-2).
    set -m
    {
        exec 8>&-
        ( set -e; executor_wrap_steps; "$handler" "$id" "$slug" "$operator" "${CURRENT_WORK}/args.json" "$CURRENT_WORK" ) 2>&1 \
            | record_stream "$id" "$kind" "$CURRENT_WORK"
        printf '%s' "${PIPESTATUS[0]}" > "${CURRENT_WORK}/rc"
    } < /dev/null &
    hpid=$!
    RUN_HPID="$hpid"
    renewer "$id" "$hpid" "$$" "$base" < /dev/null &
    rpid=$!
    RUN_RPID="$rpid"
    set +m
    supervise_handler "$hpid" "$rpid" "$id"
    RUN_HPID=""; RUN_RPID=""
    set -e
    step="$(cat "${CURRENT_WORK}/step" 2>/dev/null || printf '%s' "$kind")"
    if (( STOPPED != 0 )); then
        # HIGH-1: a process or container of the request may still run. NOT
        # finished (a finished request is retryable at once); LOUD; the
        # executor exits (systemd restarts --loop, whose start sweeps the
        # request's containers again before it re-queues anything).
        reason="$(cat "${CURRENT_WORK}/abort" 2>/dev/null || printf 'the handler returned %s' "$rc")"
        audit "$id" "NOT finished: ${reason}; a process or container of the request is still running"
        event "$id" error "$step" "${reason}; a process or container of the request is still running: the request is left running (not finished) until it is confirmed gone" || true
        cleanup_work
        die "request ${id}: ${reason}; a process or container of the request is still running -- not finished, investigate (docker ps --filter label=${CONTAINER_LABEL}=${id})" "$GREMION_EXIT_ASSERT"
    fi
    if [[ -e "${CURRENT_WORK}/abort" ]]; then
        reason="$(cat "${CURRENT_WORK}/abort")"
        # LOUD: audit log (always), an error event (the database may refuse it
        # when the request is no longer ours), a non-zero exit, a failed finish
        # -- only now that the handler and its containers are confirmed gone
        event "$id" error "$step" "${reason}; the handler's process group and the request's containers were terminated" || true
        ( finish "$id" failed "${kind} ${slug}: aborted in ${step}: ${reason}" ) || true
        bad "request ${id}: ${reason}; handler aborted"
    elif (( rc == 0 )); then
        finish "$id" succeeded "${kind} ${slug}: succeeded (last step ${step})"
        RUN_RESULT=0
    else
        event "$id" error "$step" "${kind} exited ${rc} in step ${step}"
        finish "$id" failed "${kind} ${slug}: failed in ${step} (exit ${rc}); a new request resumes from the ledger"
    fi
    cleanup_work
    RUN_ID=""
    return 0
}

# one_cycle — CYCLE_RESULT 0 ran a request that succeeded, 1 ran one that did
# not, 3 the host lock is held, 4 nothing queued. Always returns 0 (see
# run_request on errexit).
CYCLE_RESULT=4
one_cycle() {
    local row id kind slug origin operator attempt
    CYCLE_RESULT=4
    beat
    if ! take_lock; then
        info "busy: another host operation holds runtime/hostd.lock; no request is claimed this cycle"
        CYCLE_RESULT=3
        return 0
    fi
    # the lease the claim grants starts no earlier than now (monotonic)
    mono; CLAIM_MONO="$MONO"
    if ! row="$(executor_sql "SELECT request_id, kind, customer_slug, origin, operator_id, attempt FROM plt.claim_provisioning_request(:'host', ${LEASE_SECONDS});" -v host="$HOST_ID")"; then
        release_lock
        die "the claim failed (gremion_platform unreachable?)" "$GREMION_EXIT_ASSERT"
    fi
    row="${row%%$'\n'*}"
    row="${row%$'\r'}"
    if [[ -z "$row" ]]; then
        release_lock
        return 0
    fi
    IFS='|' read -r id kind slug origin operator attempt <<< "$row"
    run_request "$id" "$kind" "$slug" "$origin" "$operator" "$attempt"
    CYCLE_RESULT="$RUN_RESULT"
    release_lock
    return 0
}

main() {
    local mode="${1:-}"
    case "$mode" in
        --once|--loop) ;;
        -h|--help) usage; exit "$GREMION_EXIT_OK" ;;
        *) usage >&2; exit "$GREMION_EXIT_USAGE" ;;
    esac
    need_cmd docker jq grep sed tr mktemp realpath timeout
    [[ -r /proc/uptime ]] || die "/proc/uptime is unreadable (the monotonic clock of the lease fence)" "$GREMION_EXIT_USAGE"
    # HIGH-2: the handler runs in its own process group; a signal to this
    # process must reach it, the renewer and the request's containers
    trap 'on_signal INT 130' INT
    trap 'on_signal TERM 143' TERM
    trap 'on_signal HUP 129' HUP
    ROOT="$(gremion_root)"
    RELEASE_DIR="${GREMION_RELEASE_DIR:-${ROOT}/current}"
    HOST_ID="$(host_id)"
    load_release_libs
    # customer-ops.sh resets ROOT/RELEASE_DIR from the environment; keep ours.
    ROOT="$(gremion_root)"
    RELEASE_DIR="${GREMION_RELEASE_DIR:-${ROOT}/current}"
    WORK_ROOT="${ROOT}/runtime/executor"
    AUDIT_LOG="${WORK_ROOT}/audit.log"
    mkdir -p "$WORK_ROOT"
    chmod 700 "$WORK_ROOT"
    : >> "$AUDIT_LOG" || die "the audit log is not writable: ${AUDIT_LOG}" "$GREMION_EXIT_USAGE"
    if [[ "$mode" == --once ]]; then
        one_cycle
        case "$CYCLE_RESULT" in
            0) exit "$GREMION_EXIT_OK" ;;
            3) exit "$GREMION_EXIT_BLOCKED" ;;
            4) info "no request is queued"; exit "$GREMION_EXIT_OK" ;;
            *) exit "$GREMION_EXIT_ASSERT" ;;
        esac
    fi
    # H4: one --loop daemon per host. requeue_own_requests re-queues every
    # request this host holds, so a second daemon would re-queue the first
    # one's RUNNING request and a second run of the slug could start.
    command -v flock >/dev/null 2>&1 || die "flock is not installed (util-linux)" "$GREMION_EXIT_USAGE"
    exec 8>>"${WORK_ROOT}/executor.lock" || die "cannot open ${WORK_ROOT}/executor.lock" "$GREMION_EXIT_USAGE"
    flock -n 8 || die "another gremion-executor --loop already runs on ${HOST_ID}" "$GREMION_EXIT_BLOCKED"
    # HIGH-1: an orphaned request's CONTAINER may still run (a crash, a KILL:
    # the container is the docker daemon's child). Under the host lock (a
    # --once run holds it; so does a dying predecessor's renewer until its own
    # kill is done), kill every container of this host's requests and confirm
    # them gone, THEN re-queue -- never a second run of a slug beside one
    # still running.
    until take_lock; do
        info "runtime/hostd.lock is held (a deploy, a --once run, or a predecessor still stopping); waiting before the re-queue"
        beat
        sleep "$POLL_SECONDS"
    done
    kill_request_containers "$CONTAINER_LABEL" \
        || { release_lock; die "a container of an orphaned request of ${HOST_ID} is still running (docker ps --filter label=${CONTAINER_LABEL}); nothing is re-queued" "$GREMION_EXIT_ASSERT"; }
    local n
    n="$(executor_sql "SELECT plt.requeue_own_requests(:'host');" -v host="$HOST_ID")" \
        || { release_lock; die "could not re-queue this host's orphaned requests" "$GREMION_EXIT_ASSERT"; }
    release_lock
    info "gremion-executor ${EXECUTOR_VERSION} on ${HOST_ID}: ${n:-0} orphaned request(s) re-queued; polling every ${POLL_SECONDS} s"
    while true; do
        one_cycle
        # a request just ran: look again at once; otherwise wait
        if (( CYCLE_RESULT == 3 || CYCLE_RESULT == 4 )); then sleep "$POLL_SECONDS"; fi
    done
}

main "$@"
