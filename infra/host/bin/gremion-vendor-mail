#!/usr/bin/env bash
set -euo pipefail
#
# gremion-vendor-mail — the host launcher of the vendor mail tooling (TASK-015).
#
#   gremion-vendor-mail <subcommand> [args...]
#
# The vendor's own mail (system@, alerts@) is sent by the self-hosted Stalwart
# of the ${STACK}-mail project. Its checks and its principal CLI are Node ESM
# under ops/vendor-mail/, and the host carries no Node (bootstrap.sh installs
# none, Q11): every .mjs subcommand therefore runs as
#
#   docker run --rm <VENDOR_MAIL_NODE_IMAGE> node /release/ops/vendor-mail/<sub>.mjs
#
# with ops/vendor-mail mounted read-only. VENDOR_MAIL_NODE_IMAGE is read from
# mail.env ONLY (an exported value is discarded before the file is loaded, and
# there is no default) and must be pinned by digest (TRD-350).
#
# WHERE IT RUNS FROM. <root>/current is a full release clone (gremion-deploy),
# so this file is <root>/current/infra/host/bin/gremion-vendor-mail and
# ${SCRIPT_DIR}/../../../ops/vendor-mail is <root>/current/ops/vendor-mail.
# Only gremion-hostd is installed into <root>/bin; a hostd caller (TASK-043)
# runs this launcher through the current/ path.
#
# CONTAINERS. Named ${STACK}-vendor-mail-<sub>-<pid>, labelled
# gremion.stack=${STACK}, --network none -- except `principals`, which needs
# the loopback management API (STALWART_ADMIN_URL, <ip>:8086) and so runs with
# --network host. That one exception sits outside check-pooled-stack's
# ISOLATION table (it is a transient one-shot, not a project service);
# ops/vendor-mail/RUNBOOK.md states it.
#
# SECRETS never travel on an argv: mail.env (and, per subcommand, ops.env,
# the secret stores) are MOUNTED read-only and read by the check itself; the
# realm SMTP password reaches kcadm on stdin; the Keycloak admin password is
# passed as a name-only `docker exec -e`, so its value is in no host argv.
#
# Subcommands
#   principals issue|revoke|list --tenant <token>     (node, --network host)
#   check-identities                                   (node)
#   check-received --file <headers file> [--receiver <id>] (node)
#   check-upstream-image                               (node)
#   check-deliverability-record [--require]            (node)
#   check-secret-separation --host                     (node; value hashes)
#   check-principals --host [--no-allowances]          (node; runs `collect`)
#   realm-smtp                                         (bash; kcadm)
#   collect --out DIR                                  (bash; API + kcadm)
#
# EXIT CODES: 0 ok - 1 a check or post-condition failed - 2 usage/precondition.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

VENDOR_MAIL_DIR="${SCRIPT_DIR}/../../../ops/vendor-mail"
KCADM_BIN="/opt/keycloak/bin/kcadm.sh"
KC_SERVER="http://127.0.0.1:8080/auth"
NODE_SUBS=" principals check-identities check-received check-upstream-image check-deliverability-record check-secret-separation check-principals "
# The image line of mail.env: repository, optional tag, and a sha256 digest.
DIGEST_RE='^[a-z0-9][a-z0-9._/:-]*@sha256:[0-9a-f]{64}$'

usage() {
    cat <<'EOF'
usage: gremion-vendor-mail <subcommand> [args...]
  principals issue|revoke|list --tenant <token> [--rotate]
  check-identities | check-upstream-image | check-deliverability-record [--require]
  check-received --file <headers file> [--receiver <authserv-id>]
  check-secret-separation --host
  check-principals --host [--no-allowances]
  realm-smtp            (the operator realm `master` -> system@<PLATFORM_DOMAIN>)
  collect --out DIR
EOF
}

# env_key <file> <key> — ONE key of an env file, never the whole file (the
# single whole-file reader is load_env). Empty when absent.
env_key() {
    local file="$1" key="$2"
    [[ -f "$file" ]] || die "env file not found: ${file}" "$GREMION_EXIT_USAGE"
    sed -n "s/^${key}=//p" "$file" | tail -n1
}

resolve_vendor_dir() {
    [[ -d "$VENDOR_MAIL_DIR" ]] \
        || die "ops/vendor-mail not found at ${VENDOR_MAIL_DIR}: run this launcher from a release tree (<root>/current/infra/host/bin)" \
               "$GREMION_EXIT_USAGE"
    VENDOR_MAIL_DIR="$(cd "$VENDOR_MAIL_DIR" && pwd)"
    RELEASE_DIR="$(cd "${VENDOR_MAIL_DIR}/../.." && pwd)"
}

load_mail_env() {
    MAIL_ENV="${MAIL_ENV:-$(gremion_root)/etc/env/mail.env}"
    # From mail.env ONLY: a value exported by the caller must not survive a file
    # that does not declare the key.
    unset VENDOR_MAIL_NODE_IMAGE
    load_env "$MAIL_ENV"
    [[ -n "${STACK:-}" ]] || die "STACK is not set in ${MAIL_ENV}" "$GREMION_EXIT_USAGE"
}

require_node_image() {
    [[ -n "${VENDOR_MAIL_NODE_IMAGE:-}" ]] \
        || die "VENDOR_MAIL_NODE_IMAGE is not set in ${MAIL_ENV}: the checks run in that pinned image and nowhere else (no default)" \
               "$GREMION_EXIT_USAGE"
    [[ "$VENDOR_MAIL_NODE_IMAGE" =~ $DIGEST_RE ]] \
        || die "VENDOR_MAIL_NODE_IMAGE must be pinned by digest (<repo>@sha256:<64 hex>), not by a tag (TRD-350)" \
               "$GREMION_EXIT_USAGE"
}

# ── kcadm against the state Keycloak ────────────────────────────────────────
STATE_ENV=""
KC_CID=""

kc_connect() {
    need_cmd docker jq
    STATE_ENV="${STATE_ENV_FILE:-$(gremion_root)/etc/env/state.env}"
    local admin="${KEYCLOAK_ADMIN:-}" password="${KEYCLOAK_ADMIN_PASSWORD:-}" rc=0
    [[ -n "$admin" ]]    || admin="$(env_key "$STATE_ENV" KEYCLOAK_ADMIN)"
    [[ -n "$password" ]] || password="$(env_key "$STATE_ENV" KEYCLOAK_ADMIN_PASSWORD)"
    [[ -n "$admin" && -n "$password" ]] \
        || die "KEYCLOAK_ADMIN/KEYCLOAK_ADMIN_PASSWORD are unset (neither exported nor in ${STATE_ENV}); kcadm has no credential" \
               "$GREMION_EXIT_USAGE"
    KC_CID="$(state_kc_cid "$STACK")" || rc=$?
    case "$rc" in
        0) ;;
        2) die "docker could not list the ${STACK}-state containers" "$GREMION_EXIT_USAGE" ;;
        *) die "no single running keycloak in the ${STACK}-state project (looked up by the compose labels project=${STACK}-state, service=keycloak)" \
               "$GREMION_EXIT_USAGE" ;;
    esac
    # Name-only -e: docker copies the value from this process's environment,
    # so it is on no host argv.
    KC_LOGIN_PASSWORD="$password" docker exec -e KC_LOGIN_PASSWORD "$KC_CID" sh -c \
        '"$0" config credentials --server "$1" --realm master --user "$2" --password "$KC_LOGIN_PASSWORD" >/dev/null' \
        "$KCADM_BIN" "$KC_SERVER" "$admin" \
        || die "kcadm could not authenticate against the state keycloak at ${KC_SERVER}" "$GREMION_EXIT_ASSERT"
}

# The non-secret fields of a realm's smtpServer, one canonical JSON line.
realm_smtp_fields() {   # <realm>
    local out
    out="$(docker exec "$KC_CID" "$KCADM_BIN" get "realms/$1" --fields smtpServer)" || return 1
    printf '%s' "$out" | jq -c '(.smtpServer // {}) | {host, port, user, from, starttls}'
}

# realm-smtp — the operator realm `master` sends as system@<PLATFORM_DOMAIN>
# through mail.<PLATFORM_DOMAIN>:587 with STARTTLS (TASK-015). Idempotent: the
# payload is converged on every run and the non-secret fields are READ BACK;
# the post-condition is the read-back, never kcadm's exit code.
cmd_realm_smtp() {
    local realm="master" a
    for a in "$@"; do
        case "$a" in
            --realm|--tenant|--rotate|--revoke)
                die "realm-smtp ${a} is reserved: per-customer realm senders are owned by TASK-043 (kc-<token>@ principals); this verb sets the vendor realm only" \
                    "$GREMION_EXIT_USAGE" ;;
            -h|--help) usage; exit "$GREMION_EXIT_OK" ;;
            *) usage >&2; die "realm-smtp: unknown argument: ${a}" "$GREMION_EXIT_USAGE" ;;
        esac
    done
    [[ -n "${VENDOR_SMTP_PASSWORD:-}" ]] || die "VENDOR_SMTP_PASSWORD is empty in ${MAIL_ENV}" "$GREMION_EXIT_USAGE"
    [[ -n "${PLATFORM_DOMAIN:-}" ]] || die "PLATFORM_DOMAIN is empty in ${MAIL_ENV}" "$GREMION_EXIT_USAGE"
    kc_connect
    local want before after payload
    want="$(jq -nc --arg d "$PLATFORM_DOMAIN" \
        '{host: ("mail." + $d), port: "587", user: ("system@" + $d), from: ("system@" + $d), starttls: "true"}')"
    before="$(realm_smtp_fields "$realm")" \
        || die "kcadm could not read realms/${realm}" "$GREMION_EXIT_ASSERT"
    # The password is read by jq from the environment ($ENV), never from argv,
    # and the payload reaches kcadm on stdin.
    payload="$(jq -nc --argjson w "$want" \
        '{smtpServer: ($w + {ssl: "false", auth: "true", fromDisplayName: "Gremion",
                             password: $ENV.VENDOR_SMTP_PASSWORD})}')"
    printf '%s' "$payload" | docker exec -i "$KC_CID" "$KCADM_BIN" update "realms/${realm}" -f - >/dev/null \
        || die "kcadm refused to update realms/${realm}" "$GREMION_EXIT_ASSERT"
    after="$(realm_smtp_fields "$realm")" \
        || die "kcadm could not read realms/${realm} back" "$GREMION_EXIT_ASSERT"
    if [[ "$(jq -c -S . <<<"$after")" != "$(jq -c -S . <<<"$want")" ]]; then
        bad "realms/${realm} smtpServer read back as ${after}, expected ${want}"
        exit "$GREMION_EXIT_ASSERT"
    fi
    local changed=yes
    [[ "$(jq -c -S . <<<"$before")" == "$(jq -c -S . <<<"$want")" ]] && changed=no
    ok "realms/${realm} sends as system@${PLATFORM_DOMAIN} via mail.${PLATFORM_DOMAIN}:587 STARTTLS"
    printf 'REALM-SMTP: realm=%s user=system@%s changed=%s\n' "$realm" "$PLATFORM_DOMAIN" "$changed"
}

# collect --out DIR — the host inputs of check-principals, stripped to what the
# check reads: principal names/emails/roles (never their secrets, which the
# list API returns in plaintext app-password form) and every realm's
# smtpServer user/from/host (never its password).
cmd_collect() {
    local out=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out) [[ $# -ge 2 ]] || die "--out requires a value" "$GREMION_EXIT_USAGE"; out="$2"; shift 2 ;;
            *) usage >&2; die "collect: unknown argument: $1" "$GREMION_EXIT_USAGE" ;;
        esac
    done
    [[ -n "$out" && -d "$out" ]] || die "collect needs --out <existing directory>" "$GREMION_EXIT_USAGE"
    need_cmd curl jq docker
    local raw; raw="$(mktemp)"
    # The admin credential goes to curl on stdin (-K -), never on its argv.
    printf 'user = "%s:%s"\n' "$STALWART_ADMIN_USER" "$STALWART_ADMIN_PASSWORD" \
        | curl -sS -K - -o "$raw" "${STALWART_ADMIN_URL}/api/principal?types=individual&limit=0" \
        || { rm -f "$raw"; die "the management API at ${STALWART_ADMIN_URL} did not answer" "$GREMION_EXIT_ASSERT"; }
    # HTTP 200 carries failures too: the verdict is the body.
    if ! jq -e 'has("data") and (.data.items | type == "array")' "$raw" >/dev/null 2>&1; then
        rm -f "$raw"
        die "the principal list came back without a data.items array (an {\"error\":...} body is a failure, not an empty list)" \
            "$GREMION_EXIT_ASSERT"
    fi
    jq '[.data.items[] | if type == "string" then {name: .} else {name, type, emails: (.emails // []), roles: (.roles // [])} end]' \
        "$raw" | atomic_write "${out}/principals.json" 0600
    rm -f "$raw"
    kc_connect
    local realms
    realms="$(docker exec "$KC_CID" "$KCADM_BIN" get realms --fields realm,smtpServer)" \
        || die "kcadm could not list the realms" "$GREMION_EXIT_ASSERT"
    jq '[.[] | {realm, smtp: ((.smtpServer // {}) | {user, from, host})}]' <<<"$realms" \
        | atomic_write "${out}/realms.json" 0600 \
        || die "the realm listing was not a JSON array" "$GREMION_EXIT_ASSERT"
    ok "collected $(jq length "${out}/principals.json") principal(s) and $(jq length "${out}/realms.json") realm(s) into ${out}"
}

# The gremion-ui containers' environment as <colour>\t<KEY>\t<sha256(value)>
# lines, so the separation check compares values it is never handed.
ui_env_hashes() {   # <file>
    local file="$1" colour cid line
    : > "$file"
    for colour in blue green; do
        cid="$(docker ps -q --filter "label=com.docker.compose.project=${STACK}-app-${colour}" \
                            --filter "label=com.docker.compose.service=gremion-ui" | head -n1)" \
            || die "docker could not list the ${STACK}-app-${colour} containers" "$GREMION_EXIT_USAGE"
        [[ -n "$cid" ]] || continue
        while IFS= read -r line; do
            [[ "$line" == *=* ]] || continue
            printf '%s\t%s\t%s\n' "$colour" "${line%%=*}" \
                "$(printf '%s' "${line#*=}" | sha256sum | cut -d' ' -f1)" >> "$file"
        done < <(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$cid")
    done
}

run_node() {
    local sub="$1"; shift
    require_node_image
    [[ -f "${VENDOR_MAIL_DIR}/${sub}.mjs" ]] \
        || die "ops/vendor-mail/${sub}.mjs is missing from ${VENDOR_MAIL_DIR}" "$GREMION_EXIT_USAGE"
    local net=none root work="" a
    root="$(gremion_root)"
    [[ "$sub" == principals ]] && net=host
    local -a mounts=(-v "${VENDOR_MAIL_DIR}:/release/ops/vendor-mail:ro"
                     -v "${MAIL_ENV}:/run/gremion/env/mail.env:ro")
    local -a args=()
    case "$sub" in
        check-identities)
            mounts+=(-v "${root}/etc/env/ops.env:/run/gremion/env/ops.env:ro") ;;
        check-upstream-image|check-deliverability-record)
            mounts+=(-v "${RELEASE_DIR}/infra/host/mail:/release/infra/host/mail:ro"
                     -v "${RELEASE_DIR}/infra/host/templates/env:/release/infra/host/templates/env:ro") ;;
        check-secret-separation|check-principals)
            [[ " $* " == *" --host "* ]] \
                || die "${sub} runs on a host with --host; the fixture mode is the verify suite's" "$GREMION_EXIT_USAGE"
            work="$(mktemp -d)"
            # shellcheck disable=SC2064  # expand $work now: it is local
            trap "rm -rf '${work}'" EXIT
            chmod 700 "$work"
            if [[ "$sub" == check-secret-separation ]]; then
                ui_env_hashes "${work}/ui-env.tsv"
                mounts+=(-v "${root}/etc/env:/run/gremion/env-all:ro"
                         -v "${root}/etc/secrets:/run/gremion/secrets:ro"
                         -v "${work}:/run/gremion/collect:ro")
            else
                cmd_collect --out "$work" >&2
                mounts+=(-v "${work}:/run/gremion/collect:ro")
            fi ;;
    esac
    # check-received reads one headers file: mount it and hand the check the
    # in-container path.
    while [[ $# -gt 0 ]]; do
        a="$1"; shift
        if [[ "$sub" == check-received && "$a" == --file ]]; then
            [[ $# -ge 1 ]] || die "--file requires a value" "$GREMION_EXIT_USAGE"
            [[ -r "$1" ]] || die "cannot read ${1}" "$GREMION_EXIT_USAGE"
            mounts+=(-v "$(realpath "$1"):/run/gremion/in/received.eml:ro")
            args+=(--file /run/gremion/in/received.eml); shift
        else
            args+=("$a")
        fi
    done
    local rc=0
    docker run --rm --name "${STACK}-vendor-mail-${sub}-$$" --label "gremion.stack=${STACK}" \
        --network "$net" --read-only --cap-drop ALL --security-opt no-new-privileges \
        --user "$(id -u):$(id -g)" -e VENDOR_MAIL_MODE=host \
        "${mounts[@]}" "$VENDOR_MAIL_NODE_IMAGE" node "/release/ops/vendor-mail/${sub}.mjs" "${args[@]}" \
        || rc=$?
    return "$rc"
}

main() {
    [[ $# -ge 1 ]] || { usage >&2; exit "$GREMION_EXIT_USAGE"; }
    local sub="$1"; shift
    case "$sub" in
        -h|--help) usage; exit "$GREMION_EXIT_OK" ;;
    esac
    if [[ "$NODE_SUBS" != *" ${sub} "* && "$sub" != realm-smtp && "$sub" != collect ]]; then
        usage >&2
        die "unknown subcommand: ${sub}" "$GREMION_EXIT_USAGE"
    fi
    need_cmd docker sed tail mktemp
    resolve_vendor_dir
    load_mail_env
    case "$sub" in
        realm-smtp) cmd_realm_smtp "$@" ;;
        collect)    cmd_collect "$@" ;;
        *)          run_node "$sub" "$@" ;;
    esac
}

main "$@"
