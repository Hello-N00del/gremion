#!/usr/bin/env bash
# infra/host/bin/gremion-render — render the host-owned files a release needs.
#
# Spec A §E: the files that cannot live inside an image, because they carry
# host identity or host secrets, are produced here, and EVERY output is
# asserted from disk — a regular file, not a directory, non-empty — before
# any `docker compose ... up` runs. An exit code is not evidence; the file is.
#
#   1. <release>/docker/pgbouncer/userlist.txt      from PGBOUNCER_AUTH_PASSWORD
#   2. <release>/docker/keycloak/certs/*            minted ONCE, persisted in
#                                                   etc/secrets/keycloak
#   3. etc/secrets/ipcrypt_key.txt                  generated once, never
#                                                   rotated here
#   4. every release template ending in .tmpl       through an explicit
#                                                   variable allow-list
#   5. etc/edge/extra-hosts.yml                     --staging only
#   6. <release>/legal/legal.env                    a copy of the host's
#                                                   etc/legal.env, refused while
#                                                   it holds a placeholder
#                                                   (kernel #84)
#   7. etc/edge/control-panel.yml                   the public control-panel
#                                                   router and its client-
#                                                   certificate TLS option, ONLY
#                                                   on an opt-in host whose
#                                                   active.yml already defines
#                                                   the panel service; otherwise
#                                                   the file is removed
#
# Exit codes: 0 ok · 1 post-condition failed · 2 usage/missing precondition ·
#             3 blocked.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

RELEASE_DIR=""
STAGING=0
LEGAL_ONLY=0
INIT_LEGAL=0
CONTROL_ONLY=0
DEFER_CONTROL=0
OUTPUTS=0

# The ONLY variables a release template may name. A template referencing
# anything else is a mistake we refuse to guess at. A key is REQUIRED only when a
# template actually names it, so an entry costs nothing until one does. The pilot's
# templates are docker/element-call/config.json.tmpl (PLATFORM_DOMAIN and
# PILOT_TENANT_HOST) and docker/livekit/livekit.yaml.tmpl (the three LIVEKIT_TURN_* /
# LIVEKIT_RTC_PORT_END values derived from PILOT_TENANT_HOST by derive_livekit_relay);
# the LiveKit keys reach LiveKit through its environment, not a template.
RENDER_ALLOWED_VARS=(
    STACK PLATFORM_DOMAIN ACME_EMAIL TRAEFIK_CERT_RESOLVER
    EDGE_BIND_IP EDGE_BIND_IP6 EDGE_HTTP_PORT EDGE_HTTPS_PORT
    MAIL_BIND_IP MAIL_BIND_IP6
    EDGE_V4_SUBNET EDGE_V6_SUBNET STATE_V4_SUBNET STATE_V6_SUBNET
    IMAGE_TAG
    LIVEKIT_API_KEY LIVEKIT_API_SECRET LIVEKIT_TURN_SECRET
    ELEMENT_CALL_LIVEKIT_URL
    PILOT_TENANT_HOST CONTROL_HOST
    LIVEKIT_TURN_ENABLED LIVEKIT_TURN_DOMAIN LIVEKIT_RTC_PORT_END
)

# The gid the PgBouncer image runs as (edoburu/pgbouncer: postgres, 70).
PGBOUNCER_GID="${GREMION_PGBOUNCER_GID:-70}"

KC_ARTEFACTS=(internal-ca.crt internal-ca.pem internal-ca.key keycloak.crt keycloak.key)

usage() {
    cat <<'EOF'
usage: gremion-render [--release DIR] [--staging | --legal-env-only | --init-legal-env | --control-panel-only] [--defer-control-panel]

  --release DIR   release tree to render into (default: <gremion root>/current)
  --staging       additionally write etc/edge/extra-hosts.yml, the compose
                  fragment that resolves the production hostnames to this
                  unit's own edge address from inside every container.
                  Requires TRAEFIK_CERT_RESOLVER to be EMPTY in state.env:
                  a staging unit never requests public certificates.
  --legal-env-only
                  render only <release>/legal/legal.env, the env file of the
                  state project's legal service, from etc/legal.env. The
                  deploy runs this before its first compose call on a new
                  release tree.
  --control-panel-only
                  render only etc/edge/control-panel.yml (step 7), and remove it
                  when the install has not opted in. gremion-deploy runs this
                  right after the switch: the router may only exist once the
                  switch has written the `panel` service it routes to. On a host
                  built by hand (no gremion-deploy) gremion-switch renders it itself;
                  run this yourself only when the switch said it could not.
  --defer-control-panel
                  with the full render: check the control-panel opt-in (every
                  refusal of step 7 still applies) but neither write nor
                  remove etc/edge/control-panel.yml when the opt-in is valid.
                  gremion-deploy passes it at step 4: a router rendered before
                  the switch would route to the previous colour's panel, which
                  still carries the previous ORIGIN.
  --init-legal-env
                  create etc/legal.env from the release's
                  legal/legal.env.example, with a CHANGE_ME_OPERATOR_
                  placeholder for each key only the operator knows, and say
                  how many are still to fill. Keeps an existing file. Reads
                  PLATFORM_DOMAIN from state.env, so fill that first.
EOF
}

var_allowed() {
    local needle="$1" v
    for v in "${RENDER_ALLOWED_VARS[@]}"; do
        if [[ "$v" == "$needle" ]]; then return 0; fi
    done
    return 1
}

# assert_rendered <path> — the §E post-condition, observed from disk.
assert_rendered() {
    local p="$1"
    if [[ -d "$p" ]]; then die "render output is a directory: $p"; fi
    if [[ ! -f "$p" ]]; then die "render output missing: $p"; fi
    if [[ ! -s "$p" ]]; then die "render output is empty: $p"; fi
    OUTPUTS=$((OUTPUTS + 1))
    ok "rendered $p"
}

# set_group <file> <gid>
# Sets the file's group to the numeric gid a container reads it as. The render
# runs as the deploy user, who may not own that gid, so chgrp is tried directly
# first (it works for a group the user belongs to, which bootstrap's `user`
# stage arranges, and it is the only route under the NoNewPrivileges that
# gremion-hostd's unit sets) and then through `sudo -n` (an interactive deploy
# over ssh). Returns 1 with both reasons in SET_GROUP_ERR when neither works.
SET_GROUP_ERR=""
set_group() {
    local path="$1" gid="$2" e1 e2=""
    if e1="$(chgrp -- "$gid" "$path" 2>&1)"; then return 0; fi
    if ! command -v sudo >/dev/null 2>&1; then
        e2="sudo is not installed"
    elif e2="$(sudo -n chgrp -- "$gid" "$path" 2>&1)"; then
        return 0
    fi
    SET_GROUP_ERR="chgrp: ${e1//$'\n'/ }; sudo -n chgrp: ${e2//$'\n'/ }"
    return 1
}

# write_userlist <path> <gid> <content>
# Publishes the userlist atomically in its final state: the temp file is
# written 0600, handed to the group, THEN made 0640 and renamed over <path>.
# Nothing is published before it carries the right group, so a failure leaves
# the previous userlist exactly as it was (no rm of a good file), and the
# secret is never readable by the deploy user's own group. The result is read
# back: an exit code is not evidence, the file's group and mode are.
# On a filesystem that carries no POSIX modes (Git Bash on NTFS) a group means
# nothing, so the group step is skipped there, as every other mode check is.
write_userlist() {
    local path="$1" gid="$2" content="$3" tmp modes=1 seen
    tmp="${path}.tmp"
    if [[ -L "$tmp" ]]; then rm -f -- "$tmp"; fi
    if ! (umask 077; printf '%s\n' "$content" > "$tmp"); then
        rm -f -- "$tmp"
        die "cannot write ${tmp}"
    fi
    if fs_carries_modes "$(dirname "$path")"; then
        if ! set_group "$tmp" "$gid"; then
            rm -f -- "$tmp"
            die "cannot hand ${path} to group ${gid} (the container reads this file as gid ${gid}): ${SET_GROUP_ERR}. Add the deploy user to group ${gid} (bootstrap's user stage does) and restart gremion-hostd; set GREMION_PGBOUNCER_GID if the image runs as another gid"
        fi
    else
        modes=0
        info "filesystem carries no POSIX modes: not setting group ${gid} on ${path}"
    fi
    if ! chmod 0640 "$tmp"; then
        rm -f -- "$tmp"
        die "cannot chmod ${tmp}"
    fi
    if [[ "$modes" -eq 1 ]]; then
        seen="$(stat -c '%g %a' "$tmp")"
        if [[ "$seen" != "${gid} 640" ]]; then
            rm -f -- "$tmp"
            die "userlist temp file is '${seen}', expected '${gid} 640': refusing to publish it"
        fi
    fi
    if ! mv -f -T "$tmp" "$path"; then
        rm -f -- "$tmp"
        die "cannot move ${tmp} into place at ${path}"
    fi
}

# 1. pgbouncer's auth_user credential. Every other role is resolved through
#    auth_query against Postgres' SCRAM verifier, so this one line is the whole
#    file (docker/pgbouncer/userlist.txt.example says so in the kernel tree).
render_pgbouncer_userlist() {
    local dir out
    dir="${RELEASE_DIR}/docker/pgbouncer"
    if [[ ! -d "$dir" ]]; then
        die "release tree has no docker/pgbouncer directory: $dir" 2
    fi
    if [[ -z "${PGBOUNCER_AUTH_PASSWORD:-}" ]]; then
        die "missing env key PGBOUNCER_AUTH_PASSWORD" 2
    fi
    out="${dir}/userlist.txt"
    # The PgBouncer container runs as uid/gid 70 and bind-mounts this file
    # read-only, so a 0600 file owned by the deploy user is unreadable to it on
    # a Linux host (issue #83; Docker Desktop ignores bind-mount modes, which is
    # why no proof caught it). The file is therefore 0640 and handed to the
    # PgBouncer gid: the deploy user keeps read/write, PgBouncer reads, other
    # users get nothing. This is the group-read-bit precedent of
    # docker/keycloak/certs/gen-internal-ca.sh, narrowed to one gid.
    write_userlist "$out" "$PGBOUNCER_GID" "$(printf '"pgbouncer_auth" "%s"' "$PGBOUNCER_AUTH_PASSWORD")"
    assert_rendered "$out"
    if ! grep -q '^"pgbouncer_auth" "' "$out"; then
        die "userlist.txt does not carry the pgbouncer_auth entry: $out"
    fi
    if grep -q 'CHANGE_ME_' "$out"; then
        die "userlist.txt still carries a CHANGE_ME_ sentinel: $out"
    fi
}

# 2. The internal CA. Keycloak lives in the STATE project and is not recreated
#    by an app-only deploy, so a CA minted per release would leave its server
#    cert trusted by nobody. The CA is therefore minted once, persisted under
#    etc/secrets/keycloak, and every later release tree is seeded FROM the
#    store — after which gen-internal-ca.sh is a no-op by its own idempotence.
render_keycloak_certs() {
    local tree store gen f
    tree="${RELEASE_DIR}/docker/keycloak/certs"
    store="$(gremion_root)/etc/secrets/keycloak"
    gen="${tree}/gen-internal-ca.sh"
    if [[ ! -x "$gen" ]]; then
        die "release tree has no executable docker/keycloak/certs/gen-internal-ca.sh: $gen" 2
    fi
    mkdir -p "$store"
    chmod 0700 "$store"
    for f in "${KC_ARTEFACTS[@]}"; do
        if [[ -f "${store}/${f}" ]]; then cp -p "${store}/${f}" "${tree}/${f}"; fi
    done
    if ! "$gen"; then die "gen-internal-ca.sh failed in ${tree}"; fi
    for f in "${KC_ARTEFACTS[@]}"; do
        assert_rendered "${tree}/${f}"
        cp -p "${tree}/${f}" "${store}/${f}"
    done
    chmod 0600 "${store}/internal-ca.key" "${store}/keycloak.key"
}

# 3. The ipcrypt key that pseudonymises client IPs in the vector pipeline.
#    It lives in etc/secrets (§A) and is generated ONCE: rotation belongs to
#    scripts/rotate-ipcrypt-key.sh, which truncates this same inode in place so
#    the running container sees the new value. A render must never undo that.
ensure_ipcrypt_key() {
    local dir key epoch
    dir="$(gremion_root)/etc/secrets"
    key="${dir}/ipcrypt_key.txt"
    epoch="${dir}/ipcrypt_epoch.txt"
    mkdir -p "$dir"
    if [[ ! -f "$key" ]]; then
        openssl rand -hex 16 | atomic_write "$key" 0600
        info "generated a new ipcrypt key"
    fi
    if [[ ! -f "$epoch" ]]; then
        printf '0\n' | atomic_write "$epoch" 0600
    fi
    assert_rendered "$key"
    assert_rendered "$epoch"
    if ! grep -Eq '^[0-9a-f]{32}$' "$key"; then
        die "ipcrypt key is not 32 hex characters: $key"
    fi
}

# 4. Release templates. Substitution is done in bash, not by envsubst and not
#    by eval: the template's own text is never executed, only allow-listed
#    variables are replaced, and the host needs no gettext-base package. An
#    unknown name is refused rather than silently left in place, which is how
#    a config ships with a literal ${SECRET} in it.
render_template() {
    local tpl="$1" out="$2" body var
    if [[ ! -s "$tpl" ]]; then die "release template is empty: $tpl" 2; fi
    body="$(cat "$tpl")"
    # The single-quoted strings in this loop are LITERAL patterns handed to
    # grep and tr: a dollar-brace that must NOT expand here is the point.
    # shellcheck disable=SC2016
    while IFS= read -r var; do
        if [[ -z "$var" ]]; then continue; fi
        if ! var_allowed "$var"; then
            die "unknown variable \${${var}} in ${tpl} (not in the render allow-list)" 2
        fi
        if [[ -z "${!var:-}" ]]; then
            die "missing env key ${var} required by ${tpl}" 2
        fi
        body="${body//\$\{${var}\}/${!var}}"
    done < <(grep -oE '\$\{[A-Za-z_][A-Za-z0-9_]*\}' "$tpl" | tr -d '${}' | sort -u)
    printf '%s\n' "$body" | atomic_write "$out" 0644
    assert_rendered "$out"
    # shellcheck disable=SC2016
    if grep -q '\${' "$out"; then
        die "unsubstituted \${...} left in ${out}"
    fi
}

# The video relay (TURN over TLS on 443) is configured from PILOT_TENANT_HOST, the
# one value state.env hands both this program (load_env, above) and `docker compose
# --env-file state.env` (the Traefik labels of docker-compose.prod.yml read it
# there). With a customer host the relay answers turn.<host>; without one it is OFF
# and LiveKit keeps its whole UDP block for media, exactly as before the relay. The
# placeholder domain is a reserved .invalid name, there only because the key must
# hold a value: it is never served and no certificate is ever ordered for it.
# The value ends up in a Traefik rule, so only a lower-case host name is accepted.
# The three LIVEKIT_* values set below are read by render_template through the
# RENDER_ALLOWED_VARS envsubst list, not by name in this file.
# shellcheck disable=SC2034
derive_livekit_relay() {
    local host="${PILOT_TENANT_HOST:-}"
    local re='^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$'
    if [[ -z "$host" ]]; then
        LIVEKIT_TURN_ENABLED=false
        LIVEKIT_TURN_DOMAIN="turn.relay.invalid"
        LIVEKIT_RTC_PORT_END=45100
        return 0
    fi
    if [[ ! "$host" =~ $re ]]; then
        die "PILOT_TENANT_HOST is not a lower-case host name (value not shown): it names the video relay's public host" 2
    fi
    LIVEKIT_TURN_ENABLED=true
    LIVEKIT_TURN_DOMAIN="turn.${host}"
    LIVEKIT_RTC_PORT_END=45050
}

render_release_templates() {
    local tpl found=0
    while IFS= read -r tpl; do
        if [[ -z "$tpl" ]]; then continue; fi
        found=$((found + 1))
        render_template "$tpl" "${tpl%.tmpl}"
    done < <(find "${RELEASE_DIR}/docker" -type f -name '*.tmpl' | sort)
    info "release templates rendered: ${found}"
}

# 5. Staging only: resolve the PRODUCTION hostnames to this unit's own edge
#    address from inside every container (§E/N9), so a staging unit exercises
#    the real names without public DNS and without public certificates.
#    TRAEFIK_CERT_RESOLVER must therefore be EMPTY. Task 1's state.env.tmpl
#    ships le-http, so a staging root has to blank the key first; refusing
#    here is how a forgotten blanking is caught before the fragment lands.
#    KNOWN, ACCEPTED: etc/edge is also Traefik's dynamic directory, so a
#    staging Traefik logs one "field not found, node: services" for this file
#    per reload and ignores it. Routing is unaffected and the file never
#    exists on a production host.
render_staging_extra_hosts() {
    local out tfile services line host svc control_host
    local hosts=()
    if [[ -n "${TRAEFIK_CERT_RESOLVER:-}" ]]; then
        die "--staging refuses a render whose TRAEFIK_CERT_RESOLVER is set: staging never holds public certificates" 2
    fi
    if [[ -z "${PLATFORM_DOMAIN:-}" ]]; then die "missing env key PLATFORM_DOMAIN" 2; fi
    if [[ -z "${EDGE_BIND_IP:-}" ]]; then die "missing env key EDGE_BIND_IP" 2; fi
    need_cmd docker

    # The control panel's host is the one the install resolves (CONTROL_PANEL_HOST, else
    # control.<domain>), so a staging unit resolves the name the panel is really served on.
    if ! control_host="$(resolve_control_panel_host)"; then die "$control_host" 2; fi
    hosts+=("${PLATFORM_DOMAIN}" "${control_host}" "mail.${PLATFORM_DOMAIN}")
    tfile="$(gremion_root)/etc/tenant-hosts.txt"
    if [[ -f "$tfile" ]]; then
        while IFS= read -r line; do
            host="${line%%#*}"
            host="$(printf '%s' "$host" | tr -d '[:space:]')"
            if [[ -n "$host" ]]; then hosts+=("$host"); fi
        done < "$tfile"
    else
        info "no ${tfile}: rendering the three platform hosts only"
    fi

    services="$(cd "$RELEASE_DIR" && docker compose --env-file "$(gremion_root)/etc/env/state.env" config --services)"
    if [[ -z "$services" ]]; then
        die "staging extra_hosts: compose reported zero services"
    fi

    out="$(gremion_root)/etc/edge/extra-hosts.yml"
    mkdir -p "$(dirname "$out")"
    {
        echo "# Generated by gremion-render --staging. Do not edit: every run overwrites it."
        echo "# Staging resolves the production hostnames to this unit's own edge address"
        echo "# from inside the containers (spec A section E). Traefik's file provider also"
        echo "# watches this directory and logs one 'field not found, node: services' error"
        echo "# for this file on each reload; that is accepted, staging-only noise."
        echo "services:"
        while IFS= read -r svc; do
            if [[ -z "$svc" ]]; then continue; fi
            echo "  ${svc}:"
            echo "    extra_hosts:"
            for host in "${hosts[@]}"; do
                echo "      - \"${host}:${EDGE_BIND_IP}\""
            done
        done <<< "$services"
    } | atomic_write "$out" 0644
    assert_rendered "$out"
}

# 7. The control panel's public router (operator decision 2026-11-12). OFF unless
#    the install opts in, and fail-closed both ways:
#      - CONTROL_PANEL_ORIGIN (state.env) empty: no router. A file an earlier
#        opt-in left is DELETED, so turning the key off turns the host off.
#      - CONTROL_PANEL_ORIGIN set: it must be exactly https://<the control host>,
#        where the control host is CONTROL_PANEL_HOST (state.env: a lowercase DNS
#        host name, validated, it may lie outside the platform domain) or, when
#        that is empty or absent, control.<domain>,
#        the operator CA certificate must be at etc/edge/mtls/operator-ca.pem
#        (a PEM CA certificate, never a private key), and both app envs must
#        carry the same origin (the panel answers ONE host name, its ORIGIN's).
#        Anything else deletes the file FIRST and then refuses the render: a
#        half-configured opt-in must never leave a router behind. Traefik also
#        closes the host when the CA file is unusable (measured), so this is
#        two independent refusals, not one.
#    The template is infra/host/templates/edge/control-panel.yml.tmpl.
CONTROL_PANEL_FILE="control-panel.yml"
CONTROL_PANEL_CA="mtls/operator-ca.pem"

CONTROL_PANEL_OVERLAY="docker-compose.control-public.yml"

# The key and the app envs are one decision. Turned off in state.env alone, a colour
# would keep the public ORIGIN (a panel that refuses the loopback origin its tunnel
# uses) and the overlay that puts it on the edge network, with no router in front.
# Turned on in state.env alone, the panel would answer the wrong host. Either
# disagreement is refused, with the router file removed first.
control_panel_env_agreement() {   # <want origin, empty when the install has not opted in> <router file to remove on refusal>
    local want="$1" out="$2" colour envf got
    for colour in blue green; do
        envf="$(gremion_root)/etc/env/app-${colour}.env"
        if [[ ! -f "$envf" ]]; then continue; fi
        got="$(control_panel_origin_of "$envf")"
        if [[ "$got" != "$want" ]]; then
            rm -f -- "$out"
            if [[ -z "$want" ]]; then
                die "${envf}: CONTROL_PANEL_ORIGIN is set but state.env has none: the install has not opted in to the public control panel, so remove the line from both app envs (and the ${CONTROL_PANEL_OVERLAY} entry of their COMPOSE_FILE), or set it in state.env too; no control router was rendered" 2
            fi
            die "${envf}: CONTROL_PANEL_ORIGIN is not ${want} (the panel answers one host name, so state.env and both app envs must agree); no control router was rendered" 2
        fi
        if compose_file_names "$envf" | grep -qxF "$CONTROL_PANEL_OVERLAY"; then
            if [[ -z "$want" ]]; then
                rm -f -- "$out"
                die "${envf}: COMPOSE_FILE names ${CONTROL_PANEL_OVERLAY} but the install has not opted in (no CONTROL_PANEL_ORIGIN in state.env): the control panel would sit on the edge network with no router in front; remove the entry, or opt in; no control router was rendered" 2
            fi
        elif [[ -n "$want" ]]; then
            rm -f -- "$out"
            die "${envf}: COMPOSE_FILE does not name ${CONTROL_PANEL_OVERLAY}: the control panel would not be on the edge network, and Traefik could not reach it (add it after docker-compose.app.yml in both app envs, then redeploy); no control router was rendered" 2
        fi
    done
}

render_control_panel_edge() {
    local edge out ca tpl want problem n host=""
    edge="$(gremion_root)/etc/edge"
    out="${edge}/${CONTROL_PANEL_FILE}"
    ca="${edge}/${CONTROL_PANEL_CA}"
    # A host name that is set must be a valid one whether or not the install has
    # opted in yet: a typo found at the opt-in is a typo found late.
    if [[ -n "${CONTROL_PANEL_HOST:-}" ]] && ! host="$(resolve_control_panel_host)"; then
        rm -f -- "$out"
        die "${host}; no control router was rendered" 2
    fi
    if [[ -z "${CONTROL_PANEL_ORIGIN:-}" ]]; then
        control_panel_env_agreement "" "$out"
        rm -f -- "$out"
        info "control panel: not public (CONTROL_PANEL_ORIGIN is empty); no router, reachable through gremion-tenant panel only"
        return 0
    fi
    # Every refusal below removes the file FIRST, then refuses. A live router is
    # otherwise left alone and rewritten atomically: the control host must not
    # drop out of the edge on every deploy.
    if [[ -z "${PLATFORM_DOMAIN:-}" ]]; then rm -f -- "$out"; die "missing env key PLATFORM_DOMAIN" 2; fi
    if ! host="$(resolve_control_panel_host)"; then rm -f -- "$out"; die "${host}; no control router was rendered" 2; fi
    want="https://${host}"
    if [[ "$CONTROL_PANEL_ORIGIN" != "$want" ]]; then
        rm -f -- "$out"
        die "CONTROL_PANEL_ORIGIN must be empty (off) or exactly ${want} (the control host is ${host}: CONTROL_PANEL_HOST in state.env, else control.<PLATFORM_DOMAIN>); any other value is refused and no control router was rendered" 2
    fi
    # The template's one host token. Set here, after every refusal, from the one resolved value.
    # shellcheck disable=SC2034
    CONTROL_HOST="$host"
    if [[ -z "${TRAEFIK_CERT_RESOLVER:-}" ]]; then
        rm -f -- "$out"
        die "CONTROL_PANEL_ORIGIN is set but TRAEFIK_CERT_RESOLVER is empty: the control host needs a public certificate; no control router was rendered" 2
    fi
    control_panel_env_agreement "$want" "$out"
    if [[ -d "$ca" || ! -f "$ca" || ! -s "$ca" ]]; then
        rm -f -- "$out"
        die "the operator CA certificate is missing: ${ca} (gremion-operator-ca install); CONTROL_PANEL_ORIGIN is set, so the render is refused and no control router was rendered" 2
    fi
    if grep -q 'PRIVATE KEY' "$ca"; then
        rm -f -- "$out"
        die "${ca} contains a private key: the host holds the CA CERTIFICATE only. Remove the key from this host, treat it as compromised, and rotate the CA; no control router was rendered" 2
    fi
    if ! problem="$(ca_bundle_problem "$ca")"; then
        rm -f -- "$out"
        die "${ca} ${problem}; no control router was rendered" 2
    fi
    n="$(grep -c 'BEGIN CERTIFICATE' "$ca" || true)"
    tpl="${RELEASE_DIR}/infra/host/templates/edge/control-panel.yml.tmpl"
    if [[ ! -f "$tpl" ]]; then rm -f -- "$out"; die "release tree has no ${tpl}" 2; fi
    # --defer-control-panel (gremion-deploy, step 4): every refusal above has run, and
    # the router is rendered by step 10, after the switch, never here. A file an
    # earlier deploy left stays (it is rewritten atomically by step 10), a missing
    # one stays missing; gremion-verify --control-after-switch (step 9) accepts
    # exactly that state.
    if [[ "$DEFER_CONTROL" -eq 1 ]]; then
        info "control panel: opt-in checked; the router is written after the switch (gremion-render --control-panel-only)"
        return 0
    fi
    # ORDER. The router names the service `panel@file`, which only active.yml
    # defines, and only after a switch with a template that has it. A router whose
    # service does not exist is reported disabled, and gremion-verify fails any
    # disabled router. So with no panel service in the edge yet (step 4 of the
    # first opted-in deploy, before its switch) the router is DEFERRED, not
    # rendered: gremion-deploy renders it again right after the switch
    # (--control-panel-only), and the router is never earlier than its service.
    if ! grep -qE '^    panel:[[:space:]]*$' "${edge}/active.yml" 2>/dev/null; then
        rm -f -- "$out"
        info "control panel: opted in and the CA is in place, but etc/edge/active.yml does not define the panel service yet: the router is deferred until after the switch: gremion-deploy does it at step 10 and gremion-switch does it on a host built by hand (if that said it could not: gremion-render --release DIR --control-panel-only)"
        return 0
    fi
    mkdir -p "$edge"
    render_template "$tpl" "$out"
    info "control panel: public at ${want} behind the operator CA (${n} certificate(s) in ${CONTROL_PANEL_CA})"
}

# 6. The env file of the state project's `legal` service (kernel #84).
#    docker-compose.yml gives it `env_file: legal/legal.env`, resolved in the
#    release tree for EVERY compose verb, so a release tree without the file
#    cannot be pulled, resolved or started. The values (the council's imprint
#    and data-protection contact) belong to the host, not to a release: they
#    live ONCE in etc/legal.env, the way the Keycloak CA lives in
#    etc/secrets/keycloak, and every release tree is given a copy.
#
#    Precedent: the env files of gremion-init-secrets. The keys come from a
#    template (here the release's own legal/legal.env.example), the keys only
#    the operator knows carry a CHANGE_ME_OPERATOR_ sentinel, and load_env
#    refuses a file that still holds one. A key left at the example's
#    placeholder value is refused as well, because the example ships readable
#    values, not sentinels (dev and k8s copy it as it is). Messages name keys,
#    never values.
LEGAL_PLACEHOLDER_KEYS=(ORG_NAME ORG_ADDRESS ORG_EMAIL RESPONSIBLE_PERSON RESPONSIBLE_PERSON_EMAIL DOMAIN)

# legal_example_value <example> <key> -> the example's value for the key.
legal_example_value() {
    local line
    line="$(tr -d '\r' < "$1" | grep -E "^${2}=" | head -n 1 || true)"
    printf '%s' "${line#*=}"
}

# seed_legal_env <example> <host file> — write the host file from the example:
# operator keys as sentinels, DOMAIN from the platform domain, YEAR from today,
# everything else (retention periods, accessibility statement) as the example
# has it. The example's leading comment block (up to its first blank line) is
# replaced by this program's own header.
seed_legal_env() {
    local example="$1" host_file="$2" line key in_header=1
    if [[ -z "${PLATFORM_DOMAIN:-}" ]]; then die "missing env key PLATFORM_DOMAIN" 2; fi
    {
        echo "# Gremion legal pages (imprint, privacy notice, accessibility statement)."
        echo "# Created by gremion-render from legal/legal.env.example. Every release tree's"
        echo "# legal/legal.env is a copy of this file. Replace each CHANGE_ME_OPERATOR_ value."
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line%$'\r'}"
            if [[ "$in_header" -eq 1 ]]; then
                if [[ -z "$line" ]]; then in_header=0; printf '\n'; fi
                continue
            fi
            case "$line" in
                ORG_NAME=*|ORG_ADDRESS=*|ORG_EMAIL=*|RESPONSIBLE_PERSON=*|RESPONSIBLE_PERSON_EMAIL=*)
                    key="${line%%=*}"
                    printf '%s=CHANGE_ME_OPERATOR_%s\n' "$key" "$key" ;;
                DOMAIN=*) printf 'DOMAIN=%s\n' "$PLATFORM_DOMAIN" ;;
                YEAR=*)   printf 'YEAR=%s\n' "$(date -u +%Y)" ;;
                *)        printf '%s\n' "$line" ;;
            esac
        done < "$example"
    } | atomic_write "$host_file" 0600 || die "cannot write ${host_file}"
}

# check_legal_env <example> <host file> — fit to be copied into a release tree?
check_legal_env() {
    local example="$1" host_file="$2" k
    for k in $(tr -d '\r' < "$example" | grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' | tr -d '='); do
        if ! grep -q "^${k}=" "$host_file"; then
            die "legal env ${host_file} is missing key ${k} (declared by legal/legal.env.example)" 2
        fi
    done
    # A subshell: load_env exports every key and exits on a refusal (duplicate,
    # malformed line, CHANGE_ME_ sentinel); neither may reach this program.
    (
        load_env "$host_file"
        local val ph
        for k in "${LEGAL_PLACEHOLDER_KEYS[@]}"; do
            val="${!k:-}"
            if [[ -z "${val//[[:space:]]/}" ]]; then
                bad "legal env ${k} is empty in ${host_file}"
                exit "$GREMION_EXIT_USAGE"
            fi
            ph="$(legal_example_value "$example" "$k")"
            if [[ "$val" == "$ph" ]]; then
                bad "legal env ${k} still holds the placeholder of legal/legal.env.example in ${host_file} (value not shown)"
                exit "$GREMION_EXIT_USAGE"
            fi
        done
    ) || exit "$GREMION_EXIT_USAGE"
}

legal_example_path() {
    local example="${RELEASE_DIR}/legal/legal.env.example"
    if [[ ! -f "$example" ]]; then die "release tree has no legal/legal.env.example: $example" 2; fi
    printf '%s\n' "$example"
}

render_legal_env() {
    local example host_file out
    example="$(legal_example_path)"
    host_file="$(gremion_root)/etc/legal.env"
    if [[ ! -f "$host_file" ]]; then
        seed_legal_env "$example" "$host_file"
        die "legal env file absent: created ${host_file} from legal/legal.env.example with CHANGE_ME_OPERATOR_ placeholders; fill every one (grep -n CHANGE_ME_OPERATOR_ ${host_file}) and render again" 2
    fi
    check_legal_env "$example" "$host_file"
    out="${RELEASE_DIR}/legal/legal.env"
    atomic_write "$out" 0600 < "$host_file" || die "cannot write ${out}"
    assert_rendered "$out"
    if ! cmp -s "$host_file" "$out"; then
        die "legal.env is not a copy of ${host_file}: $out"
    fi
}

# --init-legal-env: create the host file if it is absent and say how much is
# left, like gremion-init-secrets' INIT-SECRETS line. Never an error for
# unfilled keys: that is what the following steps are for.
init_legal_env() {
    local example host_file n
    example="$(legal_example_path)"
    host_file="$(gremion_root)/etc/legal.env"
    if [[ -f "$host_file" ]]; then
        info "kept the existing ${host_file}"
    else
        seed_legal_env "$example" "$host_file"
        ok "created ${host_file}"
    fi
    n="$(grep -c '^[A-Za-z_][A-Za-z0-9_]*=CHANGE_ME_OPERATOR_' "$host_file" || true)"
    printf 'LEGAL-ENV: file=%s unfilled=%s\n' "$host_file" "$n"
}

main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --release)
                if [[ $# -lt 2 ]]; then die "--release needs a directory" 2; fi
                RELEASE_DIR="$2"; shift 2 ;;
            --staging) STAGING=1; shift ;;
            --legal-env-only) LEGAL_ONLY=1; shift ;;
            --control-panel-only) CONTROL_ONLY=1; shift ;;
            --defer-control-panel) DEFER_CONTROL=1; shift ;;
            --init-legal-env) INIT_LEGAL=1; shift ;;
            -h|--help) usage; exit 0 ;;
            *) usage >&2; die "unknown argument: $1" 2 ;;
        esac
    done
    if [[ $((LEGAL_ONLY + INIT_LEGAL + STAGING + CONTROL_ONLY)) -gt 1 ]]; then
        die "--staging, --legal-env-only, --init-legal-env and --control-panel-only cannot be combined" 2
    fi
    if [[ "$DEFER_CONTROL" -eq 1 && "$CONTROL_ONLY" -eq 1 ]]; then
        die "--defer-control-panel and --control-panel-only cannot be combined: one skips what the other renders" 2
    fi

    # A group NAME would be resolved against the host's /etc/group, not the
    # container's gids, and could quietly name the wrong group.
    if [[ ! "$PGBOUNCER_GID" =~ ^[0-9]+$ ]]; then
        die "GREMION_PGBOUNCER_GID must be a numeric gid, got: ${PGBOUNCER_GID}" 2
    fi

    if [[ -z "$RELEASE_DIR" ]]; then RELEASE_DIR="$(gremion_root)/current"; fi
    if [[ ! -d "$RELEASE_DIR" ]]; then die "release tree not found: $RELEASE_DIR" 2; fi
    if [[ ! -d "${RELEASE_DIR}/docker" ]]; then
        die "release tree has no docker/ directory: ${RELEASE_DIR}/docker" 2
    fi

    local env_file staging_word
    env_file="$(gremion_root)/etc/env/state.env"
    if [[ ! -f "$env_file" ]]; then die "state env file not found: $env_file" 2; fi
    load_env "$env_file"

    if [[ "$INIT_LEGAL" -eq 1 ]]; then
        init_legal_env
        exit 0
    fi
    if [[ "$LEGAL_ONLY" -eq 1 ]]; then
        render_legal_env
        printf 'RENDER: outputs=%d release=%s staging=no legal-env-only=yes\n' "$OUTPUTS" "$RELEASE_DIR"
        exit 0
    fi
    need_cmd openssl

    if [[ "$CONTROL_ONLY" -eq 1 ]]; then
        render_control_panel_edge
        printf 'RENDER: outputs=%d release=%s staging=no control-panel-only=yes\n' "$OUTPUTS" "$RELEASE_DIR"
        exit 0
    fi
    render_pgbouncer_userlist
    render_keycloak_certs
    ensure_ipcrypt_key
    derive_livekit_relay
    render_release_templates
    render_legal_env
    render_control_panel_edge
    if [[ "$STAGING" -eq 1 ]]; then
        render_staging_extra_hosts
    fi

    staging_word=no
    if [[ "$STAGING" -eq 1 ]]; then staging_word=yes; fi
    printf 'RENDER: outputs=%d release=%s staging=%s\n' \
        "$OUTPUTS" "$RELEASE_DIR" "$staging_word"
}

main "$@"
