#!/usr/bin/env bash
set -euo pipefail
#
# gremion-validate-env — is this rendered env file fit to run its project?
#
#   gremion-validate-env --env-file FILE [--release DIR] [--template FILE]
#
# Spec B section 6 (B-08): load_env in lib/common.sh is THE single env reader,
# and this program adds only what load_env lacks. It never reads a VALUE from
# the file itself: every value it judges was exported by load_env; the file is
# grepped only for key NAMES (presence).
#
#   1. the file exists             -- absent: exit 2, "run setup first" (TRD-099).
#                                     An absent file is a host not yet set up,
#                                     not a failed validation.
#   2. load_env accepts it         -- duplicates, malformed lines, CHANGE_ME_
#                                     sentinels, empty template-marked secrets:
#                                     load_env's own refusal, exit 2.
#   3. compose-file fitness        -- COMPOSE_FILE is set and every entry
#                                     (split on COMPOSE_PATH_SEPARATOR, default
#                                     ':') exists under the release tree: exit 1.
#   3b. template key parity        -- every key the template declares is
#                                     declared; every operator key
#                                     (CHANGE_ME_OPERATOR_*) is non-blank: exit 1.
#   4. alias equality              -- keys whose template values share one
#                                     generated sentinel group hold one value;
#                                     a value that EMBEDS a group (the reader
#                                     password in GREMION_PUBLIC_DB_URL) contains
#                                     it: exit 1.
#
# Alias equality is judged WITHIN one file. A pair split across files (e.g.
# app-blue.env's AUTH_KEYCLOAK_SECRET against state.env's
# GREMION_UI_OIDC_CLIENT_SECRET) is gremion-init-secrets' construction and is
# not re-checked here.
#
# NO VALUE IS EVER PRINTED. Findings name keys, sentinel groups and compose
# file names -- never what a key holds.
#
# --release defaults to <gremion root>/current, the tree gremion-deploy runs
# compose from. mail.env and ops.env name compose files in their own project
# directories; pass that directory as --release for them.
#
# StuRaOS scripts/validate-env.sh is deliberately NOT ported (its first-
# occurrence reads are the #476 defect).
#
# EXIT CODES: 0 ok - 1 post-condition failed - 2 usage/precondition.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

__gve_env_file=""
__gve_release=""
__gve_template=""

usage() {
    cat >&2 <<'EOF'
usage: gremion-validate-env --env-file FILE [--release DIR] [--template FILE]

  --env-file FILE   the rendered env file to validate (e.g. etc/env/state.env)
  --release DIR     where COMPOSE_FILE's entries live (default: <root>/current)
  --template FILE   the template FILE was rendered from (default: derived from
                    the file name: state, app-blue/app-green, mail, ops)
EOF
}

need_value() {
    [[ "$2" -ge 2 ]] || { usage; die "${1} requires a value" "$GREMION_EXIT_USAGE"; }
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --env-file) need_value --env-file "$#"; __gve_env_file="$2"; shift 2 ;;
            --release)  need_value --release  "$#"; __gve_release="$2"; shift 2 ;;
            --template) need_value --template "$#"; __gve_template="$2"; shift 2 ;;
            -h|--help)  usage; exit "$GREMION_EXIT_OK" ;;
            *) usage; die "unknown argument: $1" "$GREMION_EXIT_USAGE" ;;
        esac
    done
    [[ -n "$__gve_env_file" ]] || { usage; die "--env-file is required" "$GREMION_EXIT_USAGE"; }
    [[ -n "$__gve_release" ]] || __gve_release="$(gremion_root)/current"
}

# The setup-first answer, BEFORE anything reads or renders (TRD-099).
require_present() {
    if [[ ! -e "$__gve_env_file" ]]; then
        bad "gremion-validate-env: no env file at ${__gve_env_file} -- this host is not set up yet; run setup first (gremion-init-secrets renders etc/env/*.env). Nothing was validated."
        exit "$GREMION_EXIT_USAGE"
    fi
}

resolve_template() {
    [[ -n "$__gve_template" ]] || __gve_template="$(env_template_for "$__gve_env_file")"
    [[ -n "$__gve_template" ]] \
        || die "cannot tell which template ${__gve_env_file} was rendered from; pass --template" \
            "$GREMION_EXIT_USAGE"
    [[ -f "$__gve_template" ]] || die "template not found: ${__gve_template}" "$GREMION_EXIT_USAGE"
}

__gve_failures=0
fail() { bad "$1"; __gve_failures=$((__gve_failures + 1)); }

check_compose_files() {
    [[ -d "$__gve_release" ]] || die "release tree not found: ${__gve_release}" "$GREMION_EXIT_USAGE"
    if [[ -z "${COMPOSE_FILE:-}" ]]; then
        fail "COMPOSE_FILE is not set: the env file does not name its composition (N20)"
        return 0
    fi
    local sep="${COMPOSE_PATH_SEPARATOR:-:}" entry path absent=0 n=0
    local -a entries=()
    IFS="$sep" read -r -a entries <<< "$COMPOSE_FILE"
    for entry in "${entries[@]}"; do
        [[ -n "$entry" ]] || { fail "COMPOSE_FILE has an empty entry"; absent=1; continue; }
        n=$((n + 1))
        if [[ "$entry" == /* ]]; then path="$entry"; else path="${__gve_release}/${entry}"; fi
        if [[ ! -f "$path" ]]; then
            fail "COMPOSE_FILE names ${entry}, which is not a file under ${__gve_release}"
            absent=1
        fi
    done
    [[ "$absent" -eq 1 ]] || ok "COMPOSE_FILE: all ${n} compose file(s) present under ${__gve_release}"
}

# Alias equality, driven by the template: a key whose template value is
# EXACTLY one generated sentinel belongs to that sentinel's group; a key whose
# value merely contains one embeds it.
check_aliases() {
    local -A group_of=() first_of=() embeds=()
    local key tmpl_value group pairs=0
    while IFS='=' read -r key tmpl_value; do
        if [[ "$tmpl_value" =~ ^CHANGE_ME_GEN_(hex32|alnum32)_([a-z0-9_]+)$ ]]; then
            group="${BASH_REMATCH[2]}"
            group_of["$key"]="$group"
            [[ -n "${first_of[$group]:-}" ]] || first_of["$group"]="$key"
        elif [[ "$tmpl_value" =~ CHANGE_ME_GEN_(hex32|alnum32)_([a-z0-9_]+) ]]; then
            embeds["$key"]="${BASH_REMATCH[2]}"
        fi
    done < <(grep -E '^[A-Za-z_][A-Za-z0-9_]*=.*CHANGE_ME_GEN_' "$__gve_template")

    # Every template-marked key must be DECLARED: load_env refuses an empty
    # one, but a key missing altogether would compare equal to its missing
    # alias and pass. Presence is read from the file (key names only).
    local before="$__gve_failures"
    for key in $(printf '%s\n' "${!group_of[@]}" "${!embeds[@]}" | sort -u); do
        grep -q "^${key}=" "$__gve_env_file" \
            || fail "${key} is missing: $(basename "$__gve_template") declares it as a generated secret"
    done

    local ref
    for key in $(printf '%s\n' "${!group_of[@]}" | sort); do
        group="${group_of[$key]}"
        ref="${first_of[$group]}"
        [[ "$key" != "$ref" ]] || continue
        pairs=$((pairs + 1))
        if [[ "${!key-}" != "${!ref-}" ]]; then
            fail "alias drift: ${ref} and ${key} share the generated group '${group}' but hold different values"
        fi
    done
    for key in $(printf '%s\n' "${!embeds[@]}" | sort); do
        group="${embeds[$key]}"
        ref="${first_of[$group]:-}"
        [[ -n "$ref" ]] || continue
        pairs=$((pairs + 1))
        if [[ -z "${!ref-}" || "${!key-}" != *"${!ref}"* ]]; then
            fail "alias drift: ${key} must embed the value of ${ref} (generated group '${group}'), and does not"
        fi
    done
    [[ "$__gve_failures" -gt "$before" ]] || ok "alias equality: ${pairs} aliased key(s) agree"
}

# Every key the template declares must be declared by the file, and every
# key the operator fills in (template value CHANGE_ME_OPERATOR_*) must hold
# something other than blanks. Key PRESENCE is read from the file by name; no
# value is read from it here (load_env already exported them).
check_template_keys() {
    local before="$__gve_failures" key tmpl_value n=0 val
    while IFS='=' read -r key tmpl_value; do
        n=$((n + 1))
        if ! grep -q "^${key}=" "$__gve_env_file"; then
            fail "${key} is missing: $(basename "$__gve_template") declares it"
            continue
        fi
        if [[ "$tmpl_value" == CHANGE_ME_OPERATOR_* ]]; then
            val="${!key-}"
            [[ -n "${val//[[:space:]]/}" ]] || fail "${key} is empty: the operator must fill it in"
        fi
    done < <(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$__gve_template")
    # The truncating-harness contract (AM-B-05): `none` or a stack name.
    if grep -q '^GREMION_PRODUCTION_STACK=' "$__gve_template" \
        && [[ "${GREMION_PRODUCTION_STACK-}" != none \
              && ! "${GREMION_PRODUCTION_STACK-}" =~ ^[a-z][a-z0-9-]{0,31}$ ]]; then
        fail "GREMION_PRODUCTION_STACK is neither 'none' nor a stack name (^[a-z][a-z0-9-]{0,31}\$)"
    fi
    [[ "$__gve_failures" -gt "$before" ]] || ok "template keys: all ${n} declared, operator keys filled"
}

main() {
    parse_args "$@"
    need_cmd grep sed
    require_present
    resolve_template
    # load_env exports EVERY key of the file into this shell. The validator's
    # own state lives under the reserved __gve_ prefix, read-only from here on,
    # and a file that declares a key under that prefix is refused -- otherwise
    # `TEMPLATE=/dev/null` (or the like) in the file under judgement would
    # switch the judgement off. The caller's COMPOSE_FILE/COMPOSE_PATH_SEPARATOR
    # are dropped for the same reason: only the FILE's values count.
    readonly __gve_env_file __gve_release __gve_template
    if grep -qE '^__gve_' "$__gve_env_file"; then
        die "$(basename "$__gve_env_file") declares a key under the reserved __gve_ prefix" "$GREMION_EXIT_USAGE"
    fi
    unset COMPOSE_FILE COMPOSE_PATH_SEPARATOR ALLOW_SENTINELS
    # load_env refuses (exit 2) on its own; reaching the next line means the
    # file is structurally sound, complete, and every secret is non-empty.
    load_env "$__gve_env_file" "$__gve_template"
    ok "load_env accepts $(basename "$__gve_env_file") (template $(basename "$__gve_template"))"
    check_template_keys
    check_compose_files
    check_aliases
    if [[ "$__gve_failures" -gt 0 ]]; then
        die "VALIDATE-ENV: ${__gve_failures} problem(s) in $(basename "$__gve_env_file")" "$GREMION_EXIT_ASSERT"
    fi
    printf 'VALIDATE-ENV: ok %s\n' "$(basename "$__gve_env_file")"
}

main "$@"
