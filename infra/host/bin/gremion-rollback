#!/usr/bin/env bash
#
# gremion-rollback — spec A §F.5, the two rollback classes.
#
#   (a) the previous colour is still up and still holds the target tag:
#       gremion-switch back to it. Seconds, no data loss.
#   (b) it is gone (an overlap:false release stopped it, or the soak ended):
#       gremion-deploy <target> --no-switch, then switch. Its duration is the
#       measured redeploy time, and the migrations of the tag being left are NOT
#       reverted.
#
# USAGE
#   gremion-rollback [--to-tag dist-vX.Y.Z] [--soak-minutes N]
#
# stdin is passed through UNTOUCHED to gremion-deploy, so a class (b) rollback
# is driven as:  printf 'TOKEN %s\n' "$GHCR_TOKEN" | gremion-rollback
# Class (a) needs no token and reads no stdin.
#
# PRE-MIGRATION DUMPS (TASK-075, TRD-206, TRD §6 [D R18-4]). gremion-deploy
# step 5 takes ONE dump of each database a release's migrations alter
# (gremion-migration-dump preflight) and deletes it once that release's switch
# has succeeded (`switched`, after step 11). So:
#   - after a SUCCEEDED switch no dump exists: this program says so (NO-DUMP)
#     and does not pretend a restore point exists;
#   - a LIVE dump means a release stopped before its switch succeeded, or its
#     step 12b deletion failed after the switch (DUMP-NOT-DELETED). A class
#     (b) redeploy would be refused by the next preflight anyway (never a
#     series), so it is refused HERE first, exit 3, naming the operator's
#     three commands: status, restore (--accept-loss-since), discard (--reason).
# There is no restic class=snapshot any more; docs/ops/host-tooling.md.
#
# EXIT CODES  0 ok · 1 assertion failed · 2 usage/precondition · 3 blocked
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

TO_TAG=""
SOAK_MINUTES_OPT=""
ROOT=""

usage() {
    cat >&2 <<'EOF'
usage: gremion-rollback [--to-tag dist-vX.Y.Z] [--soak-minutes N]
       class (b) needs the GHCR token on stdin: printf 'TOKEN <value>\n' | gremion-rollback
EOF
    exit 2
}

# Every caller captures this into a variable BEFORE invoking the program it
# names. Used inline as `"$(bin_path x)" arg`, its `die` runs in a command
# substitution and can only end that subshell: the program would then try to
# execute `arg` and exit 127 instead of the documented 2.
bin_path() {
    local n="$1" p
    p="${GREMION_BIN_DIR:-$(gremion_root)/bin}/$n"
    if [[ -x "$p" ]]; then printf '%s' "$p"; return 0; fi
    p="$(command -v "$n" 2>/dev/null || true)"
    [[ -n "$p" ]] || die "required program not found: $n" 2
    printf '%s' "$p"
}

read_runtime() { # <file> <default>
    local f="$ROOT/runtime/$1"
    if [[ -f "$f" ]]; then tr -d '[:space:]' < "$f"; else printf '%s' "$2"; fi
}

colour_is_up() { # <colour>
    local colour="$1" out
    out="$(docker compose --env-file "$ROOT/etc/env/app-${colour}.env" ps -q 2>/dev/null || true)"
    [[ -n "$out" ]]
}

assert_switched() { # <colour>
    local now
    now="$(read_runtime active-colour none)"
    [[ "$now" == "$1" ]] || die "runtime/active-colour is '${now}' after switching to $1" 1
}

record_tags() { # <from> <to>
    printf '%s\n' "$1" | atomic_write "$ROOT/runtime/previous-tag" 644
    printf '%s\n' "$2" | atomic_write "$ROOT/runtime/current-tag" 644
    local dir="$ROOT/releases/$2"
    if [[ -d "$dir" ]]; then
        ln -sfn "$dir" "$ROOT/current.tmp"
        mv -Tf "$ROOT/current.tmp" "$ROOT/current"
        [[ "$(readlink "$ROOT/current")" == "$dir" ]] \
            || die "current symlink does not point at $dir" 1
    fi
}

release_migration_count() { # <tag> → the number of migrations that tag applied
    local rel="$ROOT/releases/$1/release.json" n
    if [[ ! -f "$rel" ]]; then printf '%s' "unknown"; return 0; fi
    n="$(jq -r '(.migrations // []) | length' "$rel" 2>/dev/null || printf unknown)"
    [[ "$n" =~ ^[0-9]+$ ]] || n=unknown
    printf '%s' "$n"
}

# live_dump_status [<release>] → gremion-migration-dump status output. A status
# that cannot be read is a refusal, never "no dump".
live_dump_status() {
    local prog out
    prog="$(bin_path gremion-migration-dump)"
    if [[ $# -ge 1 ]]; then
        out="$("$prog" status --release "$1")" || die "gremion-migration-dump status failed — cannot tell whether a pre-migration dump is live" 1
    else
        out="$("$prog" status)" || die "gremion-migration-dump status failed — cannot tell whether a pre-migration dump is live" 1
    fi
    printf '%s\n' "$out"
}

live_dump_count() { # <status output> → N from "STATUS: N live dump(s)"
    local n
    n="$(sed -nE 's/^STATUS: ([0-9]+) live dump\(s\)$/\1/p' <<< "$1")"
    [[ "$n" =~ ^[0-9]+$ ]] || die "gremion-migration-dump status printed no STATUS line" 1
    printf '%s' "$n"
}

# Class (b) with a live dump: the redeploy's preflight would refuse (never a
# series). The operator decides first; nothing has been touched yet.
refuse_live_dump() {
    local out n
    out="$(live_dump_status)"
    n="$(live_dump_count "$out")"
    [[ "$n" -gt 0 ]] || return 0
    printf '%s\n' "$out" | grep '^LIVE ' >&2 || true
    printf 'BLOCKED: %s live pre-migration dump(s) — a release stopped before its switch succeeded, or its post-switch deletion failed (DUMP-NOT-DELETED). Decide first:\n' "$n" >&2
    printf '  gremion-migration-dump status\n' >&2
    printf '  gremion-migration-dump restore --release <R> --db <D> --accept-loss-since <time>\n' >&2
    printf '  gremion-migration-dump discard --release <R> --reason <text>\n' >&2
    exit 3
}

# The migrations of the tag we are LEAVING are not reverted by a redeploy.
warn_unreverted_migrations() { # <from tag>
    local n
    n="$(release_migration_count "$1")"
    if [[ "$n" == "unknown" ]]; then
        printf 'MIGRATIONS-NOT-REVERTED: %s release.json is gone; assume its migrations are applied.\n' "$1"
        return 0
    fi
    [[ "$n" -gt 0 ]] || return 0
    printf 'MIGRATIONS-NOT-REVERTED: %s applied %s migration(s) that this rollback does not revert (expand/contract: the older release survives them, TRD-361).\n' "$1" "$n"
}

# resolve_dump_fate <abandoned tag> — see the header. Never silent.
resolve_dump_fate() {
    local tag="$1" out n
    out="$(live_dump_status "$tag")"
    n="$(live_dump_count "$out")"
    if [[ "$n" -eq 0 ]]; then
        printf 'NO-DUMP: no pre-migration dump of %s exists — it was deleted when its switch succeeded (TRD-206, TRD §6 R18-4); there is no restore point to its pre-migration state.\n' "$tag"
        return 0
    fi
    printf 'DUMP-LIVE: %s live pre-migration dump(s) of %s:\n' "$n" "$tag"
    printf '%s\n' "$out" | grep '^LIVE ' || true
    printf '  gremion-migration-dump restore --release %s --db <D> --accept-loss-since <time>, then discard --release %s --reason <text>\n' "$tag" "$tag"
}

rollback_class_a() { # <colour>
    local prog; prog="$(bin_path gremion-switch)"
    "$prog" "$1"
    assert_switched "$1"
    ok "switched back to ${1} (class a)"
}

rollback_class_b() { # <colour> <target tag>
    local prog rc=0
    prog="$(bin_path gremion-deploy)"
    # `|| rc=$?` rather than toggling `set +e`/`set -e` around the call: the
    # shell option stays on for everything else in this function.
    "$prog" "$2" --no-switch --soak-minutes "${SOAK_MINUTES_OPT:-0}" || rc=$?
    if [[ "$rc" -eq 2 ]]; then
        die "class (b) rollback needs the registry token on stdin: printf 'TOKEN <value>\\n' | gremion-rollback --to-tag $2" 2
    fi
    [[ "$rc" -eq 0 ]] || exit "$rc"
    prog="$(bin_path gremion-switch)"
    "$prog" "$1"
    assert_switched "$1"
    ok "redeployed ${2} into ${1} and switched (class b)"
}

main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            # See gremion-deploy's parser: the arity is checked before the
            # shift, and the message names the option, because
            # `X="${2:-}"; shift 2` exits 1 silently on a dangling final option.
            --to-tag)       [[ $# -ge 2 ]] || die "option $1 needs a value" 2
                            TO_TAG="$2"; shift 2 ;;
            --soak-minutes) [[ $# -ge 2 ]] || die "option $1 needs a value" 2
                            SOAK_MINUTES_OPT="$2"; shift 2 ;;
            -h|--help)      usage ;;
            *)              printf 'unexpected argument: %s\n' "$1" >&2; usage ;;
        esac
    done

    need_cmd docker jq
    ROOT="$(gremion_root)"
    [[ -d "$ROOT" ]] || die "gremion root absent: $ROOT" 2
    load_env "$ROOT/etc/env/state.env"

    local active other from_tag to_tag class
    active="$(read_runtime active-colour none)"
    # The colour we roll back INTO is the one that is not serving; this case also
    # validates what runtime/active-colour holds.
    case "$active" in
        blue)  other=green ;;
        green) other=blue ;;
        *)     die "no active colour to roll back from (runtime/active-colour='${active}')" 2 ;;
    esac

    from_tag="$(read_runtime current-tag none)"
    [[ "$from_tag" != "none" ]] || die "no current tag recorded — nothing to roll back from" 2
    to_tag="$TO_TAG"
    if [[ -z "$to_tag" ]]; then
        to_tag="$(read_runtime previous-tag none)"
        [[ "$to_tag" != "none" ]] || die "no previous tag recorded and no --to-tag given" 2
    fi
    [[ "$to_tag" =~ ^dist-v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "invalid tag: $to_tag" 2
    [[ "$to_tag" != "$from_tag" ]] || die "already running $to_tag" 2

    if [[ "$(read_runtime "colour-${other}-tag" none)" == "$to_tag" ]] && colour_is_up "$other"; then
        class=a
        info "class (a): ${other} still runs ${to_tag}"
        rollback_class_a "$other"
    else
        class=b
        info "class (b): ${other} does not hold ${to_tag} — redeploying it"
        refuse_live_dump
        rollback_class_b "$other" "$to_tag"
        warn_unreverted_migrations "$from_tag"
    fi

    record_tags "$from_tag" "$to_tag"
    resolve_dump_fate "$from_tag"
    printf 'ROLLBACK-RESULT: class=%s from=%s to=%s colour=%s\n' \
        "$class" "$from_tag" "$to_tag" "$other"
}

main "$@"
