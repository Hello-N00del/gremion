#!/usr/bin/env bash
set -euo pipefail
#
# gremion-init-secrets — render /opt/gremion/etc/env/*.env from the templates.
#
#   gremion-init-secrets [--root DIR] [--stack NAME] [--force] [--host-build]
#
# Renders five files, one per compose project (N20):
#   state.env  app-blue.env  app-green.env  mail.env  ops.env
#
# Two things besides the secrets are rendered, in the state and app files only:
#
#   COMPOSE_PROFILES  production plus the compose profiles of every pilot module,
#                     read from infra/host/module-profiles.json (the templates keep
#                     the bare `production`: profile names live in that one file).
#                     The post-realm profile (messaging) is NOT rendered here:
#                     `gremion-services wire` adds it once the customer's realm exists.
#   COMPOSE_FILE      with --host-build, WITHOUT the two release pins layers
#                     (docker-compose.state-pins.yml, docker-compose.pins.yml). Those
#                     files are written by the release workflow and are absent from a
#                     git checkout built on the host, where gremion-validate-env
#                     fails an absent COMPOSE_FILE entry.
#
# Every secret is generated here and never leaves the host. Two sentinel shapes
# live in the templates, both matching CHANGE_ME_ so a single grep (and
# load_env's own gate) covers them:
#
#   CHANGE_ME_GEN_hex32_<group>     -> openssl rand -hex 32   (64 hex chars)
#   CHANGE_ME_GEN_alnum32_<group>   -> 32 alphanumeric chars
#   CHANGE_ME_OPERATOR_<name>       -> LEFT IN PLACE, listed on stdout
#
# Every occurrence of one <group>, in any template and anywhere inside a value,
# receives the SAME generated value. That is what keeps the doubly-keyed OIDC
# secrets, the Stalwart API key and the password embedded in
# GREMION_PUBLIC_DB_URL equal without a separate reconciliation step that
# somebody has to remember to run.
#
# EXIT CODES: 0 ok - 1 post-condition failed - 2 usage/precondition - 3 blocked.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

umask 077

TMPL_DIR="${SCRIPT_DIR}/../templates/env"
PROFILES_FILE="${SCRIPT_DIR}/../module-profiles.json"
ROOT=""
STACK_NAME="${STACK:-}"
FORCE=0
HOST_BUILD=0
# The COMPOSE_PROFILES value of the state and app files (compute_profiles).
PROFILES_VALUE=""

usage() {
    cat >&2 <<'EOF'
usage: gremion-init-secrets [--root DIR] [--stack NAME] [--force] [--host-build]

  --root DIR    host root to render into (default: $GREMION_ROOT or /opt/gremion)
  --stack NAME  the ${STACK} value: 'gremion' in production, 'staging' elsewhere.
                REQUIRED unless $STACK is already set. There is no default: a
                silent fallback to the production stack name on a staging box
                would attach that box to production's external resources.
  --force       replace env files that already exist (they hold live secrets)
  --host-build  the images are built on this host from a git checkout: render
                COMPOSE_FILE without the release pins layers, which only a
                release workflow writes
EOF
}

# need_value <flag> <remaining-arg-count>
# A flag that is the LAST argument used to leave its variable empty and then die
# in `shift 2` under set -e: exit 1, no message, no usage. A usage error has to
# look like one, or the operator retypes the same truncated command.
need_value() {
    [[ "$2" -ge 2 ]] || { usage; die "${1} requires a value" "$GREMION_EXIT_USAGE"; }
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --root)  need_value --root  "$#"; ROOT="$2"; shift 2 ;;
            --stack) need_value --stack "$#"; STACK_NAME="$2"; shift 2 ;;
            --force) FORCE=1; shift ;;
            --host-build) HOST_BUILD=1; shift ;;
            -h|--help) usage; exit "$GREMION_EXIT_OK" ;;
            *) usage; die "unknown argument: $1" "$GREMION_EXIT_USAGE" ;;
        esac
    done
    [[ -n "$ROOT" ]] || ROOT="$(gremion_root)"
    if [[ -z "$STACK_NAME" ]]; then
        usage
        die "no stack name: pass --stack NAME or export STACK" "$GREMION_EXIT_USAGE"
    fi
    if [[ ! "$STACK_NAME" =~ ^[a-z][a-z0-9-]{0,31}$ ]]; then
        die "invalid stack name '${STACK_NAME}': expected ^[a-z][a-z0-9-]{0,31}\$" \
            "$GREMION_EXIT_USAGE"
    fi
}

# compute_profiles — PROFILES_VALUE from infra/host/module-profiles.json: `production`
# plus every profile of every pilot module, once each, in a fixed (sorted) order. Refuses,
# BEFORE anything is written, a file that is unreadable, names a profile outside its own
# knownProfiles list or outside the profile-name alphabet, or leaves a pilot module with
# no profile at all (a module that needs nothing is not a pilot module: say so with
# pilot=false and a reason). The post-realm profiles are never rendered here.
compute_profiles() {
    [[ -f "$PROFILES_FILE" ]] || die "module profile map not found: ${PROFILES_FILE}" "$GREMION_EXIT_USAGE"
    jq -e . "$PROFILES_FILE" >/dev/null 2>&1 \
        || die "${PROFILES_FILE} is not valid JSON" "$GREMION_EXIT_USAGE"
    local bad
    bad="$(jq -r '
        (.knownProfiles // []) as $known
        | [.modules | to_entries[] | .key as $id | .value
           | ((.profiles // []) + (.postRealm // []))[]
           | select((. as $p | $known | index($p)) == null) | "\($id): \(.)"] | .[]' "$PROFILES_FILE")" \
        || die "${PROFILES_FILE}: cannot read the module profiles" "$GREMION_EXIT_USAGE"
    [[ -z "$bad" ]] || die "${PROFILES_FILE} names a profile that is not in its knownProfiles list (the compose files define no such profile): $(printf '%s' "$bad" | tr '\n' ' ')" \
        "$GREMION_EXIT_ASSERT"
    bad="$(jq -r '[.modules | to_entries[] | select(.value.pilot == true and (((.value.profiles // []) + (.value.postRealm // [])) | length) == 0) | .key] | .[]' "$PROFILES_FILE")"
    [[ -z "$bad" ]] || die "${PROFILES_FILE}: pilot module(s) with no profile: $(printf '%s' "$bad" | tr '\n' ' ')" \
        "$GREMION_EXIT_ASSERT"
    local list
    list="$(jq -r '[.modules[] | select(.pilot == true) | (.profiles // [])[]] | unique | join(",")' "$PROFILES_FILE")"
    [[ "$list" =~ ^([a-z][a-z0-9-]*(,[a-z][a-z0-9-]*)*)?$ ]] \
        || die "${PROFILES_FILE}: a profile name is outside [a-z][a-z0-9-]*" "$GREMION_EXIT_ASSERT"
    PROFILES_VALUE="production${list:+,${list}}"
}

gen_hex32() { openssl rand -hex 32; }

# 32 alphanumeric characters, the shape scripts/setup.sh generates for
# password-valued secrets. No `| head -c`: under `set -o pipefail` an early
# reader close makes the producer die of SIGPIPE and takes the script with it.
gen_alnum32() {
    local raw out
    raw="$(openssl rand -base64 96 | tr -d '\n')"
    out="$(printf '%s' "$raw" | tr -cd 'A-Za-z0-9')"
    [[ ${#out} -ge 32 ]] || die "openssl produced too few alphanumeric bytes" "$GREMION_EXIT_ASSERT"
    printf '%s' "${out:0:32}"
}

declare -A SENTINEL_KIND=()
declare -A SECRET=()
OUTPUTS=()

# The bash -c '…' body below is deliberately single-quoted: "$1" must stay
# literal here and expand inside the subshell bash -c launches.
#
# etc/edge is chmodded with the rest: it holds the rendered Traefik dynamic
# configuration and the ACME account material, and 0700 on etc/ alone stops
# protecting it the moment a later task adds a service account to the host.
# The loop afterwards asserts the post-condition on EVERY child of etc/, so a
# directory a later task adds to the mkdir list cannot quietly ship world-readable.
# shellcheck disable=SC2016
ensure_layout() {
    mkdir -p \
        "${ROOT}/etc/env" "${ROOT}/etc/secrets" "${ROOT}/etc/edge" \
        "${ROOT}/releases" "${ROOT}/bin" "${ROOT}/backups" \
        "${ROOT}/runtime" "${ROOT}/logs"
    chmod 700 "${ROOT}/etc" "${ROOT}/etc/env" "${ROOT}/etc/secrets" "${ROOT}/etc/edge"

    if fs_carries_modes "${ROOT}/etc"; then
        local d
        for d in "${ROOT}/etc"/*/; do
            [[ -d "$d" ]] || continue
            assert "etc/$(basename "$d") is mode 700" \
                bash -c '[ "$(stat -c "%a" "$1")" = "700" ]' _ "${d%/}"
        done
    fi
}

# Refuse BEFORE generating anything: a half-written etc/env is worse than none.
check_no_overwrite() {
    local out
    for out in "${OUTPUTS[@]}"; do
        [[ -e "$out" ]] || continue
        [[ -f "$out" ]] || die "not a regular file: ${out}" "$GREMION_EXIT_USAGE"
        if [[ "$FORCE" -ne 1 ]]; then
            die "refusing to overwrite ${out} (it holds live secrets); pass --force" \
                "$GREMION_EXIT_USAGE"
        fi
    done
}

scan_sentinels() {
    local tok kind group
    while IFS= read -r tok; do
        [[ -n "$tok" ]] || continue
        kind="${tok#CHANGE_ME_GEN_}"
        kind="${kind%%_*}"
        group="${tok#CHANGE_ME_GEN_"${kind}"_}"
        if [[ -n "${SENTINEL_KIND[$group]:-}" && "${SENTINEL_KIND[$group]}" != "$kind" ]]; then
            die "sentinel group '${group}' is declared as both '${SENTINEL_KIND[$group]}' and '${kind}'" \
                "$GREMION_EXIT_USAGE"
        fi
        SENTINEL_KIND["$group"]="$kind"
    done < <(grep -hoE 'CHANGE_ME_GEN_(hex32|alnum32)_[a-z0-9_]+' "$TMPL_DIR"/*.env.tmpl | sort -u)
    [[ ${#SENTINEL_KIND[@]} -gt 0 ]] \
        || die "no generated sentinels found in ${TMPL_DIR}" "$GREMION_EXIT_ASSERT"
}

generate_values() {
    local group
    for group in "${!SENTINEL_KIND[@]}"; do
        case "${SENTINEL_KIND[$group]}" in
            hex32)   SECRET["$group"]="$(gen_hex32)" ;;
            alnum32) SECRET["$group"]="$(gen_alnum32)" ;;
            *) die "unknown sentinel kind '${SENTINEL_KIND[$group]}' for group '${group}'" \
                   "$GREMION_EXIT_USAGE" ;;
        esac
    done
}

# Longest group name first. Without that, group 'pg' would be substituted inside
# the token of group 'pg_root' and leave a corrupted tail behind.
groups_longest_first() {
    local g
    for g in "${!SENTINEL_KIND[@]}"; do
        printf '%s %s\n' "${#g}" "$g"
    done | sort -rn -k1,1 | cut -d' ' -f2-
}

# state_value <KEY> — read a key back out of the freshly rendered state.env,
# so a subnet has exactly one definition and the app files cannot drift from it.
state_value() {
    local key="$1" val
    val="$(sed -n "s/^${key}=//p" "${ROOT}/etc/env/state.env" | head -n1)"
    [[ -n "$val" ]] || die "state.env does not define ${key}" "$GREMION_EXIT_ASSERT"
    printf '%s' "$val"
}

# render <template> <output> [colour]
# The ph_* locals below are deliberately single-quoted: they hold the LITERAL
# placeholder text to search for inside $body, not something meant to expand
# here (that is what the "${body//"$ph_stack"/...}" substitutions below do).
# shellcheck disable=SC2016
render() {
    local tmpl="$1" out="$2" colour="${3:-}" body group upper v4 v6
    [[ -f "$tmpl" ]] || die "template not found: ${tmpl}" "$GREMION_EXIT_USAGE"
    body="$(cat "$tmpl")"

    local ph_stack='${STACK}' ph_colour='${COLOUR}'
    local ph_v4='${APP_V4_SUBNET}' ph_v6='${APP_V6_SUBNET}'
    body="${body//"$ph_stack"/$STACK_NAME}"
    if [[ -n "$colour" ]]; then
        upper="$(printf '%s' "$colour" | tr '[:lower:]' '[:upper:]')"
        # ASSIGN FIRST, then substitute. state_value calls die; die inside a
        # $( ) that sits inside a ${var//…/…} replacement would kill only the
        # substitution subshell, and the placeholder would silently render
        # EMPTY — a colour project with no pinned subnet. The explicit
        # `|| exit` is what turns that into an abort.
        v4="$(state_value "APP_${upper}_V4_SUBNET")" || exit "$GREMION_EXIT_ASSERT"
        v6="$(state_value "APP_${upper}_V6_SUBNET")" || exit "$GREMION_EXIT_ASSERT"
        body="${body//"$ph_colour"/$colour}"
        body="${body//"$ph_v4"/$v4}"
        body="${body//"$ph_v6"/$v6}"
    fi

    while IFS= read -r group; do
        body="${body//CHANGE_ME_GEN_${SENTINEL_KIND[$group]}_${group}/${SECRET[$group]}}"
    done < <(groups_longest_first)

    # The state and app projects only: the module profiles, and (host build) the
    # composition without the release pins layers.
    case "${tmpl##*/}" in
        state.env.tmpl|app.env.tmpl)
            local nl=$'\n' from to
            from="${nl}COMPOSE_PROFILES=production${nl}"
            to="${nl}COMPOSE_PROFILES=${PROFILES_VALUE}${nl}"
            [[ "$body" == *"$from"* ]] \
                || die "${tmpl}: no bare COMPOSE_PROFILES=production line to render the module profiles into" \
                    "$GREMION_EXIT_ASSERT"
            body="${body/"$from"/$to}"
            if [[ "$HOST_BUILD" -eq 1 ]]; then
                body="${body//:docker-compose.state-pins.yml/}"
                body="${body//:docker-compose.pins.yml/}"
            fi
            ;;
    esac

    atomic_write "$out" 600 <<< "$body"
}

# Post-conditions, observed on what was actually written.
# The bash -c '...' bodies below are deliberately single-quoted: "$1" and the
# other $-expressions inside them must stay literal here and expand only
# later, inside the subshell bash -c launches.
# shellcheck disable=SC2016
verify_outputs() {
    local out modes=0
    fs_carries_modes "${ROOT}/etc/env" && modes=1
    for out in "${OUTPUTS[@]}"; do
        assert "$(basename "$out") exists and is non-empty" test -s "$out"
        assert "$(basename "$out") has no generated sentinel left" \
            bash -c '! grep -q "CHANGE_ME_GEN_" "$1"' _ "$out"
        assert "$(basename "$out") has no unsubstituted render placeholder" \
            bash -c '! grep -q "\${" "$1"' _ "$out"
        assert "$(basename "$out") declares no key twice" \
            bash -c '[ -z "$(grep -E "^[A-Za-z_][A-Za-z0-9_]*=" "$1" | sed "s/=.*//" | sort | uniq -d)" ]' _ "$out"
        case "$(basename "$out")" in
            state.env|app-blue.env|app-green.env)
                assert "$(basename "$out") carries COMPOSE_PROFILES=${PROFILES_VALUE}" \
                    grep -qxF "COMPOSE_PROFILES=${PROFILES_VALUE}" "$out"
                if [[ "$HOST_BUILD" -eq 1 ]]; then
                    assert "$(basename "$out") names no release pins layer (host build)" \
                        bash -c '! grep -E "^COMPOSE_FILE=" "$1" | grep -q "pins\.yml"' _ "$out"
                fi
                ;;
        esac
        if [[ "$modes" -eq 1 ]]; then
            assert "$(basename "$out") is mode 600" \
                bash -c '[ "$(stat -c "%a" "$1")" = "600" ]' _ "$out"
        fi
    done
    if [[ "$modes" -eq 1 ]]; then
        assert "etc/ is mode 700" bash -c '[ "$(stat -c "%a" "$1")" = "700" ]' _ "${ROOT}/etc"
    else
        info "MODE-CHECK: skipped — this filesystem does not carry POSIX modes"
    fi
}

print_operator_todo() {
    local out pending=0 key base
    echo
    info "keys the operator must still fill in before any \`docker compose up\`:"
    for out in "${OUTPUTS[@]}"; do
        base="$(basename "$out")"
        while IFS= read -r key; do
            [[ -n "$key" ]] || continue
            printf '    %s: %s\n' "$base" "$key"
            pending=$((pending + 1))
        done < <(awk -F= '/CHANGE_ME_OPERATOR_/ && /^[A-Za-z_]/ { print $1 }' "$out")
    done
    echo
    printf 'INIT-SECRETS: files=%d generated=%d operator-pending=%d\n' \
        "${#OUTPUTS[@]}" "${#SECRET[@]}" "$pending"
}

main() {
    parse_args "$@"
    # tr: gen_alnum32 pipes through it twice and the colour upcase uses it again.
    # mktemp, tail: assert() captures the wrapped command's output through them.
    # A tool used but not declared turns a host missing the package into a
    # mid-render failure over a half-written etc/env instead of a clean exit 2.
    # jq: the module profile map (compute_profiles).
    need_cmd openssl awk sed grep sort stat tr mktemp tail jq
    [[ -d "$TMPL_DIR" ]] || die "template directory not found: ${TMPL_DIR}" "$GREMION_EXIT_USAGE"
    compute_profiles

    local env_dir="${ROOT}/etc/env"
    OUTPUTS=(
        "${env_dir}/state.env"
        "${env_dir}/app-blue.env"
        "${env_dir}/app-green.env"
        "${env_dir}/mail.env"
        "${env_dir}/ops.env"
    )

    ensure_layout
    check_no_overwrite
    scan_sentinels
    generate_values

    info "rendering ${#OUTPUTS[@]} env files into ${env_dir} (STACK=${STACK_NAME})"
    # state.env FIRST: the app renders read their subnets back out of it.
    render "${TMPL_DIR}/state.env.tmpl" "${env_dir}/state.env"
    render "${TMPL_DIR}/app.env.tmpl"   "${env_dir}/app-blue.env"  blue
    render "${TMPL_DIR}/app.env.tmpl"   "${env_dir}/app-green.env" green
    render "${TMPL_DIR}/mail.env.tmpl"  "${env_dir}/mail.env"
    render "${TMPL_DIR}/ops.env.tmpl"   "${env_dir}/ops.env"

    verify_outputs
    print_operator_todo
}

main "$@"
