#!/usr/bin/env bash
#
# gremion-verify [--colour <blue|green>] [--hosts FILE] [--reboot]
#
# The spec-A §C verification contract. Every assertion reads the RUNNING system:
# Traefik's own API for the router/service/middleware graph, the certificate the
# edge actually presents, real HTTP requests through the edge, and
# `docker inspect` / `docker exec` for the containers behind it. Nothing here
# reads a config file to decide whether the edge is correct — that is the failure
# class this project has paid for most often.
#
# It collects every failure instead of stopping at the first, so one run produces
# the whole picture, and writes it to runtime/last-verify.json for the control
# plane and the release procedure.
#
# THE MARKER PATH IS PART OF THE CONTRACT. VERIFY_MARKER_PATH must name an
# endpoint whose body is
#   (a) BYTE-STABLE  — two requests for the same host return byte-identical
#       bytes: no timestamp, no nonce, no CSRF token, no request id. A page that
#       changes on every request makes the host-pin comparison below fail on
#       every run, and a guard that cries wolf gets switched off; and
#   (b) HOST-DISCRIMINATING — a function of the tenant the edge resolved, so two
#       different hosts return different bytes. A body that is identical for
#       every host makes the host-pin comparison unfalsifiable.
# The default /healthz satisfies both (spec B: {"ok":true,"tenant":…,"colour":…}).
# check_marker_discriminates() asserts (b) at run time so the pin universal can
# never pass vacuously.
#
# Exit codes: 0 ok · 1 an assertion failed · 2 usage or missing precondition.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

TRAEFIK_API="${TRAEFIK_API:-http://127.0.0.1:8080}"
INTERNALTEST_PORT="${INTERNALTEST_PORT:-8081}"
CERT_MIN_DAYS="${CERT_MIN_DAYS:-20}"
HTTP_TIMEOUT="${HTTP_TIMEOUT:-10}"
REBOOT_SETTLE_SECONDS="${REBOOT_SETTLE_SECONDS:-30}"
GREMION_LEAVES="${GREMION_LEAVES:-content finance files votes messages newsletter calendar board vault}"

# ── P4 waivers (spec B §1.4/§G) — READ FROM THE SIGNED LEDGER ────────────────
# Six go-live-gate items are waived until the pilot. They are NOT proofs this
# release passed, so they are never printed by ok(): each is printed as WAIVED
# with its §L item number and the gate id it suspends, and lands in
# last-verify.json as a third state alongside ok/failures. A waiver rendered as
# OK is how a deployment bar gets read as a go-live gate.
#
# The table is READ, not carried: gremion-deploy checks a release out with
# `git clone --depth 1 --branch <tag>` of the whole repository, so docs/ ships
# with every release and there is only one copy to read. An absent ledger is a
# hard failure, not an empty list: a release tree that cannot say what it did
# not prove must not report green.
#
# WHICH copy, though, is not obvious, and getting it wrong once cost a host its
# first deploy. gremion-deploy runs this program at step 9 (the new colour) and
# step 11 (the public edge); `$ROOT/current` is moved onto the new release only
# at step 12, and bootstrap.sh never creates it at all. Reading `current`
# unconditionally therefore (a) died with exit 2 on a freshly bootstrapped host
# before the step that would have created it, and (b) on every later deploy
# printed release N's waivers while verifying release N+1. See
# waiver_ledger_path() below for the order that fixes both.
# Row shape (pinned by test/host/release-1-waivers.bats):
#   | `<id>` | §L:<n> | <GATE-ID> | <what is waived> | … | … |
GREMION_WAIVER_LEDGER="${GREMION_WAIVER_LEDGER:-}"
GREMION_WAIVERS=()

# waiver_ledger_path -> the ledger this run must read, in order:
#
#   1. $GREMION_WAIVER_LEDGER. gremion-deploy sets it for steps 9 and 11 so the
#      release BEING verified is the release whose waivers are printed. It is
#      also the operator's override for a one-off run.
#   2. The verifier's OWN checkout. infra/host/bin/ sits three levels under the
#      repository root, so a verifier invoked out of a release tree reads that
#      tree's ledger and cannot drift from itself.
#   3. $(gremion_root)/current/docs/ops/release-1-waivers.md. The installed copy
#      under /opt/gremion/bin has no sibling tree (bootstrap.sh only asserts it
#      is present), so this is what a bare `gremion-verify` and the reboot gate
#      read.
#
# An absent ledger at the end of that list is still fatal, with exit 2 - a
# missing precondition, not a failed assertion. reboot_gate() reads that
# distinction: a precondition failure is not something restarting containers
# can fix.
waiver_ledger_path() {
    local sibling
    if [[ -n "${GREMION_WAIVER_LEDGER:-}" ]]; then
        printf '%s' "$GREMION_WAIVER_LEDGER"
        return 0
    fi
    sibling="$SCRIPT_DIR/../../../docs/ops/release-1-waivers.md"
    if [[ -f "$sibling" ]]; then
        printf '%s' "$sibling"
        return 0
    fi
    printf '%s' "$(gremion_root)/current/docs/ops/release-1-waivers.md"
}

load_waivers() {
    local ledger
    ledger="$(waiver_ledger_path)"
    [[ -f "$ledger" ]] \
        || die "signed waiver ledger absent from the release tree: ${ledger} (spec B §1.4)" 2
    # mapfile, not a pipeline: the reader must run in THIS shell so a parse
    # failure below can still die() the program rather than a subshell. The row
    # pattern itself lives in common.sh, so the guard that pins the ledger
    # parses it with the SAME parser and can never be more permissive.
    mapfile -t GREMION_WAIVERS < <(waiver_rows "$ledger")

    # A POST-CONDITION, not a floor. `> 0` is satisfied by ONE surviving row,
    # and mapfile < <(…) throws the reader's exit status away, so a parse that
    # dropped five of six rows printed a shorter table and still exited 0.
    # Counting the candidate rows independently makes a dropped row loud.
    local parsed=${#GREMION_WAIVERS[@]} candidates
    candidates="$(waiver_candidate_count "$ledger")"
    (( parsed > 0 )) \
        || die "waiver ledger parsed to zero rows — the row shape changed: ${ledger}" 2
    (( parsed == candidates )) \
        || die "waiver ledger: ${candidates} row(s) look like waivers, ${parsed} parsed — a row the reader cannot read is a waiver nobody is told about: ${ledger}" 2
}

# A third printer beside ok()/bad(): dim, never green, never counted as a pass.
waived() { printf '%s  WAIVED%s %s\n' "$C_DIM" "$C_OFF" "$*"; }

print_waivers() {
    local entry id item gate why
    for entry in "${GREMION_WAIVERS[@]}"; do
        IFS='|' read -r id item gate why <<<"$entry"
        why="${why#"${why%%[![:space:]]*}"}"; why="${why%"${why##*[![:space:]]}"}"
        waived "${id} (§L:${item}, ${gate}) — ${why}"
    done
}

waivers_json() {
    printf '%s\n' "${GREMION_WAIVERS[@]}" \
        | jq -Rsc 'split("\n") | map(select(length > 0) | split("|")
                   | {id: .[0], lItem: (.[1] | tonumber), gate: .[2],
                      why: (.[3] | sub("^ +";"") | sub(" +$";""))})'
}

# Precedence for the marker path: an explicit environment override (an operator
# probing one endpoint by hand, or a test) beats etc/env/state.env, which beats
# the built-in default. load_env runs later and would otherwise clobber the
# override, so the override is captured before it does.
VERIFY_MARKER_PATH_OVERRIDE="${VERIFY_MARKER_PATH:-}"
VERIFY_MARKER_PATH="${VERIFY_MARKER_PATH:-/healthz}"

COLOUR=""
HOSTS_FILE=""
REBOOT=0

ROUTERS_JSON=""
SERVICES_JSON=""
MIDDLEWARES_JSON=""
TCP_ROUTERS_JSON="[]"
UDP_ROUTERS_JSON="[]"

declare -a FAILURES=()
declare -a ROUTER_ROWS=()
declare -A ROUTER_CLASS=()
declare -A ROUTER_HOST=()
declare -A ROUTER_SERVICE=()
declare -A SERVICES_TO_CHECK=()
declare -A SERVICE_HEALTHY=()
declare -A SAN_OK=()
declare -A MARKER_SHA=()

usage() {
    cat >&2 <<'EOF'
usage: gremion-verify [--colour <blue|green>] [--hosts FILE] [--reboot]

  --colour c   additionally verify the INACTIVE colour c through the loopback
               internaltest entrypoint and from inside its own containers
  --hosts F    one hostname per line; default is PLATFORM_DOMAIN,
               control.PLATFORM_DOMAIN and every line of etc/tenant-hosts.txt
  --reboot     reboot gate: on failure restart the active colour once, re-verify,
               and report the outcome to ALERT_WEBHOOK_URL

It refuses to run without the signed waiver ledger docs/ops/release-1-waivers.md
and reads it from $GREMION_WAIVER_LEDGER if set, else from its own checkout, else
from $(gremion_root)/current/docs/ops/. Exit 1 means an assertion failed; exit 2
means it could not verify.
EOF
    exit 2
}

fail() { FAILURES+=("$1"); bad "$1"; }

# `api_list` runs inside a command substitution, i.e. in a SUBSHELL, so the `exit` in
# its `die` can only end that subshell — it cannot end this program. Worse,
# run_pass is invoked as `if run_pass`, which disables `set -e` for everything it
# calls, so an unreachable Traefik API would otherwise leave all three variables
# empty, give `check_routers` nothing to iterate, and be reported as GREEN.
# Each substitution therefore propagates its own status explicitly.
#
# The list endpoints are PAGINATED (Traefik's default page is 100 items). A
# universal that read one page would silently skip every router sorted after
# the hundredth, so each list is requested with API_PER_PAGE and a response
# that fills the page — or that announces a later page in X-Next-Page — is a
# precondition failure, never a partial read.
API_PER_PAGE="${API_PER_PAGE:-10000}"

api_list() {
    local path="$1" hdr out len next
    hdr="$(mktemp)"
    if ! out="$(curl -fsS --max-time "$HTTP_TIMEOUT" -D "$hdr" \
                "${TRAEFIK_API}${path}?per_page=${API_PER_PAGE}&page=1" 2>/dev/null)"; then
        rm -f "$hdr"
        die "traefik API unreachable: ${TRAEFIK_API}${path}" 2
    fi
    next="$(tr -d '\r' < "$hdr" | sed -n 's/^[Xx]-[Nn]ext-[Pp]age: *//p' | head -n1)"
    rm -f "$hdr"
    len="$(printf '%s' "$out" | jq -r 'if type == "array" then length else "not-a-list" end' 2>/dev/null || echo not-json)"
    [[ "$len" =~ ^[0-9]+$ ]] || die "traefik API ${path} did not return a JSON list (${len})" 2
    if (( len >= API_PER_PAGE )) || [[ -n "$next" && "$next" =~ ^[0-9]+$ && "$next" -gt 1 ]]; then
        die "traefik API ${path} is truncated (${len} items, per_page=${API_PER_PAGE}, X-Next-Page=${next:-none}); raise API_PER_PAGE" 2
    fi
    printf '%s' "$out"
}

fetch_api() {
    ROUTERS_JSON="$(api_list /api/http/routers)"         || exit $?
    SERVICES_JSON="$(api_list /api/http/services)"       || exit $?
    MIDDLEWARES_JSON="$(api_list /api/http/middlewares)" || exit $?
    TCP_ROUTERS_JSON="$(api_list /api/tcp/routers)"      || exit $?
    UDP_ROUTERS_JSON="$(api_list /api/udp/routers)"      || exit $?
}

# The literal host a router's rule pins, or "*" for the catch-all internaltest
# routers. An empty answer means the rule names no host at all, which §C forbids.
rule_host() {
    local rule="$1"
    if [[ "$rule" =~ Host\(\`([^\`]+)\` ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
        return 0
    fi
    if [[ "$rule" == *"HostRegexp("* ]]; then
        printf '*'
        return 0
    fi
    printf ''
}

check_routers() {
    local svc_names mw_names n i name status service rule qualified host mws m base eps
    svc_names="$(printf '%s' "$SERVICES_JSON" | jq -r '.[].name')"
    mw_names="$(printf '%s' "$MIDDLEWARES_JSON" | jq -r '.[].name' | sed 's/@.*//')"
    n="$(printf '%s' "$ROUTERS_JSON" | jq -r 'length')"

    for (( i = 0; i < n; i++ )); do
        name="$(printf '%s' "$ROUTERS_JSON" | jq -r ".[$i].name")"
        case "$name" in *@internal) continue ;; esac

        status="$(printf  '%s' "$ROUTERS_JSON" | jq -r ".[$i].status // \"missing\"")"
        service="$(printf '%s' "$ROUTERS_JSON" | jq -r ".[$i].service // \"\"")"
        rule="$(printf    '%s' "$ROUTERS_JSON" | jq -r ".[$i].rule // \"\"")"
        eps="$(printf     '%s' "$ROUTERS_JSON" | jq -r ".[$i].entryPoints // [] | join(\",\")")"

        [[ "$status" == "enabled" ]] || fail "router $name: status=$status (expected enabled)"

        # Traefik reports a router's service without a provider suffix whenever
        # the router and its service come from the same provider, and resolves
        # the bare name against THAT provider — not against the file provider.
        # Defaulting to @file therefore marks every docker-provider router
        # UNCLASSIFIED, which on the real edge is most of the state tier. The
        # router's own name carries the provider, so use it.
        qualified="$service"
        case "$qualified" in *@*) ;; *) qualified="${service}@${name##*@}" ;; esac
        ROUTER_SERVICE["$name"]="$qualified"

        if ! printf '%s\n' "$svc_names" | grep -qx "$qualified"; then
            ROUTER_CLASS["$name"]="unclassified"
            fail "UNCLASSIFIED router $name: service '$service' is not known to traefik"
        else
            case "$qualified" in
                app@file|public@file|app-next@file|public-next@file)
                    ROUTER_CLASS["$name"]="colour-bound" ;;
                *)  ROUTER_CLASS["$name"]="state-bound" ;;
            esac
        fi

        host="$(rule_host "$rule")"
        [[ -n "$host" ]] || fail "router $name: rule names no host ($rule)"
        ROUTER_HOST["$name"]="$host"

        mws="$(printf '%s' "$ROUTERS_JSON" | jq -r ".[$i].middlewares // [] | .[]")"
        for m in $mws; do
            base="${m%%@*}"
            printf '%s\n' "$mw_names" | grep -qx "$base" \
                || fail "router $name: middleware $m is referenced but absent"
        done

        # A router that lives ONLY on the loopback internaltest entrypoint serves
        # the inactive colour. Outside a deploy that colour is legitimately down,
        # so its containers are censused only under --colour.
        if [[ "$eps" == "internaltest" && -z "$COLOUR" ]]; then
            continue
        fi
        SERVICES_TO_CHECK["$qualified"]=1
    done
}

# ── The router universal (TASK-034a; spec B §3 post-condition) ───────────────
#
# Asserted over EVERY router Traefik's API reports, never over a list of names:
# a router added tomorrow is held to it the moment Traefik loads it. Later
# /api/v1 routers (TRD-409) are no exception — they must pass this too.
#
# SUBJECT: every router except `*@internal` (Traefik's own: acme-http, api,
# ping) and a router whose entryPoints are EXACTLY ["internaltest"] (the
# loopback-only inactive-colour routers). A router with NO entryPoints listens
# on every default entrypoint, so it is a subject too — exemption is by
# evidence, never by absence.
#
# Each subject must carry:
#   - a non-empty tls.certResolver. A bare `tls: {}` does not inherit the
#     entrypoint's resolver and silently serves the default certificate;
#   - a rule naming exactly ONE literal Host() and no HostRegexp — a pattern
#     or a second host cannot be pinned to one value;
#   - exactly ONE edge-hostpin-* middleware, FIRST in its chain, whose
#     X-Forwarded-Host (read from the middleware Traefik actually loaded) is
#     that literal host. Traefik only sets X-Forwarded-Host when it is absent
#     and only strips it from untrusted peers; the pin is what makes the header
#     edge-authoritative, and first is what keeps every later middleware from
#     seeing a client-supplied value;
#   - an HSTS middleware (edge-hsts-platform|edge-hsts-custom with stsSeconds
#     > 0) and a tiered edge-ratelimit-* middleware that IS a rate limiter.
#     Names alone are not trusted: an HSTS-named middleware with no max-age is
#     not HSTS.
# Zero subjects is itself a failure: a universal over nothing proves nothing.

# ── The router universal (TASK-034a; spec B §3 post-condition) ───────────────
#
# Asserted over EVERY router Traefik's API reports, never over a list of names:
# a router added tomorrow is held to it the moment Traefik loads it. Later
# /api/v1 routers (TRD-409) are no exception — they must pass this too.
#
# SUBJECT: every HTTP router except `*@internal` (Traefik's own: acme-http, api,
# ping) and a router whose entryPoints are EXACTLY ["internaltest"] (the
# loopback-only inactive-colour routers). A router with NO entryPoints listens
# on every default entrypoint, so it is a subject too — exemption is by
# evidence, never by absence. TCP/UDP routers on the public entrypoints are
# refused outright (check_l4_routers): a TCP passthrough on websecure takes the
# connection before any HTTP router, pin included, ever sees it.
#
# Each subject must carry:
#   - a non-empty tls.certResolver. A bare `tls: {}` does not inherit the
#     entrypoint's resolver and silently serves the default certificate;
#   - a rule of the ALLOW-LISTED shape  Host(`<one lowercase host>`) [&& …]:
#     exactly one host matcher in any letter case (host/Host/HOST,
#     HostRegexp, HostHeader, HostSNI all count), no second argument, and no
#     top-level `||` — a disjunction answers requests for other hosts under
#     this router's pin (see rule_shape);
#   - exactly ONE edge-hostpin-* middleware, FIRST in its chain, whose loaded
#     headers set X-Forwarded-Host (compared case-insensitively, exactly one
#     such key) to that literal host. Traefik only sets X-Forwarded-Host when it
#     is absent and only strips it from untrusted peers; the pin is what makes
#     the header edge-authoritative, first is what keeps every later middleware
#     from seeing a client-supplied value;
#   - no OTHER middleware in the chain that can rewrite X-Forwarded-Host after
#     the pin: a headers middleware naming it, a forwardAuth copying it (or
#     copying by regex), or a chain/plugin middleware whose effect cannot be
#     read from the API;
#   - an HSTS middleware (edge-hsts-platform|edge-hsts-custom with stsSeconds
#     > 0) and a tiered edge-ratelimit-* middleware that IS a rate limiter.
#     Names alone are not trusted.
# Zero subjects is itself a failure: a universal over nothing proves nothing.

# rule_shape <rule> -> "ok <host>" or "bad <reason>". The allow-list, in awk so
# the parenthesis depth and backtick/double-quote strings can be tracked.
rule_shape() {
    # ENVIRON, not -v: `awk -v` interprets backslash escapes and would hand the
    # scan a different rule than the one Traefik parsed.
    RULE="$1" awk 'BEGIN {
        r = ENVIRON["RULE"]
        if (match(r, /^Host\(`[a-z0-9.-]+`\)/) == 0) {
            print "bad does not begin with exactly one literal Host(`<lowercase host>`)"; exit
        }
        # A backslash can escape a quote and hide a top-level || from the scan
        # below (measured against traefik v3.7, review round 2); no rule this
        # edge emits needs one, so any backslash fails closed.
        if (index(r, "\\") > 0) { print "bad contains a backslash escape, which can hide a top-level ||"; exit }
        host = substr(r, 7, RLENGTH - 8); rest = substr(r, RLENGTH + 1)
        l = tolower(r); n = gsub(/host(regexp|header|sni)?\(/, "", l)
        if (n != 1) { print "bad carries " n " host matchers (expected exactly 1)"; exit }
        if (rest != "" && rest !~ /^[ \t]*&&/) { print "bad continues with something other than &&"; exit }
        depth = 0; q = ""
        for (i = 1; i <= length(rest); i++) {
            c = substr(rest, i, 1)
            if (q != "") { if (c == q) q = ""; continue }
            if (c == "`" || c == "\"") { q = c; continue }
            if (c == "(") depth++
            else if (c == ")") depth--
            else if (depth == 0 && c == "|" && substr(rest, i + 1, 1) == "|") {
                print "bad has a top-level || and answers more than its host"; exit
            }
        }
        print "ok " host
    }'
}

# The middleware object Traefik loaded for <qualified name>, or "null".
mw_json() {
    printf '%s' "$MIDDLEWARES_JSON" | jq -c --arg n "$1" '[.[] | select(.name == $n)][0] // null'
}

# A middleware reference qualified with the referring router's provider, the
# same resolution Traefik applies to an unsuffixed name.
qualify_ref() {
    local ref="$1" router="$2"
    case "$ref" in *@*) printf '%s' "$ref" ;; *) printf '%s@%s' "$ref" "${router##*@}" ;; esac
}

check_router_universal() {
    local n i r name eps resolver rule shape host m q base mj pinvals npinkeys why
    local -a chain pins mws
    local subjects=0 has_hsts has_rl
    n="$(printf '%s' "$ROUTERS_JSON" | jq -r 'length')" \
        || { fail "router universal: the router list is not JSON"; return 0; }
    for (( i = 0; i < n; i++ )); do
        r="$(printf '%s' "$ROUTERS_JSON" | jq -c ".[$i]")"
        name="$(jq -r '.name' <<<"$r")"
        case "$name" in *@internal) continue ;; esac
        eps="$(jq -r '.entryPoints // [] | join(",")' <<<"$r")"
        [[ "$eps" == "internaltest" ]] && continue
        subjects=$(( subjects + 1 ))

        resolver="$(jq -r '.tls.certResolver // ""' <<<"$r")"
        [[ -n "$resolver" ]] || fail "router $name: no certresolver"

        rule="$(jq -r '.rule // ""' <<<"$r")"
        shape="$(rule_shape "$rule")"
        host=""
        if [[ "$shape" == ok\ * ]]; then
            host="${shape#ok }"
        else
            fail "router $name: rule ${shape#bad } — it cannot be pinned to one host: $rule"
        fi

        chain=(); pins=(); mws=()
        mapfile -t mws < <(jq -r '.middlewares // [] | .[]' <<<"$r")
        for m in "${mws[@]}"; do
            q="$(qualify_ref "$m" "$name")"
            chain+=("$q")
            base="${q%%@*}"
            [[ "$base" == edge-hostpin-* ]] && pins+=("$q")
        done

        if (( ${#pins[@]} != 1 )); then
            fail "router $name: ${#pins[@]} host pins (expected exactly 1)"
        else
            mj="$(mw_json "${pins[0]}")"
            npinkeys="$(jq -r '[.headers.customRequestHeaders // {} | to_entries[]
                               | select(.key | ascii_downcase == "x-forwarded-host")] | length' <<<"$mj")"
            pinvals="$(jq -r '[.headers.customRequestHeaders // {} | to_entries[]
                              | select(.key | ascii_downcase == "x-forwarded-host") | .value] | join(",")' <<<"$mj")"
            if [[ -n "$host" ]] && { [[ "$npinkeys" != "1" ]] || [[ "$pinvals" != "$host" ]]; }; then
                fail "router $name: pin ${pins[0]} sets X-Forwarded-Host '${pinvals}', not its own host '${host}'"
            fi
            [[ "${chain[0]}" == "${pins[0]}" ]] \
                || fail "router $name: host pin ${pins[0]} is not first in the chain (${chain[*]})"
        fi

        has_hsts=0; has_rl=0
        for q in "${chain[@]}"; do
            base="${q%%@*}"
            mj="$(mw_json "$q")"
            if [[ "$base" != edge-hostpin-* ]]; then
                why="$(jq -r '
                    if . == null then ""
                    elif ([.headers.customRequestHeaders // {} | keys[] | ascii_downcase] | index("x-forwarded-host")) != null
                        then "sets X-Forwarded-Host after the pin"
                    elif .forwardAuth != null and (([.forwardAuth.authResponseHeaders // [] | .[] | ascii_downcase]
                              | index("x-forwarded-host")) != null or ((.forwardAuth.authResponseHeadersRegex // "") != ""))
                        then "is a forwardAuth that can copy X-Forwarded-Host after the pin"
                    elif .chain != null or .plugin != null or ((.type // "") | test("^(chain|plugin)"; "i"))
                        then "is a chain/plugin middleware whose effect on X-Forwarded-Host cannot be read"
                    else "" end' <<<"$mj")"
                [[ -z "$why" ]] || fail "router $name: middleware $q $why"
            fi
            case "$base" in
                edge-hsts-platform|edge-hsts-custom)
                    [[ "$(jq -r '(.headers.stsSeconds // 0) > 0' <<<"$mj")" == "true" ]] && has_hsts=1 ;;
                edge-ratelimit-?*)
                    [[ "$(jq -r '. != null and ((.rateLimit.average // 0) > 0)' <<<"$mj")" == "true" ]] && has_rl=1 ;;
            esac
        done
        (( has_hsts )) || fail "router $name: no HSTS middleware (edge-hsts-platform|edge-hsts-custom with stsSeconds > 0)"
        (( has_rl ))   || fail "router $name: no edge-ratelimit-* middleware (a rateLimit with average > 0)"
    done
    (( subjects > 0 )) \
        || fail "router universal: traefik reports no public router — a universal over nothing proves nothing"
    return 0
}

# TCP and UDP routers on the public entrypoints (or on none, which means all)
# sit IN FRONT of every HTTP router: a TCP HostSNI passthrough on websecure
# hands the raw client stream — forged headers included — to its backend.
check_l4_routers() {
    local proto json bad
    for proto in tcp udp; do
        if [[ "$proto" == tcp ]]; then json="$TCP_ROUTERS_JSON"; else json="$UDP_ROUTERS_JSON"; fi
        bad="$(printf '%s' "$json" | jq -r '.[]
            | select((.name | endswith("@internal")) | not)
            | select((.entryPoints // []) as $e | ($e | length) == 0 or ($e | index("web")) != null or ($e | index("websecure")) != null)
            | .name' | paste -sd, -)" \
            || { fail "router universal: the ${proto} router list is not JSON"; continue; }
        [[ -z "$bad" ]] \
            || fail "${proto^^} router(s) on a public entrypoint: ${bad} — an L4 router takes the connection before any pinned HTTP router sees it"
    done
    return 0
}

# ── Middleware placement (spec B B-09) ───────────────────────────────────────
# Every @docker middleware a router can chain must be declared on the TRAEFIK
# container's labels (compose service `traefik`), the one container that exists
# whenever a router does; each tenant's pin and per-IP cap live in that
# tenant's emitted file, and no other file-provider middleware may exist. An
# APP-TIER container (a colour: gremion-ui-*/gremion-public-* or a
# *-app-blue|green compose project) vanishes on every switch and takes its
# middlewares along, leaving every router that chains them in error with no way
# back — it is named explicitly. Anything this cannot SEE (docker unreachable,
# a label set that is not JSON) is a failure, not an empty set. Label keys are
# compared lower-cased: Traefik reads them case-insensitively.
check_middleware_placement() {
    local ids id cname labels project declared m base traefik_ids=0
    local -A on_traefik=()
    if ! ids="$(docker ps -a -q)"; then
        fail "middleware placement: docker ps failed — the placement of @docker middlewares cannot be established"
        return 0
    fi
    for id in $ids; do
        if ! cname="$(docker inspect --format '{{.Name}}' "$id")" \
           || ! labels="$(docker inspect --format '{{json .Config.Labels}}' "$id")"; then
            fail "middleware placement: docker inspect ${id} failed"
            continue
        fi
        cname="${cname#/}"
        [[ -n "$labels" && "$labels" != "null" ]] || labels='{}'
        if ! labels="$(jq -c 'with_entries(.key |= ascii_downcase)' <<<"$labels" 2>/dev/null)"; then
            fail "middleware placement: the labels of container ${cname} are not JSON"
            continue
        fi
        project="$(jq -r '."com.docker.compose.project" // ""' <<<"$labels")"
        declared="$(jq -r 'keys[] | select(startswith("traefik.http.middlewares.")) | split(".")[3]' <<<"$labels" | sort -u)"
        if [[ "$(jq -r '."com.docker.compose.service" // ""' <<<"$labels")" == "traefik" ]]; then
            traefik_ids=$(( traefik_ids + 1 ))
            for m in $declared; do on_traefik["$m"]=1; done
            continue
        fi
        case "$cname|$project" in
            gremion-ui-blue\|*|gremion-ui-green\|*|gremion-public-blue\|*|gremion-public-green\|*|*\|*-app-blue|*\|*-app-green)
                [[ -z "$declared" ]] \
                    || fail "container ${cname} (app tier) declares middleware(s): $(paste -sd, - <<<"$declared") — an app-tier container vanishes on every colour switch; declare them on the traefik container" ;;
        esac
    done

    for m in $(printf '%s' "$MIDDLEWARES_JSON" | jq -r '.[] | select((.provider // (.name | split("@")[1])) == "docker") | .name'); do
        base="$(tr '[:upper:]' '[:lower:]' <<<"${m%%@*}")"
        (( traefik_ids == 1 )) \
            || { fail "middleware ${m}: ${traefik_ids} containers carry com.docker.compose.service=traefik (expected exactly 1), so its placement cannot be established"; continue; }
        [[ -n "${on_traefik[$base]:-}" ]] \
            || fail "middleware ${m} is not declared on the traefik container's labels (spec B B-09)"
    done

    for m in $(printf '%s' "$MIDDLEWARES_JSON" | jq -r '.[] | select((.provider // (.name | split("@")[1])) == "file") | .name'); do
        base="${m%%@*}"
        case "$base" in
            edge-hostpin-?*|edge-perip-?*) ;;
            *) fail "middleware ${m} is declared by the file provider — only an emitted tenant file's edge-hostpin-*/edge-perip-* may be (active.yml never declares one)" ;;
        esac
    done
    return 0
}

# ── check_emitted_routers (B18) ──────────────────────────────────────────────
# Every etc/edge/tenant-<slug>.yml the emitter wrote must be LIVE and MINE:
# each router it declares is reported by Traefik as <router>@file, enabled,
# with the SAME rule the file carries (Traefik's file provider keeps the first
# of two same-named definitions and skips the other, so a name collision
# between two tenant files leaves one tenant's host routed by the other's
# router). No router or middleware name may appear in two tenant files. The
# file's shape is held to the emitter contract: only http.routers and
# http.middlewares, routers tenant-<slug>[-i], middlewares only
# edge-hostpin-<slug>[-i] / edge-perip-<slug>, at least one router, a slug of
# the tenant alphabet, and never a .yaml sibling (the emitter writes .yml).
#
# The emitter's output is fixed-shape YAML (renderTenantRouter); the awk below
# reads that shape — keys at two spaces under `http:` are sections, keys at
# four spaces are object names, `rule:` at six spaces belongs to the current
# router — and anything it cannot place is reported by the shape checks.
check_emitted_routers() {
    local dir f slug rel kind obj rest status nrouters api_rule
    local -A seen_name=()
    dir="$(gremion_root)/etc/edge"
    if [[ ! -d "$dir" ]]; then
        fail "check_emitted_routers: ${dir} does not exist — the router directory Traefik watches is missing"
        return 0
    fi
    for f in "$dir"/tenant-*.yaml; do
        [[ -e "$f" ]] || continue
        fail "etc/edge/${f##*/}: a tenant router file with a .yaml suffix — the emitter writes only .yml, so nothing owns or prunes this one"
    done
    for f in "$dir"/tenant-*.yml; do
        [[ -e "$f" ]] || continue
        rel="etc/edge/${f##*/}"
        slug="${f##*/tenant-}"; slug="${slug%.yml}"
        if [[ ! "$slug" =~ ^[a-z0-9-]{1,30}$ ]]; then
            fail "${rel}: not a tenant slug the emitter can produce — refusing to read its names"
            continue
        fi
        nrouters=0
        while IFS=' ' read -r kind obj rest; do
            case "$kind" in
                section)
                    [[ "$obj" == "routers" || "$obj" == "middlewares" ]] \
                        || fail "${rel} declares http.${obj} — an emitted file declares only routers and middlewares" ;;
                routers)
                    nrouters=$(( nrouters + 1 ))
                    [[ "$obj" =~ ^tenant-${slug}(-[1-9][0-9]*)?$ ]] \
                        || fail "${rel} declares router ${obj}, which is not tenant-${slug}[-i]"
                    [[ -z "${seen_name[r:$obj]:-}" ]] \
                        || fail "router name ${obj} is declared in both ${seen_name[r:$obj]} and ${rel} — traefik keeps one and skips the other"
                    seen_name["r:$obj"]="$rel"
                    status="$(printf '%s' "$ROUTERS_JSON" \
                        | jq -r --arg n "${obj}@file" '[.[] | select(.name == $n)][0].status // "absent"')"
                    [[ "$status" == "enabled" ]] \
                        || fail "emitted router ${obj}@file (${rel}) is not live in traefik (status=${status})" ;;
                rule)
                    api_rule="$(printf '%s' "$ROUTERS_JSON" \
                        | jq -r --arg n "${obj}@file" '[.[] | select(.name == $n)][0].rule // ""')"
                    [[ -z "$api_rule" || "$api_rule" == "$rest" ]] \
                        || fail "emitted router ${obj}@file: traefik serves rule '${api_rule}', but ${rel} says '${rest}' — another file's definition won" ;;
                middlewares)
                    [[ "$obj" =~ ^edge-hostpin-${slug}(-[1-9][0-9]*)?$ || "$obj" == "edge-perip-${slug}" ]] \
                        || fail "${rel} declares middleware ${obj} — only edge-hostpin-${slug}[-i] and edge-perip-${slug} belong in an emitted file"
                    [[ -z "${seen_name[m:$obj]:-}" ]] \
                        || fail "middleware name ${obj} is declared in both ${seen_name[m:$obj]} and ${rel} — traefik keeps one and skips the other"
                    seen_name["m:$obj"]="$rel" ;;
                top)
                    [[ "$obj" == "http" ]] || fail "${rel} declares top-level ${obj} — an emitted file declares only http" ;;
            esac
        done < <(awk '
            { sub(/\r$/, "") }
            /^[[:space:]]*(#|$)/ { next }
            /^[^ ]/              { k=$1; sub(/:.*/, "", k); print "top " k; sec=""; cur=""; next }
            /^  [^ ]/            { k=$1; sub(/:.*/, "", k); sec=k; cur=""; print "section " k; next }
            /^    [^ ]/          { k=$1; sub(/:.*/, "", k); cur=k; if (sec != "") print sec " " k; next }
            /^      rule: /      { if (sec == "routers" && cur != "") { v=$0; sub(/^      rule: "/, "", v); sub(/"[[:space:]]*$/, "", v); print "rule " cur " " v }; next }
        ' "$f")
        (( nrouters > 0 )) || fail "${rel} declares no router — an emitted file with no router should not exist"
    done
    return 0
}

host_list() {
    local tf
    if [[ -n "$HOSTS_FILE" ]]; then
        [[ -f "$HOSTS_FILE" ]] || die "hosts file not found: $HOSTS_FILE" 2
        grep -Ev '^[[:space:]]*(#|$)' "$HOSTS_FILE"
        return 0
    fi
    printf '%s\n' "$PLATFORM_DOMAIN" "control.${PLATFORM_DOMAIN}"
    tf="$(gremion_root)/etc/tenant-hosts.txt"
    if [[ -f "$tf" ]]; then
        grep -Ev '^[[:space:]]*(#|$)' "$tf" || true
    fi
}

# The leaf certificate the edge actually presents for <host>, prefixed with a
# "# host=" comment line. openssl skips the preamble; the comment is what lets a
# later `openssl x509 -in` call know which host the PEM came from.
cert_file() {
    local h="$1" f
    f="$(mktemp)"
    {
        printf '# host=%s\n' "$h"
        openssl s_client -servername "$h" \
            -connect "${EDGE_BIND_IP}:${EDGE_HTTPS_PORT}" </dev/null 2>/dev/null || true
    } > "$f"
    printf '%s' "$f"
}

check_cert() {
    local h="$1" f san
    f="$(cert_file "$h")"
    san="$(openssl x509 -in "$f" -noout -ext subjectAltName 2>/dev/null || true)"
    # openssl prints a HEADER line before the entries:
    #     X509v3 Subject Alternative Name:
    #         DNS:a.example.org, DNS:b.example.org
    # Once the whitespace is squeezed out, that header is glued to the FIRST
    # entry ("X509v3SubjectAlternativeName:DNS:a.example.org"), so an exact-line
    # match finds every SAN except the first one. For a single-SAN certificate
    # — the normal case — the check could therefore never pass, and a guard that
    # fails on every correct certificate is a guard somebody turns off. Drop
    # everything up to the last "Name:" to leave the bare entries. (A hostname
    # cannot contain ':', so this cannot eat part of a name.)
    if printf '%s' "$san" | tr -d '[:space:]' | tr ',' '\n' | sed 's/^.*Name://' \
        | grep -qxF "DNS:${h}"; then
        SAN_OK["$h"]=true
    else
        SAN_OK["$h"]=false
        fail "certificate for ${h} has no matching SAN (got: $(printf '%s' "$san" | tr '\n' ' '))"
    fi
    if ! openssl x509 -in "$f" -noout -checkend "$(( CERT_MIN_DAYS * 86400 ))" >/dev/null 2>&1; then
        fail "certificate for ${h} expires within ${CERT_MIN_DAYS} days"
    fi
    rm -f "$f"
}

sha256_of() { sha256sum "$1" | cut -d' ' -f1; }

# F1-FIX-09 (K6#0). `curl -w '%{http_code}'` writes the code ITSELF -- 000 when it
# could not connect -- and ALSO exits non-zero, so the old `... || echo '000'`
# appended a second 000 and a dead endpoint read "000000": neither "000" nor
# >= 400 in arithmetic, i.e. a pass. The status is now taken from curl's own
# output alone (the caller discards the exit status) and normalised here to
# exactly three digits; anything that is not a three-digit code is 000.
http_status() {   # $1 = what curl wrote to stdout
    local raw="${1//[!0-9]/}"
    if (( ${#raw} >= 3 )); then
        printf '%s' "${raw: -3}"
    else
        printf '000'
    fi
}

# -k is deliberate: the certificate is asserted on its own by check_cert, and a
# staging unit presents an internal-CA certificate that this arm must not fail on
# for the wrong reason.
#
# The host-pin universal compares the marker body served for <h> with the body
# served for <h> when the request carries a forged X-Forwarded-Host naming
# another tenant. Equal bytes = the header was ignored = the pin holds. This is
# only meaningful because VERIFY_MARKER_PATH is byte-stable per host (otherwise
# every run would differ) AND differs between hosts (otherwise nothing could ever
# differ). check_marker_discriminates asserts the second property.
check_host_http() {
    local h="$1" other="$2" clean forged code fcode acme
    clean="$(mktemp)"; forged="$(mktemp)"

    code="$(curl -k -sS --max-time "$HTTP_TIMEOUT" \
                --resolve "${h}:${EDGE_HTTPS_PORT}:${EDGE_BIND_IP}" \
                -o "$clean" -w '%{http_code}' \
                "https://${h}:${EDGE_HTTPS_PORT}${VERIFY_MARKER_PATH}" 2>/dev/null || true)"
    code="$(http_status "$code")"
    if [[ "$code" == "000" ]] || (( 10#$code >= 400 )); then
        fail "https://${h}${VERIFY_MARKER_PATH} returned ${code} (expected < 400)"
    elif [[ ! -s "$clean" ]]; then
        fail "https://${h}${VERIFY_MARKER_PATH} returned an empty body"
    fi
    MARKER_SHA["$h"]="$(sha256_of "$clean")"

    fcode="$(curl -k -sS --max-time "$HTTP_TIMEOUT" \
                --resolve "${h}:${EDGE_HTTPS_PORT}:${EDGE_BIND_IP}" \
                -H "X-Forwarded-Host: ${other}" \
                -o "$forged" -w '%{http_code}' \
                "https://${h}:${EDGE_HTTPS_PORT}${VERIFY_MARKER_PATH}" 2>/dev/null || true)"
    fcode="$(http_status "$fcode")"
    if [[ "${MARKER_SHA[$h]}" != "$(sha256_of "$forged")" ]]; then
        fail "host-pin: forged X-Forwarded-Host: ${other} changed the response for ${h} (${code}/${fcode})"
    fi

    acme="$(curl -sS --max-time "$HTTP_TIMEOUT" \
                --resolve "${h}:${EDGE_HTTP_PORT}:${EDGE_BIND_IP}" \
                -o /dev/null -w '%{http_code}' \
                "http://${h}:${EDGE_HTTP_PORT}/.well-known/acme-challenge/probe" 2>/dev/null || true)"
    acme="$(http_status "$acme")"
    [[ "$acme" == "404" ]] \
        || fail "acme-challenge probe for ${h} returned ${acme} (expected 404 from acme-http@internal, never a redirect)"

    rm -f "$clean" "$forged"
}

# A marker endpoint that answers the same bytes for every host makes the host-pin
# comparison unfalsifiable: it would pass with every middleware removed. Refuse
# to report green on evidence that cannot distinguish the two cases.
check_marker_discriminates() {
    local h first="" all_same=1
    (( ${#MARKER_SHA[@]} >= 2 )) || return 0
    for h in "${!MARKER_SHA[@]}"; do
        if [[ -z "$first" ]]; then
            first="${MARKER_SHA[$h]}"
            continue
        fi
        if [[ "${MARKER_SHA[$h]}" != "$first" ]]; then
            all_same=0
            break
        fi
    done
    if (( all_same )); then
        fail "marker path ${VERIFY_MARKER_PATH} returns identical bytes for every host; the host-pin universal cannot fail and proves nothing"
    fi
    return 0
}

check_hosts() {
    local hosts=() i h other
    mapfile -t hosts < <(host_list)
    (( ${#hosts[@]} > 0 )) || die "no hosts to verify" 2
    for (( i = 0; i < ${#hosts[@]}; i++ )); do
        h="${hosts[$i]}"
        if (( ${#hosts[@]} > 1 )); then
            other="${hosts[$(( (i + 1) % ${#hosts[@]} ))]}"
        else
            other="forged.${PLATFORM_DOMAIN}"
        fi
        check_cert "$h"
        check_host_http "$h" "$other"
    done
    check_marker_discriminates
}

# A backend URL names a network ALIAS, not necessarily a container name, and an
# exempt one-shot container has already exited — so `docker ps -a`.
#
# It may also name neither. Traefik's DOCKER provider addresses a container by
# its IP, so every state-tier service discovered from labels arrives here as
# "10.90.1.7", not as a name — and a census that only knew names reported "no
# container answers to '10.90.250.4'" for each of them against the running
# prototype. Addresses are matched as well as names and aliases.
container_for_alias() {
    local want="$1" id name aliases ips
    for id in $(docker ps -a -q 2>/dev/null); do
        name="$(docker inspect --format '{{.Name}}' "$id" 2>/dev/null | sed 's|^/||')"
        if [[ "$name" == "$want" ]]; then
            printf '%s' "$name"
            return 0
        fi
        aliases="$(docker inspect \
            --format '{{range $k, $v := .NetworkSettings.Networks}}{{range $v.Aliases}}{{.}} {{end}}{{end}}' \
            "$id" 2>/dev/null || true)"
        case " $aliases " in
            *" $want "*) printf '%s' "$name"; return 0 ;;
        esac
        ips="$(docker inspect \
            --format '{{range $k, $v := .NetworkSettings.Networks}}{{$v.IPAddress}} {{end}}' \
            "$id" 2>/dev/null || true)"
        case " $ips " in
            *" $want "*) printf '%s' "$name"; return 0 ;;
        esac
    done
    return 1
}

is_exempt() {
    local a="$1" e
    for e in ${HEALTH_EXEMPT_SERVICES:-}; do
        case "$a" in *"$e"*) return 0 ;; esac
    done
    return 1
}

check_container_health() {
    local c="$1" alias="$2" sname="$3" status health code
    status="$(docker inspect --format '{{.State.Status}}' "$c" 2>/dev/null || echo unknown)"
    health="$(docker inspect \
        --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' \
        "$c" 2>/dev/null || echo none)"

    if is_exempt "$alias"; then
        code="$(docker inspect --format '{{.State.ExitCode}}' "$c" 2>/dev/null || echo 1)"
        if [[ "$status" == "exited" && "$code" == "0" ]]; then
            ok "exempt container ${c} exited 0"
        else
            SERVICE_HEALTHY["$sname"]=false
            fail "exempt container ${c}: status=${status} exit=${code} (expected exited 0)"
        fi
        return 0
    fi

    if [[ "$health" == "healthy" ]]; then
        ok "container ${c} healthy"
    else
        SERVICE_HEALTHY["$sname"]=false
        fail "container ${c} (${alias}): health=${health} status=${status} (expected healthy)"
    fi
}

check_containers() {
    local sname servers url hostpart cname
    for sname in "${!SERVICES_TO_CHECK[@]}"; do
        case "$sname" in *@internal) continue ;; esac
        SERVICE_HEALTHY["$sname"]=true
        servers="$(printf '%s' "$SERVICES_JSON" \
            | jq -r --arg n "$sname" '.[] | select(.name == $n) | .loadBalancer.servers // [] | .[].url')"
        if [[ -z "$servers" ]]; then
            SERVICE_HEALTHY["$sname"]=false
            fail "service ${sname} has no servers"
            continue
        fi
        for url in $servers; do
            hostpart="${url#*://}"
            hostpart="${hostpart%%/*}"
            hostpart="${hostpart%%:*}"
            if ! cname="$(container_for_alias "$hostpart")"; then
                SERVICE_HEALTHY["$sname"]=false
                fail "service ${sname}: no container answers to '${hostpart}'"
                continue
            fi
            check_container_health "$cname" "$hostpart" "$sname"
        done
    done
}

build_rows() {
    local name cls host svc healthy san
    for name in "${!ROUTER_CLASS[@]}"; do
        cls="${ROUTER_CLASS[$name]}"
        host="${ROUTER_HOST[$name]:-}"
        svc="${ROUTER_SERVICE[$name]:-}"
        healthy="${SERVICE_HEALTHY[$svc]:-null}"
        san="${SAN_OK[$host]:-null}"
        ROUTER_ROWS+=("$(jq -nc \
            --arg name "$name" --arg class "$cls" --arg host "$host" \
            --argjson san "$san" --argjson healthy "$healthy" \
            '{name: $name, class: $class, host: $host, san: $san, healthy: $healthy}')")
    done
}

write_report() {
    local ts okflag rows fjson
    ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if (( ${#FAILURES[@]} == 0 )); then
        okflag=true
        fjson='[]'
    else
        okflag=false
        fjson="$(printf '%s\n' "${FAILURES[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')"
    fi
    if (( ${#ROUTER_ROWS[@]} == 0 )); then
        rows='[]'
    else
        rows="$(printf '%s\n' "${ROUTER_ROWS[@]}" | jq -sc '.')"
    fi
    jq -nc --arg ts "$ts" --argjson ok "$okflag" \
           --argjson routers "$rows" --argjson failures "$fjson" \
           --argjson waivers "$(waivers_json)" \
        '{ts: $ts, ok: $ok, routers: $routers, failures: $failures, waivers: $waivers}' \
        | atomic_write "$(gremion_root)/runtime/last-verify.json" 0644
}

# Everything here is read from INSIDE the new colour's own container: the env the
# process actually has and the names its resolver actually answers. A compose file
# saying the right thing is not evidence (§E).
check_colour() {
    local c="$1" want_url observed code ui leaf bad_urls
    want_url="http://gremion-ui-${c}:3000"

    observed="$(printf '%s' "$SERVICES_JSON" \
        | jq -r '.[] | select(.name == "app-next@file") | .loadBalancer.servers[0].url // ""')"
    [[ "$observed" == "$want_url" ]] \
        || fail "app-next@file points at '${observed:-none}' (expected ${want_url})"

    code="$(curl -sS --max-time "$HTTP_TIMEOUT" -H "Host: ${PLATFORM_DOMAIN}" \
                -o /dev/null -w '%{http_code}' \
                "http://127.0.0.1:${INTERNALTEST_PORT}${VERIFY_MARKER_PATH}" 2>/dev/null || true)"
    code="$(http_status "$code")"
    if [[ "$code" == "000" ]] || (( 10#$code >= 400 )); then
        fail "internaltest entrypoint returned ${code} for ${PLATFORM_DOMAIN} (expected < 400)"
    fi

    if ! ui="$(container_for_alias "gremion-ui-${c}")"; then
        fail "gremion-ui-${c}: no container"
        return 0
    fi

    docker exec "$ui" env 2>/dev/null | grep -qx "INTERNAL_BASE_URL=${want_url}" \
        || fail "${ui}: INTERNAL_BASE_URL is not ${want_url}"

    for leaf in $GREMION_LEAVES; do
        docker exec "$ui" getent hosts "${leaf}-service-${c}" >/dev/null 2>&1 \
            || fail "${ui}: ${leaf}-service-${c} does not resolve"
    done

    bad_urls="$(docker exec "$ui" env 2>/dev/null \
        | grep -E '_(SERVICE_URL|BASE_URL)=' | grep -F "$PLATFORM_DOMAIN" || true)"
    [[ -z "$bad_urls" ]] \
        || fail "${ui}: internal URL names the public domain: $(printf '%s' "$bad_urls" | tr '\n' ' ')"
}

# --- the reboot gate (spec A section F.8) --------------------------------
# Runs from gremion-verify.service after docker.service on every boot. It
# re-invokes THIS program at its installed path without --reboot, so the gate
# and the release procedure verify by exactly the same contract.

reboot_alert() {
    local ok_flag="$1" restarted="$2" detail="$3" url="${ALERT_WEBHOOK_URL:-}" payload
    # The detail can now carry the verifier's own message (see reboot_gate), and
    # that is free text: one quote, backslash or control byte in it produces a
    # payload that is not JSON, and the receiver drops the alert instead of
    # showing it. Control bytes go first, then the two characters JSON escapes -
    # backslashes before quotes, or the escape added for a quote is escaped again.
    detail="$(printf '%s' "$detail" | tr -d '\000-\037')"
    detail="${detail//\\/\\\\}"
    detail="${detail//\"/\\\"}"
    payload="$(printf '{"event":"reboot-gate","ok":%s,"restarted":%s,"detail":"%s"}' \
        "$ok_flag" "$restarted" "$detail")"
    if [[ -z "$url" ]]; then
        bad "ALERT_WEBHOOK_URL is empty - reboot-gate result not delivered: ok=${ok_flag} ${detail}"
        return 0
    fi
    # The payload travels in argv, not on stdin. `--data-binary @-` would leave
    # nothing to observe but the URL, and what this gate reported is precisely
    # the thing worth being able to read back.
    curl -sS --max-time 15 -X POST -H 'Content-Type: application/json' \
        --data "$payload" "$url" >/dev/null \
        || bad "alert POST to the webhook failed"
}

# systemd hands the gate only GREMION_ROOT, so ALERT_WEBHOOK_URL is absent from
# the environment on a real boot. Read it from the file that declares it rather
# than posting nowhere and calling that "alerted". A whole load_env is wrong
# here: ops.env legitimately carries CHANGE_ME_ sentinels before the operator
# has finished, and refusing to run the gate over that would be worse than
# running it with no webhook.
resolve_alert_webhook() {
    local ops_env="$1/etc/env/ops.env" value
    [[ -z "${ALERT_WEBHOOK_URL:-}" ]] || return 0
    [[ -f "$ops_env" ]] || return 0
    value="$(sed -n 's/^ALERT_WEBHOOK_URL=//p' "$ops_env" | head -n1 | tr -d '\r')"
    value="${value%\"}"
    value="${value#\"}"
    if [[ "$value" == CHANGE_ME_* ]]; then
        value=""
    fi
    ALERT_WEBHOOK_URL="$value"
    export ALERT_WEBHOOK_URL
}

wait_for_docker() {
    local tries="${REBOOT_GATE_DOCKER_TRIES:-60}" wait="${REBOOT_GATE_DOCKER_WAIT:-2}" i
    for (( i = 0; i < tries; i++ )); do
        if docker info >/dev/null 2>&1; then return 0; fi
        sleep "$wait"
    done
    return 1
}

# The installed verifier is the contract. When it is not installed - a release
# checkout, a staging root, this suite - verify in-process rather than report a
# green gate on a verification that never ran.
# The last thing the child verifier said. A precondition failure names the file
# or the key that is missing, and that sentence IS the diagnosis; reboot_alert's
# detail used to be a fixed string, so it never travelled.
CHILD_VERIFY_LAST=""

run_child_verify() {
    local child out rc=0
    child="$(gremion_root)/bin/gremion-verify"
    if [[ -x "$child" ]]; then
        out="$("$child" 2>&1)" || rc=$?
    else
        info "no installed verifier at ${child}; verifying in this process"
        # A subshell on purpose: run_pass can die() on a missing precondition,
        # and a die in THIS shell would end the reboot gate before it alerted
        # anyone. Only the status and the output have to come back.
        out="$( { prepare_verify && run_pass; } 2>&1 )" || rc=$?
    fi
    [[ -z "$out" ]] || printf '%s\n' "$out"
    CHILD_VERIFY_LAST="$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | tail -n 1 || true)"
    return "$rc"
}

reboot_gate() {
    [[ "${GREMION_IN_REBOOT_GATE:-0}" != "1" ]] \
        || die "refusing to nest --reboot inside a reboot gate" 2
    export GREMION_IN_REBOOT_GATE=1
    need_cmd docker curl

    local root colour
    root="$(gremion_root)"
    resolve_alert_webhook "$root"

    if ! wait_for_docker; then
        reboot_alert false 0 "docker did not answer after boot"
        die "docker unavailable" 2
    fi

    local rc=0
    run_child_verify || rc=$?
    if (( rc == 0 )); then
        echo "REBOOT-GATE: verify=pass restarted=0"
        reboot_alert true 0 "verify green on the first pass after boot"
        return 0
    fi

    # Exit 2 is "could not verify", not "the application is broken". Restarting
    # forty containers cannot make an absent file or an unset key appear, and
    # the alert for the restart path says "still failing after one restart of
    # app-<colour>", which sends the operator after an application outage that
    # is not happening. Reachable for real: a rollback to a release tree that
    # carries no waiver ledger, since the INSTALLED verifier is not versioned
    # with the release tree whose docs/ it reads.
    if (( rc == 2 )); then
        echo "REBOOT-GATE: verify=precondition-failure restarted=0"
        reboot_alert false 0 "verify could not run (exit 2): ${CHILD_VERIFY_LAST:-no message}"
        return 1
    fi

    colour="$(cat "$root/runtime/active-colour" 2>/dev/null || echo none)"
    if [[ "$colour" != "blue" && "$colour" != "green" ]]; then
        echo "REBOOT-GATE: verify=fail restarted=0"
        reboot_alert false 0 "verify failed and active-colour is '${colour}' - nothing to restart"
        return 1
    fi

    # EXACTLY ONCE. Forty containers coming up together beat each other to the
    # database; an unbounded restart loop after a genuinely bad boot is worse
    # than a red alert, because it hides the boot that caused it.
    bad "verify failed after boot - restarting the ${colour} app project once"
    docker compose --env-file "$root/etc/env/app-${colour}.env" restart \
        || bad "compose restart returned non-zero; re-verifying anyway"
    sleep "${REBOOT_GATE_SETTLE_SECONDS:-${REBOOT_SETTLE_SECONDS:-30}}"

    if run_child_verify; then
        echo "REBOOT-GATE: verify=pass restarted=1"
        reboot_alert true 1 "recovered after one restart of app-${colour}"
        return 0
    fi
    echo "REBOOT-GATE: verify=fail restarted=1"
    reboot_alert false 1 "still failing after one restart of app-${colour}"
    return 1
}

run_pass() {
    FAILURES=(); ROUTER_ROWS=()
    ROUTER_CLASS=(); ROUTER_HOST=(); ROUTER_SERVICE=()
    SERVICES_TO_CHECK=(); SERVICE_HEALTHY=(); SAN_OK=(); MARKER_SHA=()
    load_waivers
    fetch_api
    check_routers
    check_router_universal
    check_l4_routers
    check_emitted_routers
    check_middleware_placement
    check_hosts
    check_containers
    [[ -z "$COLOUR" ]] || check_colour "$COLOUR"
    build_rows
    print_waivers
    write_report
    (( ${#FAILURES[@]} == 0 ))
}

# Everything the verification pass needs before it can read the running system.
# Split out of main so the reboot gate can reach it when there is no installed
# verifier to re-invoke.
prepare_verify() {
    need_cmd curl jq openssl docker sha256sum
    load_env "$(gremion_root)/etc/env/state.env"
    VERIFY_MARKER_PATH="${VERIFY_MARKER_PATH_OVERRIDE:-${VERIFY_MARKER_PATH:-/healthz}}"
    local k
    for k in PLATFORM_DOMAIN EDGE_BIND_IP EDGE_HTTP_PORT EDGE_HTTPS_PORT; do
        [[ -n "${!k:-}" ]] || die "$k is not set in etc/env/state.env" 2
    done
}

main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --colour) COLOUR="${2:-}"; shift 2 ;;
            --hosts)  HOSTS_FILE="${2:-}"; shift 2 ;;
            --reboot) REBOOT=1; shift ;;
            -h|--help) usage ;;
            *) bad "unknown argument: $1"; usage ;;
        esac
    done
    [[ -z "$COLOUR" || "$COLOUR" == "blue" || "$COLOUR" == "green" ]] \
        || { bad "--colour must be blue or green"; usage; }

    # The gate runs BEFORE the pre-flight: it re-invokes the installed verifier,
    # which does its own load_env, and a gate that died on a missing state.env
    # could never report why the boot was bad.
    if (( REBOOT )); then
        local rc=0
        reboot_gate || rc=$?
        exit "$rc"
    fi

    prepare_verify

    if run_pass; then
        ok "gremion-verify: all checks passed"
        exit 0
    fi
    bad "gremion-verify: ${#FAILURES[@]} failure(s)"
    exit 1
}

main "$@"
