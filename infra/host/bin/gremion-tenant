#!/usr/bin/env bash
set -euo pipefail
#
# gremion-tenant — host BOOTSTRAP and the break-glass of the customer
# lifecycle (TASK-043; since D R31-I4 / TASK-043d NOT an operator surface for
# customers: the control panel creates and operates them through the
# host-side executor, infra/host/bin/gremion-executor).
#
#   gremion-tenant init [--realm-only] [--panel-origin <origin>]
#   gremion-tenant init --realm-only --keycloak-container <name> [--panel-origin <origin>]
#   gremion-tenant panel
#   gremion-tenant operator add <email> [--no-mail]
#   gremion-tenant operator add <email> --no-mail --keycloak-container <name>
#   gremion-tenant request <kind> --args-file <0600 json> --operator <uuid> --reason <text>
#   gremion-tenant requests [--slug <slug>]
#
# `create` is DECOMMISSIONED (exit 2, nothing written): a customer is created
# in the panel ("Neuer Mandant"); with the panel down, `request create` puts
# the SAME request into the SAME queue (origin=host, with the reason and the
# invoking login user, audited), and the executor runs it exactly as a panel
# request (D10: move, do not duplicate; customer-ops.sh holds the code).
# The suspend/resume/reconcile/status verbs below retire the same way with the
# panel's customer screens (TASK-043d-2).
#
# suspend: container first (status, realm disabled + notBefore + logout,
# broker users evicted), then the principal revoked (the realm's sender is
# emptied before the principal is deleted; a failed suspend is recovered by
# rerunning it, TASK-043c). resume: a FRESH
# principal issued and stamped first, then the container (realm, broker,
# status last).
#
# SECRETS never reach an argv: the app passwords, admin URLs and the
# provisioner credential tenant-create reads are 0600 files under
# etc/secrets/tenant-create (written by `init`; mounted read-only),
# the Keycloak admin password reaches kcadm through a name-only `-e`, and the
# vendor mail principal's password never leaves gremion-vendor-mail.
#
# EXIT CODES: 0 ok - 1 a step or post-condition failed - 2 usage/precondition.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

umask 077

# The customer functions live in the library the executor's handlers call
# (D10: moved, not duplicated): env_key, active_colour, need_slug,
# need_operator, token_of, need_value, tc, vendor_mail, load_host_facts,
# container_fingerprint, write_router, customer_create.
# shellcheck source=../lib/customer-ops.sh
. "$SCRIPT_DIR/../lib/customer-ops.sh"
# shellcheck source=../lib/executor/db.sh
. "$SCRIPT_DIR/../lib/executor/db.sh"

MODULE_SERVERS="board calendar content finance newsletter vault"
KCADM_BIN="/opt/keycloak/bin/kcadm.sh"
KC_SERVER="http://127.0.0.1:8080/auth"
REQUEST_KINDS_RE='^(create|suspend|resume|reconcile|enable_module|disable_module|import_members|seed_vertical|record_dpia|import_isolation)$'
DECOMMISSIONED="decommissioned as an operator surface (R31-I4): use the control panel; break-glass: gremion-tenant request <kind> --args-file <file> --operator <uuid> --reason <text>"

usage() {
    cat <<'EOF'
usage: gremion-tenant <verb> [args...]
  init [--realm-only] [--panel-origin <origin>]
  init --realm-only --keycloak-container <name> [--panel-origin <origin>]
  panel
  operator add <email> [--no-mail]
  operator add <email> --no-mail --keycloak-container <name>
  request <kind> --args-file <0600 json> --operator <uuid> --reason <text>
  requests [--slug <slug>]
Customers are created and operated in the control panel (gremion-tenant
panel prints the access line); the break-glass `request` puts the same
request into the same queue the host-side executor runs (R31-I4).
EOF
}

# ── init ───────────────────────────────────────────────────────────────────
# write_secret <file> — stdin to a 0600 file, atomically; kept when present.
write_secret() {
    local f="$1"
    if [[ -s "$f" ]]; then cat > /dev/null; return 0; fi
    atomic_write "$f" 600
}

# The admin URLs and app passwords tenant-create reads (G3), from state.env.
render_tenant_create_secrets() {
    local dir="${ROOT}/etc/secrets/tenant-create" state="${ROOT}/etc/env/state.env" id up user pw
    mkdir -p "$dir"
    chmod 700 "$dir"
    user="$(env_key "$state" POSTGRES_USER)"; user="${user:-postgres}"
    pw="$(env_key "$state" POSTGRES_PASSWORD)"
    [[ -n "$pw" ]] || die "POSTGRES_PASSWORD is empty in ${state}" "$GREMION_EXIT_USAGE"
    rm -f "${dir}/kernel_pg_admin"
    printf 'postgresql://%s:%s@postgres-%s:5432/postgres\n' "$user" "$pw" "$STACK" | write_secret "${dir}/kernel_pg_admin"
    for id in $MODULE_SERVERS; do
        up="$(printf '%s' "$id" | tr '[:lower:]' '[:upper:]')"
        user="$(env_key "$state" "${up}_PG_USER")"; user="${user:-$id}"
        pw="$(env_key "$state" "${up}_PG_PASSWORD")"
        [[ -n "$pw" ]] || die "${up}_PG_PASSWORD is empty in ${state}" "$GREMION_EXIT_USAGE"
        rm -f "${dir}/module_pg_admin_${id}"
        # A module server has no stack alias: its service name resolves on ${STACK}_state.
        printf 'postgresql://%s:%s@%s-postgres:5432/postgres\n' "$user" "$pw" "$id" | write_secret "${dir}/module_pg_admin_${id}"
        openssl rand -hex 32 | write_secret "${dir}/module_app_password_${id}"
    done
    pw=""
    ok "etc/secrets/tenant-create: kernel and $(wc -w <<< "$MODULE_SERVERS") module server credential file(s), 0600"
}

render_panel_secrets() {
    local dir="${ROOT}/etc/secrets/control-panel"
    mkdir -p "$dir"
    chmod 700 "$dir"
    openssl rand -hex 32 | write_secret "${dir}/auth_secret"
}

# TASK-043b F1: the least-privilege provisioner credential (master SA
# tenant-provisioner, create-realm only) that every tenant-create verb reads as
# TENANT_PROVISIONER_SECRET_FILE=/run/secrets/tenant-create/tenant_provisioner,
# from the READ-ONLY etc/secrets/tenant-create mount. Kept when present. Absent:
# `bootstrap-provisioner` runs ONCE in the one-shot against a private 0700
# scratch directory (the only writable mount it gets), and the secret moves
# into etc/secrets/tenant-create, 0600. The Keycloak admin credential is used for
# that call only and reaches the container through a name-only -e (from the
# caller's environment, else state.env), never an argv.
ensure_provisioner_credential() {
    local dir="${ROOT}/etc/secrets/tenant-create" state="${ROOT}/etc/env/state.env" out admin password
    local file="${dir}/tenant_provisioner"
    mkdir -p "$dir"
    chmod 700 "$dir"
    if [[ -s "$file" ]]; then
        ok "etc/secrets/tenant-create/tenant_provisioner present (the provisioner is bootstrapped)"
        return 0
    fi
    admin="${KEYCLOAK_ADMIN:-}"
    password="${KEYCLOAK_ADMIN_PASSWORD:-}"
    [[ -n "$admin" ]] || admin="$(env_key "$state" KEYCLOAK_ADMIN)"
    [[ -n "$password" ]] || password="$(env_key "$state" KEYCLOAK_ADMIN_PASSWORD)"
    [[ -n "$admin" && -n "$password" ]] \
        || die "the provisioner credential is absent and KEYCLOAK_ADMIN/KEYCLOAK_ADMIN_PASSWORD are unset (neither exported nor in ${state}): bootstrap-provisioner cannot run" "$GREMION_EXIT_USAGE"
    out="$(mktemp -d "${ROOT}/etc/secrets/.tenant-provisioner.XXXXXX")" \
        || die "could not create the bootstrap-provisioner scratch directory under ${ROOT}/etc/secrets" "$GREMION_EXIT_ASSERT"
    # The scratch directory holds the SA secret once the one-shot has written
    # it: an interrupt (INT/TERM) or any exit before the move removes it.
    # shellcheck disable=SC2064  # expand $out now
    trap "rm -rf '${out}'" EXIT
    # shellcheck disable=SC2064
    trap "rm -rf '${out}'; exit 130" INT
    # shellcheck disable=SC2064
    trap "rm -rf '${out}'; exit 143" TERM
    chmod 700 "$out"
    TC_MOUNT=(-v "$(realpath "$out"):/run/secrets/provisioner-out"
              -e TENANT_PROVISIONER_SECRET_FILE=/run/secrets/provisioner-out/tenant_provisioner
              -e KEYCLOAK_ADMIN -e KEYCLOAK_ADMIN_PASSWORD)
    # A prefix assignment on a function call: in tc's (and so docker's)
    # environment for this one call, gone afterwards.
    if ! KEYCLOAK_ADMIN="$admin" KEYCLOAK_ADMIN_PASSWORD="$password" tc bootstrap-provisioner; then
        TC_MOUNT=(); password=""; rm -rf "$out"
        die "tenant-create bootstrap-provisioner failed: no provisioner credential was written" "$GREMION_EXIT_ASSERT"
    fi
    TC_MOUNT=()
    password=""
    if [[ ! -s "${out}/tenant_provisioner" ]]; then
        rm -rf "$out"
        die "bootstrap-provisioner exited 0 but wrote no credential into its scratch directory" "$GREMION_EXIT_ASSERT"
    fi
    atomic_write "$file" 600 < "${out}/tenant_provisioner"
    rm -rf "$out"
    trap - EXIT INT TERM
    [[ -s "$file" ]] || die "etc/secrets/tenant-create/tenant_provisioner is empty after the move" "$GREMION_EXIT_ASSERT"
    ok "provisioner bootstrapped: its credential is in etc/secrets/tenant-create/tenant_provisioner (0600)"
}

# init --realm-only --keycloak-container <c>: the ops realm created by kcadm in
# an EXISTING Keycloak (a host without the pooled stack, §11). Create
# when absent, skip when equal (the template fingerprint on the realm),
# fail when different; the client secret goes to a 0600 file, never stdout.
# kcadm_login <container> — kcadm's master session in an EXISTING Keycloak
# container; the admin password reaches it through a name-only -e.
kcadm_login() {
    local kc="$1" admin password
    admin="${KEYCLOAK_ADMIN:-}"
    password="${KEYCLOAK_ADMIN_PASSWORD:-}"
    [[ -n "$admin" && -n "$password" ]] || die "export KEYCLOAK_ADMIN and KEYCLOAK_ADMIN_PASSWORD for kcadm (they reach it through a name-only -e)" "$GREMION_EXIT_USAGE"
    KC_LOGIN_PASSWORD="$password" docker exec -e KC_LOGIN_PASSWORD "$kc" sh -c \
        '"$0" config credentials --server "$1" --realm master --user "$2" --password "$KC_LOGIN_PASSWORD" >/dev/null' \
        "$KCADM_BIN" "${KC_SERVER_URL:-$KC_SERVER}" "$admin" \
        || die "kcadm could not authenticate in container ${kc}" "$GREMION_EXIT_ASSERT"
    password=""
}

init_realm_only_kcadm() {   # <container> <origin>
    local kc="$1" origin="$2" tmpl fp have secret secret_file
    need_cmd docker jq openssl sha256sum
    tmpl="${RELEASE_DIR}/docker/keycloak/realm-export.ops.json"
    [[ -f "$tmpl" ]] || die "the ops realm template is absent: ${tmpl}" "$GREMION_EXIT_USAGE"
    kcadm_login "$kc"
    fp="$( { cat "$tmpl"; printf '\n%s' "$origin"; } | sha256sum | cut -d' ' -f1)"
    # 'attributes(*)': a bare `--fields attributes` returns the map EMPTY
    # (measured on Keycloak 26.6), so an equal realm would read as different.
    # Only a NOT-FOUND is "absent" (review C, r2): a transient Keycloak or
    # network error, or an expired session, must never be read as absent --
    # that path replaced the working client secret before create failed 409.
    local err rc=0
    err="$(mktemp)"
    have="$(docker exec "$kc" "$KCADM_BIN" get realms/platform --fields 'attributes(*)' 2>"$err")" || rc=$?
    if (( rc == 0 )); then
        rm -f "$err"
        if [[ "$(jq -r '.attributes["gremion.ops-realm.sha256"] // ""' <<< "$have" | tr -d '\r')" == "$fp" ]]; then
            [[ -s "${ROOT}/etc/secrets/control-panel/client_secret" ]] \
                || die "realm platform is present and equal, but etc/secrets/control-panel/client_secret is missing: regenerate the control-panel client's secret in Keycloak and write it there (0600)" "$GREMION_EXIT_ASSERT"
            # TASK-039: the grafana client's secret (compose/observability).
            [[ -s "${ROOT}/etc/secrets/grafana/client_secret" ]] \
                || die "realm platform is present and equal, but etc/secrets/grafana/client_secret is missing: regenerate the grafana client's secret in Keycloak and write it there (0600)" "$GREMION_EXIT_ASSERT"
            ok "realm platform is present and equal to realm-export.ops.json for ${origin}"
            return 0
        fi
        die "realm platform exists but differs from realm-export.ops.json for ${origin}: refusing to overwrite an ops realm" "$GREMION_EXIT_ASSERT"
    fi
    if ! grep -qiE 'not found|404' "$err"; then
        local why; why="$(tr -d '\r' < "$err" | tail -n 3 | tr '\n' ' ')"; rm -f "$err"
        die "kcadm could not read realm platform (exit ${rc}: ${why:-no message}); it is not known to be absent, so nothing was created or rotated" "$GREMION_EXIT_ASSERT"
    fi
    rm -f "$err"
    secret_file="${ROOT}/etc/secrets/control-panel/client_secret"
    mkdir -p "$(dirname "$secret_file")"
    chmod 700 "$(dirname "$secret_file")"
    secret="$(openssl rand -hex 32 | tr -d '\r\n')"
    # TASK-039: the grafana client's secret, generated here like the panel's.
    local gsecret gsecret_file="${ROOT}/etc/secrets/grafana/client_secret"
    gsecret="$(openssl rand -hex 32 | tr -d '\r\n')"
    OPS_CLIENT_SECRET="$secret" GRAFANA_CLIENT_SECRET="$gsecret" jq -c --arg origin "$origin" --arg fp "$fp" '
        (.clients[] | select(.clientId == "control-panel")) |= (
            .secret = $ENV.OPS_CLIENT_SECRET
            | .redirectUris = [$origin + "/*"]
            | .webOrigins = [$origin]
            | .attributes["post.logout.redirect.uris"] = ($origin + "/*"))
        | (.clients[] | select(.clientId == "grafana")) |= (.secret = $ENV.GRAFANA_CLIENT_SECRET)
        | .attributes["gremion.ops-realm.sha256"] = $fp' "$tmpl" \
        | docker exec -i "$kc" "$KCADM_BIN" create realms -f - >/dev/null \
        || { secret=""; gsecret=""; die "kcadm refused to create realm platform (the client secret files were not touched)" "$GREMION_EXIT_ASSERT"; }
    docker exec "$kc" "$KCADM_BIN" get realms/platform --fields realm >/dev/null \
        || { secret=""; gsecret=""; die "realm platform is absent after create (the client secret files were not touched)" "$GREMION_EXIT_ASSERT"; }
    # Written only now: after create AND the read-back succeeded.
    printf '%s\n' "$secret" | atomic_write "$secret_file" 600
    secret=""
    mkdir -p "$(dirname "$gsecret_file")"
    chmod 700 "$(dirname "$gsecret_file")"
    printf '%s\n' "$gsecret" | atomic_write "$gsecret_file" 600
    gsecret=""
    ok "realm platform created; the control-panel client secret is in ${secret_file}, the grafana client secret in ${gsecret_file} (0600)"
}

cmd_init() {
    local realm_only=no origin="http://127.0.0.1:3043" kc=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --realm-only) realm_only=yes; shift ;;
            --panel-origin) [[ $# -ge 2 ]] || die "--panel-origin requires a value" "$GREMION_EXIT_USAGE"; origin="$2"; shift 2 ;;
            --keycloak-container) [[ $# -ge 2 ]] || die "--keycloak-container requires a value" "$GREMION_EXIT_USAGE"; kc="$2"; shift 2 ;;
            *) usage >&2; die "init: unknown argument: $1" "$GREMION_EXIT_USAGE" ;;
        esac
    done
    [[ "$origin" =~ ^https?://[a-z0-9.-]+(:[0-9]+)?$ ]] || die "--panel-origin must be scheme://host[:port], no path, no wildcard" "$GREMION_EXIT_USAGE"
    if [[ -n "$kc" ]]; then
        [[ "$realm_only" == yes ]] || die "--keycloak-container is the --realm-only path (a host without the pooled stack)" "$GREMION_EXIT_USAGE"
        init_realm_only_kcadm "$kc" "$origin"
        return
    fi
    active_colour
    local state="${ROOT}/etc/env/state.env"
    STACK="$(env_key "$state" STACK)"
    [[ -n "$STACK" ]] || die "STACK is empty in ${state}" "$GREMION_EXIT_USAGE"
    render_panel_secrets
    local -a args=(init --panel-origin "$origin")
    if [[ "$realm_only" == yes ]]; then
        args+=(--realm-only)
    else
        render_tenant_create_secrets
    fi
    # Both arms: the container's init creates the ops realm AS the provisioner.
    ensure_provisioner_credential
    tc "${args[@]}" || die "tenant-create ${args[*]} failed" "$GREMION_EXIT_ASSERT"
    # The container wrote the control-panel client secret beside the tenant
    # secrets; it moves to the panel's own directory, 0600.
    local tsd src
    tsd="$(env_key "${ROOT}/etc/env/app-${COLOUR}.env" TENANT_SECRETS_DIR)"
    tsd="${tsd:-${RELEASE_DIR}/secrets/tenants}"
    # compose resolves a relative bind source against the project directory
    # (the release), never the operator's cwd (review C, r2)
    [[ "$tsd" == /* || "$tsd" =~ ^[A-Za-z]:[/\\] ]] || tsd="${RELEASE_DIR}/${tsd#./}"
    src="${tsd}/platform_client_control-panel"
    if [[ -s "$src" ]]; then
        atomic_write "${ROOT}/etc/secrets/control-panel/client_secret" 600 < "$src"
        rm -f "$src"
    fi
    # The post-condition, never silent: after init the ops realm exists, so
    # the panel's client secret must be in place (moved now or on a past run).
    [[ -s "${ROOT}/etc/secrets/control-panel/client_secret" ]] \
        || die "init: the control-panel client secret is not at etc/secrets/control-panel/client_secret (looked for ${src}); the panel cannot sign in" "$GREMION_EXIT_ASSERT"
    if [[ -f "${ROOT}/etc/env/mail.env" ]]; then
        mail_realm_smtp --realm platform || die "the ops realm's sender could not be set (gremion-mail realm-smtp --realm platform)" "$GREMION_EXIT_ASSERT"
    else
        info "WARNING: no mail.env on this host: the ops realm has no sender; add operators with --no-mail (Q23)"
    fi
    # TASK-039: on this path tenant-create creates the ops realm from the
    # template, so Keycloak generates the grafana client's secret; the ops
    # project reads it from etc/secrets/grafana.
    [[ -s "${ROOT}/etc/secrets/grafana/client_secret" ]] \
        || info "NOTE: etc/secrets/grafana/client_secret is absent: Grafana (compose/observability) signs nobody in until the grafana client's secret is read with kcadm and written there, 0600 (compose/observability/README.md, Access, block A)"
    # The executor needs gremion_platform and its role, which this init just
    # made: this is where bootstrap's enabled-but-not-started unit is started.
    executor_unit_action restart
    ok "init done"
}

# ── break-glass: the SAME queue as the panel (D10) ─────────────────────────
# request <kind> --args-file <0600 json> --operator <uuid> --reason <text>
# One row origin=host through plt.submit_provisioning_request as the executor
# role, with the reason and the invoking login user (host_actor); the
# executor claims and verifies it like any panel request (the operator is
# re-read in the ops realm; no signed sign-in exists here, so the reason is
# the evidence). Never a direct SQL insert, never a container verb by hand.
cmd_request() {
    local kind="${1:-}"; shift || true
    [[ "$kind" =~ $REQUEST_KINDS_RE ]] || die "request <kind>: one of create, suspend, resume, reconcile, enable_module, disable_module, import_members, seed_vertical, record_dpia, import_isolation" "$GREMION_EXIT_USAGE"
    local file="" reason="" slug actor key id args_literal
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --args-file) need_value "$@"; file="$2"; shift 2 ;;
            --operator) need_value "$@"; OPERATOR_ID="$2"; shift 2 ;;
            --reason) [[ $# -ge 2 && -n "$2" ]] || die "--reason requires a value" "$GREMION_EXIT_USAGE"; reason="$2"; shift 2 ;;
            *) die "request: unknown argument: $1" "$GREMION_EXIT_USAGE" ;;
        esac
    done
    need_operator
    [[ ${#reason} -ge 10 && ${#reason} -le 500 ]] || die "request needs --reason <10 to 500 characters>: why the panel is not used (it is audited)" "$GREMION_EXIT_USAGE"
    [[ -n "$file" && -f "$file" ]] || die "request needs --args-file <an existing JSON file>" "$GREMION_EXIT_USAGE"
    if fs_carries_modes "$(dirname "$file")"; then
        [[ "$(stat -c '%a' "$file")" == 600 ]] || die "--args-file ${file} must be mode 0600 (it names the customer's administrators)" "$GREMION_EXIT_USAGE"
    fi
    jq -e 'type == "object"' "$file" >/dev/null 2>&1 || die "--args-file ${file} is not a JSON object" "$GREMION_EXIT_USAGE"
    slug="$(jq -r '.slug // empty' "$file")"
    need_slug "$slug"
    actor="$(printf '%s' "${SUDO_USER:-$(id -un)}" | tr '[:upper:]' '[:lower:]')"
    [[ "$actor" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "the invoking login user '${actor}' is not a plain user name" "$GREMION_EXIT_USAGE"
    key="$(openssl rand -hex 16 | tr -d '\r\n')"
    key="${key:0:8}-${key:8:4}-4${key:13:3}-8${key:17:3}-${key:20:12}"
    # The args (a member list: up to 1 MiB, names and addresses) go on psql's STDIN as a
    # dollar-quoted literal inside the SQL, never as `-v args=...`: that is a `docker exec`
    # argv, capped at 128 KiB per argument (E2BIG) and readable by every local user in the
    # process table (house review MED 1).
    args_literal="$(sql_jsonb_literal "$(jq -c . "$file")")" || die "could not quote the request args" "$GREMION_EXIT_ASSERT"
    id="$(executor_sql "SELECT plt.submit_provisioning_request(:'kind', :'slug', ${args_literal}, :'key'::uuid, :'op'::uuid, NULL, NULL, NULL, NULL, :'reason', :'actor');" \
            -v kind="$kind" -v slug="$slug" -v key="$key" -v op="$OPERATOR_ID" -v reason="$reason" -v actor="$actor")" \
        || die "the break-glass request was refused by gremion_platform (see above); nothing was queued" "$GREMION_EXIT_ASSERT"
    id="${id%%$'\n'*}"
    id="${id%$'\r'}"
    [[ "$id" =~ ^[0-9a-f-]{36}$ ]] || die "the break-glass request returned no request id" "$GREMION_EXIT_ASSERT"
    ok "request ${id} queued: ${kind} ${slug} (origin host, by ${actor}); the executor runs it -- gremion-tenant requests --slug ${slug}"
    printf '%s\n' "$id"
}

# requests [--slug <s>] — read-only: the queue as the panel's status view
# shows it (never the evidence token), newest first, read as the state
# server's POSTGRES_USER over the local socket.
cmd_requests() {
    local slug=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --slug) need_value "$@"; slug="$2"; need_slug "$slug"; shift 2 ;;
            *) die "requests: unknown argument: $1" "$GREMION_EXIT_USAGE" ;;
        esac
    done
    local su
    su="$(env_key "${ROOT}/etc/env/state.env" POSTGRES_USER)"
    platform_sql "${su:-postgres}" "SELECT request_id, created_at, kind, customer_slug, origin, state, attempt, coalesce(outcome, '') FROM plt.provisioning_request_status WHERE (:'slug' = '' OR customer_slug = :'slug') ORDER BY created_at DESC LIMIT 50;" -v slug="$slug"
}

# The break-glass verbs mutate the host like every other mutating verb: they take
# runtime/hostd.lock, non-blocking (exit 3 when busy), unless gremion-hostd holds it.
# (The executor does not come through here: its handlers call the library under its own lock.)
acquire_host_lock() {
    local lock="${ROOT}/runtime/hostd.lock"
    [[ "${GREMION_HOST_LOCK_HELD:-}" = 1 ]] && return 0
    command -v flock >/dev/null 2>&1 || die "flock is not installed (util-linux); refusing to run without the host lock" "$GREMION_EXIT_USAGE"
    mkdir -p "$(dirname "$lock")" || die "cannot create $(dirname "$lock")" "$GREMION_EXIT_USAGE"
    exec 9>>"$lock" || die "cannot open the host lock: ${lock}" "$GREMION_EXIT_USAGE"
    flock -n 9 || die "busy: another host operation is running (lock ${lock}); retry when it has finished" 3
}

cmd_suspend() { acquire_host_lock; customer_suspend "$@"; }

cmd_resume() { acquire_host_lock; customer_resume "$@"; }

cmd_reconcile() { customer_reconcile "$@"; }

cmd_status() {
    local slug="${1:-}"
    need_slug "$slug"
    active_colour
    tc status "$slug"
}

# panel (Q12): the ssh -L line for the active colour's panel; nothing published.
cmd_panel() {
    active_colour
    local state stack cid ip port="${PANEL_LOCAL_PORT:-3043}"
    state="${ROOT}/etc/env/state.env"
    stack="$(env_key "$state" STACK)"
    [[ -f "${ROOT}/etc/edge/active.yml" ]] || die "etc/edge/active.yml is absent" "$GREMION_EXIT_USAGE"
    cid="$(docker ps -q --filter "label=com.docker.compose.project=${stack}-app-${COLOUR}" --filter "label=com.docker.compose.service=control-panel")"
    cid="${cid%%$'\n'*}"
    [[ -n "$cid" ]] || die "no control-panel container runs in ${stack}-app-${COLOUR}" "$GREMION_EXIT_USAGE"
    ip="$(docker inspect -f "{{with index .NetworkSettings.Networks \"${stack}-app-${COLOUR}_app\"}}{{.IPAddress}}{{end}}" "$cid")"
    [[ "$ip" =~ ^[0-9.]+$ ]] || die "the panel has no address on ${stack}-app-${COLOUR}_app" "$GREMION_EXIT_ASSERT"
    printf 'ssh -L 127.0.0.1:%s:%s:3000 <this host>\n' "$port" "$ip"
    info "then open http://127.0.0.1:${port} (the panel's ORIGIN)"
}

# operator add <email> --no-mail --keycloak-container <c>: a host WITHOUT the
# pooled stack and without vendor mail (the test env, section 11 step 3). The
# user is created in `platform` by kcadm with UPDATE_PASSWORD + CONFIGURE_TOTP
# and a generated TEMPORARY password (Q23), which reaches kcadm on stdin only
# (jq $ENV payload, never an argv) and is printed ONCE, on stdout, to the
# operator's terminal. The `operator` realm role is added. An existing user
# gets the role and no password.
operator_add_kcadm() {   # <container> <email>
    local kc="$1" email found uid temporary
    email="$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')"
    need_cmd docker jq openssl
    kcadm_login "$kc"
    docker exec "$kc" "$KCADM_BIN" get realms/platform --fields realm >/dev/null 2>&1 \
        || die "the ops realm platform does not exist in ${kc}: run gremion-tenant init --realm-only --keycloak-container ${kc} first" "$GREMION_EXIT_USAGE"
    found="$(docker exec "$kc" "$KCADM_BIN" get users -r platform -q "email=${email}" -q exact=true --fields id)" \
        || die "kcadm could not look the operator up" "$GREMION_EXIT_ASSERT"
    uid="$(jq -r '.[0].id // ""' <<< "$found" | tr -d '\r')"
    if [[ -z "$uid" ]]; then
        # tr -d '\r': a Windows openssl ends its line with CRLF (the proof runs there).
        temporary="$(openssl rand -base64 24 | tr -d '\r\n=' | tr '/+' '_-')"
        OPERATOR_TEMP_PASSWORD="$temporary" jq -n -c --arg email "$email" '{
                username: $email, email: $email, enabled: true, emailVerified: true,
                requiredActions: ["UPDATE_PASSWORD", "CONFIGURE_TOTP"],
                credentials: [{type: "password", value: $ENV.OPERATOR_TEMP_PASSWORD, temporary: true}]}' \
            | docker exec -i "$kc" "$KCADM_BIN" create users -r platform -f - >/dev/null \
            || { temporary=""; die "kcadm refused to create the operator ${email}" "$GREMION_EXIT_ASSERT"; }
        found="$(docker exec "$kc" "$KCADM_BIN" get users -r platform -q "email=${email}" -q exact=true --fields id)" \
            || die "kcadm could not read the operator back" "$GREMION_EXIT_ASSERT"
        uid="$(jq -r '.[0].id // ""' <<< "$found" | tr -d '\r')"
        [[ -n "$uid" ]] || die "the operator ${email} is absent after create" "$GREMION_EXIT_ASSERT"
    else
        info "operator ${email} already exists: no password is set or printed"
    fi
    docker exec "$kc" "$KCADM_BIN" add-roles -r platform --uid "$uid" --rolename operator >/dev/null \
        || die "kcadm could not grant the operator role to ${email}" "$GREMION_EXIT_ASSERT"
    if [[ -n "${temporary:-}" ]]; then
        ok "operator ${email} created with a temporary password (Q23: no vendor mail on this host); it must be changed and TOTP configured at first sign-in"
        printf 'TEMPORARY-PASSWORD: %s\n' "$temporary"
        temporary=""
    else
        ok "operator ${email}: the operator role is held"
    fi
}

cmd_operator() {
    local sub="${1:-}"; shift || true
    [[ "$sub" == add ]] || { usage >&2; die "operator add <email> [--no-mail] [--keycloak-container <name>]" "$GREMION_EXIT_USAGE"; }
    local email="${1:-}"; shift || true
    [[ "$email" =~ $EMAIL_RE ]] || die "operator add needs an <email>" "$GREMION_EXIT_USAGE"
    local nomail=no kc=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-mail) nomail=yes; shift ;;
            --keycloak-container) [[ $# -ge 2 ]] || die "--keycloak-container requires a value" "$GREMION_EXIT_USAGE"; kc="$2"; shift 2 ;;
            *) die "operator add: unknown argument: $1" "$GREMION_EXIT_USAGE" ;;
        esac
    done
    # Q23: a generated temporary password is the exception for a host WITHOUT
    # vendor mail; where mail.env exists, the execute-actions mail is required.
    if [[ "$nomail" == yes && -f "${ROOT}/etc/env/mail.env" ]]; then
        die "--no-mail is for a host without vendor mail (Q23); this host has mail.env, so the operator gets the execute-actions mail" "$GREMION_EXIT_USAGE"
    fi
    if [[ -n "$kc" ]]; then
        [[ "$nomail" == yes ]] || die "--keycloak-container is the path of a host without the pooled stack and without vendor mail: pass --no-mail (a host with the pooled stack adds operators through tenant-create, execute-actions mail)" "$GREMION_EXIT_USAGE"
        operator_add_kcadm "$kc" "$email"
        return
    fi
    active_colour
    local -a args=(operator-add "$email")
    [[ "$nomail" == no ]] || args+=(--no-mail)
    tc "${args[@]}"
}

main() {
    [[ $# -ge 1 ]] || { usage >&2; exit "$GREMION_EXIT_USAGE"; }
    local verb="$1"; shift
    case "$verb" in
        -h|--help) usage; exit "$GREMION_EXIT_OK" ;;
        # D R31-I4: refused before anything is read, run or written.
        create) die "gremion-tenant create is ${DECOMMISSIONED}" "$GREMION_EXIT_USAGE" ;;
    esac
    need_cmd docker jq sed grep tr mktemp realpath openssl
    setup_paths
    # --operator may come first for any verb.
    if [[ "${1:-}" == --operator ]]; then need_value "$@"; OPERATOR_ID="$2"; shift 2; fi
    case "$verb" in
        init)      cmd_init "$@" ;;
        request)   cmd_request "$@" ;;
        requests)  cmd_requests "$@" ;;
        suspend)   cmd_suspend "$@" ;;
        resume)    cmd_resume "$@" ;;
        reconcile) cmd_reconcile "$@" ;;
        status)    cmd_status "$@" ;;
        panel)     cmd_panel "$@" ;;
        operator)  cmd_operator "$@" ;;
        *) usage >&2; die "unknown verb: ${verb}" "$GREMION_EXIT_USAGE" ;;
    esac
}

main "$@"
