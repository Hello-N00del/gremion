# ============================================================
# Gremion — hardening environment variables
# This header travels into the GENERATED .env.hardening, which is produced from
# infra/hardening/values.yaml by `make -C infra/hardening hardening-config`.
# Edit THIS template (or values.yaml) — never the generated .env.hardening.
# ============================================================

# ── Log retention (in seconds) ─────────────────────────────
# Tier 1: Access logs (BayLDA — max 30 days)
LOG_ACCESS_RETENTION_SECONDS=${LOG_ACCESS_RETENTION_SECONDS}

# Tier 2: Application / error logs (DSGVO Art. 5 — max 90 days)
LOG_APP_RETENTION_SECONDS=${LOG_APP_RETENTION_SECONDS}

# Tier 3: Security/audit logs with PII (BSI Mindeststandard v2.1 — max 180 days)
LOG_SEC_RETENTION_SECONDS=${LOG_SEC_RETENTION_SECONDS}

# Tier 4: Security logs without PII (BSI Ausnahmeregelung — max 365 days)
LOG_SECNOPII_RETENTION_SECONDS=${LOG_SECNOPII_RETENTION_SECONDS}

# ── Backup retention ────────────────────────────────────────
BACKUP_LOCAL_RETENTION_DAYS=${BACKUP_LOCAL_RETENTION_DAYS}
BACKUP_REMOTE_RETENTION_DAYS=${BACKUP_REMOTE_RETENTION_DAYS}
BACKUP_FINANCIAL_RETENTION_DAYS=${BACKUP_FINANCIAL_RETENTION_DAYS}
BACKUP_CRON_START=${BACKUP_CRON_START}
RESTIC_CHECK_SUBSET=${RESTIC_CHECK_SUBSET}

# ── ipcrypt key rotation ────────────────────────────────────
IPCRYPT_ROTATION_DAYS=${IPCRYPT_ROTATION_DAYS}

# ── Secrets (fill in from your secret manager) ─────────────
# Never commit real values — these are placeholders.
RESTIC_PASSWORD=CHANGE_ME
RCLONE_BUCKET=
RCLONE_REMOTE=backup
RCLONE_REMOTE_PATH=gremion-restic
