<?xml version="1.0" encoding="utf-8"?>
<!--
    Release-safe default: no cleartext permitted, only system trust anchors.
    The debug sourceSet (src/debug/res/xml/network_security_config.xml) overrides
    this file in debug builds to permit cleartext to 10.0.2.2 / 192.168.0.13 /
    localhost for local dev servers.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system"/>
    </trust-anchors>
  </base-config>
</network-security-config>
