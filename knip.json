{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "scripts/port-back/*.mjs", "ops/scripts/*.mjs"],
      "project": ["scripts/**/*.mjs", "ops/**/*.mjs"],
      "ignore": ["packages/**", "contracts/**", "docs/**", "legal/**"]
    },
    "gremion-ui": {
      "entry": [
        "scripts/*.mjs",
        "scripts/*.ts",
        "src/hooks.server.ts",
        "src/hooks.client.ts",
        "src/lib/modules/**/manifest.ts",
        "src/lib/components/ui/index.ts",
        "src/lib/components/ui/*/index.ts"
      ],
      "ignore": ["scripts/__fixtures__/**"]
    },
    "gremion-public": {
      "entry": ["scripts/*.mjs"]
    }
  },
  "ignoreDependencies": []
}
