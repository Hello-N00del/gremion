# =============================================================
# Gremion kernel .gitignore
#
# The repo is SvelteKit (gremion-ui, gremion-public) + Docker + Kubernetes.
# Several sections below still cover Python and PHP artefacts: those stacks
# left with the open-core carve, and the rules are kept only because a stray
# __pycache__ or vendor/ costs nothing to ignore and something to un-commit.
# The names of the services that once needed them have been removed — a
# gitignore that names subsystems this repository does not contain reads as an
# inventory, and was one.
# =============================================================

# -------------------------------------------------------------
# Environment — NEVER commit secrets
# -------------------------------------------------------------
.env
# Broad mode-variant cover (matches .env.local, .env.production, .env.staging,
# .env.prod, .env.bak*, …) — mirrors the app-level .gitignores so an operator
# creating a conventional mode variant next to the root docker-compose secrets
# file cannot commit it. .env.example stays committed via the negation below.
.env.*
!.env.example
# Tracked test fixture — re-included so the broad .env.* rule above does not
# hide it from `git status`/fresh clones.
!test/fixtures/.env.test
legal/legal.env
# Generated by scripts/refresh-livekit-turn.ps1 — contains live secrets
docker/livekit/livekit.prod.yaml

# Local test credentials — never commit
TEST_USERS.md

# Runtime secrets directory — generated locally, never committed.
# Anchored with a leading slash so it only matches a top-level `secrets/`
# directory; the k8s/overlays/production/secrets/ directory has its own
# fine-grained allow-list below and must not be matched here.
# P2.1c T1 (#202) D-SECMOUNT: `/secrets/*` (not `/secrets/`) so git can
# descend to re-include secrets/tenants/.gitkeep — the tenant-secrets mount
# point must exist in fresh clones; every real file under it stays ignored.
/secrets/*
!/secrets/tenants/
/secrets/tenants/*
!/secrets/tenants/.gitkeep

# SOPS plaintext secret files — encrypt before committing, never commit plaintext
# Encrypted versions (*.enc.yaml) ARE committed; .example.yaml templates ARE committed.
# BOTH YAML extensions: operators hand-author these files (see encrypt-all.sh),
# and a file named .yml used to be neither ignored here nor picked up by the
# encryptor's glob — i.e. committable in plaintext with no warning anywhere.
k8s/overlays/production/secrets/*.yaml
k8s/overlays/production/secrets/*.yml
!k8s/overlays/production/secrets/*.enc.yaml
!k8s/overlays/production/secrets/*.enc.yml
!k8s/overlays/production/secrets/*.example.yaml
!k8s/overlays/production/secrets/*.example.yml
!k8s/overlays/production/secrets/encrypt-all.sh
!k8s/overlays/production/secrets/bootstrap-sops.sh

# -------------------------------------------------------------
# Node / pnpm / npm / yarn
# -------------------------------------------------------------
node_modules/
**/node_modules/
.pnpm-store/
**/.pnpm-store/
.npm/
.yarn/
.yarn-integrity
npm-debug.log*
yarn-error.log
yarn-debug.log*
lerna-debug.log*
pnpm-debug.log*

# TypeScript incremental build info
*.tsbuildinfo

# Publishable package build output (packages/*/tsconfig.build.json → dist/).
# Generated by `pnpm --filter @gremion/<pkg> build`, packed into the npm
# tarball by the prepack hook, and never committed — the git source of truth
# is src/, and a committed dist/ is a second one that silently goes stale.
packages/*/dist/

# -------------------------------------------------------------
# SvelteKit (gremion-ui, gremion-public) build output
# -------------------------------------------------------------
.svelte-kit/
**/.svelte-kit/
gremion-ui/build/
gremion-public/build/

# Vite / Rollup
.vite/
.rollup.cache/

# -------------------------------------------------------------
# Python artefacts (no Python service here; see the header)
# -------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.venv/
venv/
# Anchored to repo root: a bare `env/` matched ANY directory named `env`
# anywhere (e.g. gremion-ui/src/lib/env/), silently swallowing source. Only the
# top-level Python virtualenv dir should be ignored.
/env/
# Local Django settings (never committed)
local_settings.py
# Local SQLite
db.sqlite3
db.sqlite3-journal

# -------------------------------------------------------------
# PHP / Composer artefacts (no PHP service here; see the header)
# -------------------------------------------------------------
vendor/
public/build/
public/hot/

# -------------------------------------------------------------
# Runtime data directories
# -------------------------------------------------------------
# Anchored to repo root: a bare `data/` matched ANY directory named `data`
# anywhere, silently swallowing source. Only a top-level runtime `data/`
# should be ignored.
/data/
storage/app/
storage/logs/
storage/framework/cache/

# -------------------------------------------------------------
# Test / coverage artefacts
# -------------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# -------------------------------------------------------------
# Backups
# -------------------------------------------------------------
backups/

# -------------------------------------------------------------
# Editor / OS
# -------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*.swn
*.bak
*~
.#*
\#*\#
.idea/
.vscode/

# -------------------------------------------------------------
# Logs (generic)
# -------------------------------------------------------------
*.log
logs/

# -------------------------------------------------------------
# Git worktrees (from `git worktree add` — tooling artefact)
# -------------------------------------------------------------
.worktrees/

# -------------------------------------------------------------
# AI tooling (Claude Code / Superpowers) — never commit tooling artefacts
# -------------------------------------------------------------
.claude/
.superpowers/
CLAUDE.md
docs/superpowers/

# -------------------------------------------------------------
# WP-Migration (Track M) — generated diff reports contain financial PII
# -------------------------------------------------------------
gremion-ui/finance/migration/reports/*
!gremion-ui/finance/migration/reports/.gitkeep
_design_api/

# Playwright sweep scratch (storageState/session tokens, raw screenshots) — never commit
gremion-ui/sweep-2026-06-04/

# -------------------------------------------------------------
# Private-key and certificate material — REPO-WIDE, not one directory.
# The rules below used to exist only under docker/keycloak/certs/, so a key
# written anywhere else (docker/traefik/certs/, the repo root, a scratch dir)
# was committable in silence. The one certificate that must stay tracked is
# re-included explicitly: it is a PUBLIC root, not a key.
# -------------------------------------------------------------
*.key
*.crt
*.pem
*.csr
*.srl
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
*.kubeconfig
.kube/
!docker/cloudflared/origin-ca-root.pem

# G-080 internal-TLS material — generated locally by
# docker/keycloak/certs/gen-internal-ca.sh, NEVER committed.
# The generator script + .gitkeep ARE committed; keys/certs are not.
# (Kept for locality; the repo-wide rules above already cover them.)
# -------------------------------------------------------------
docker/keycloak/certs/*.key
docker/keycloak/certs/*.crt
docker/keycloak/certs/*.pem
docker/keycloak/certs/*.csr
docker/keycloak/certs/*.srl
!docker/keycloak/certs/.gitkeep
!docker/keycloak/certs/gen-internal-ca.sh

# G-080 throwaway validation artifacts — transient, deleted after validation
docker-compose.g080-throwaway.yml
g080-throwaway-realm.json

# P2.1b T11: PgBouncer auth credential — rendered at deploy from
# docker/pgbouncer/userlist.txt.example (which IS committed), NEVER committed.
docker/pgbouncer/userlist.txt
