# scripts/verify/census/render.env -- TASK-036 (TRD-178).
#
# The ONLY variable source the health census renders the production compose
# projects with (`docker compose --env-file <this> ...`). Placeholder values
# only: every address is loopback or an RFC 5737 / RFC 3849 documentation
# range, every domain ends in .invalid, and no key here is a credential. The
# census reads each service's healthcheck, image and build block; none of
# those depend on a real value, so a render with these values censuses the
# same set of services the host renders with its real env files.
#
# Keys are the union of the variables `docker compose config --variables`
# marks REQUIRED for the state, app, ops and mail projects. A *_IMAGE key must
# equal the same key in infra/host/templates/env/*.env.tmpl
# (census.test.mjs pins that by key, so the two cannot drift).

# -- shared ------------------------------------------------------------------
STACK=census
GREMION_ROOT=/opt/gremion
PLATFORM_DOMAIN=census.invalid
DOMAIN=census.invalid

# -- state project (docker-compose.yml + docker-compose.prod.yml) ------------
EDGE_BIND_IP=127.0.0.1
EDGE_BIND_IP6=::1
EDGE_V4_SUBNET=192.0.2.0/24
EDGE_V6_SUBNET=2001:db8:1::/64
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
TRAEFIK_API_PORT=8081
INTERNALTEST_PORT=8082
ACME_CA_SERVER=https://acme.census.invalid/directory

# -- app project (docker-compose.app.yml, TASK-040) --------------------------
# One colour is enough: blue and green render the same services and
# healthchecks, only the aliases differ (scripts/check-pooled-stack.mjs
# renders both). IMAGE_TAG only names the ghcr ref, which the census never
# inspects for a first-party service (it builds census-<sha8>/<svc>).
COLOUR=blue
IMAGE_TAG=census
APP_V4_SUBNET=192.0.2.192/26
APP_V6_SUBNET=2001:db8:4::/64
# TASK-043: the control panel and tenant-create read these (compose marks them
# REQUIRED); placeholders, not credentials (the release render arm's
# render.env carries the same two).
PLATFORM_DB_PASSWORD=census-placeholder
PANEL_DB_PASSWORD=census-placeholder

# -- ops project (compose/observability/docker-compose.yml, TASK-039) ---------
OPS_UID=1000
OPS_GID=1000
OPS_BIND_IP=127.0.0.1
OPS_INGEST_BIND_IP=127.0.0.1
OPS_V4_SUBNET=192.0.2.64/26
OPS_V6_SUBNET=2001:db8:2::/64
GREMION_ROOT_DIR=/opt/gremion
PROM_RETENTION_TIME=15d
ALERT_SMTP_HOST=mail.census.invalid
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=alerts@census.invalid
ALERT_EMAIL_FROM=alerts@census.invalid

# -- mail project (infra/host/mail/docker-compose.yml) -----------------------
MAIL_BIND_IP=127.0.0.1
MAIL_BIND_IP6=::1
MAIL_V4_SUBNET=192.0.2.128/26
MAIL_V6_SUBNET=2001:db8:3::/64
MAIL_LOG_RETENTION_DAYS=7
STALWART_IMAGE=docker.io/stalwartlabs/stalwart@sha256:0620ceba9165c104789d5cacb0aa209e7f16295f54edead631b1925b1ccc1ccf
