+// CD PROOF ONLY (never merged): a public page that answers 200 and, while the flag
+// file exists, 500. /readyz and /healthz are not touched.
+export const GET: RequestHandler = () =>
+  new Response(existsSync('/tmp/cd-proof-fail') ? 'proof' : 'ok', {
+    status: existsSync('/tmp/cd-proof-fail') ? 500 : 200,
+    headers: { 'content-type': 'text/plain', 'cache-control': 'no-store' },
+  })
