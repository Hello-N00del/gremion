# scripts/release/fixtures/render/render.env -- TASK-048b (TRD-350, brief Q4).
#
# The ONLY variable source the release render arm (scripts/release/lib/
# render.mjs, `check-image-digests.mjs --render`) renders the production
# compose projects with (`docker compose --env-file <this> ...`). Placeholder
# values only: every address is loopback or an RFC 5737 / RFC 3849
# documentation range, every domain ends in .invalid (RFC 2606), and no key
# here is a credential. The arm judges each service's image and build; none of
# those depend on a real value, except the *_IMAGE keys, which must equal the
# same key in infra/host/templates/env/*.env.tmpl
# (scripts/release/render-arm.test.mjs pins that by key).
#
# Keys are the union of the variables the state, app, ops and mail projects
# mark REQUIRED. COLOUR is set per colour by the arm itself (the child
# environment beats this file).

# -- shared ------------------------------------------------------------------
STACK=release-render
GREMION_ROOT=/opt/gremion
PLATFORM_DOMAIN=release-render.invalid
DOMAIN=release-render.invalid

# -- state project (docker-compose.yml + docker-compose.prod.yml) ------------
EDGE_BIND_IP=127.0.0.1
EDGE_BIND_IP6=::1
EDGE_V4_SUBNET=192.0.2.0/24
EDGE_V6_SUBNET=2001:db8:1::/64
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
TRAEFIK_API_PORT=8081
INTERNALTEST_PORT=8082
ACME_CA_SERVER=https://acme.release-render.invalid/directory

# -- app project (docker-compose.app.yml, TASK-040) --------------------------
# IMAGE_TAG only names the ghcr ref the pins layer replaces with a digest; a
# first-party ref left by tag is exactly what the arm refuses.
COLOUR=blue
IMAGE_TAG=render
APP_V4_SUBNET=192.0.2.192/26
APP_V6_SUBNET=2001:db8:4::/64
# TASK-043: the control panel and tenant-create read these (compose marks them REQUIRED); placeholders, not credentials.
PLATFORM_DB_PASSWORD=release-render-placeholder
PANEL_DB_PASSWORD=release-render-placeholder

# -- ops project (compose/observability/docker-compose.yml, TASK-039) ---------
OPS_UID=1000
OPS_GID=1000
OPS_BIND_IP=127.0.0.1
OPS_INGEST_BIND_IP=127.0.0.1
OPS_V4_SUBNET=192.0.2.64/26
OPS_V6_SUBNET=2001:db8:2::/64
GREMION_ROOT_DIR=/opt/gremion
PROM_RETENTION_TIME=15d
ALERT_SMTP_HOST=mail.release-render.invalid
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=alerts@release-render.invalid
ALERT_EMAIL_FROM=alerts@release-render.invalid

# -- mail project (infra/host/mail/docker-compose.yml) -----------------------
MAIL_BIND_IP=127.0.0.1
MAIL_BIND_IP6=::1
MAIL_V4_SUBNET=192.0.2.128/26
MAIL_V6_SUBNET=2001:db8:3::/64
MAIL_LOG_RETENTION_DAYS=7
STALWART_IMAGE=docker.io/stalwartlabs/stalwart@sha256:0620ceba9165c104789d5cacb0aa209e7f16295f54edead631b1925b1ccc1ccf
