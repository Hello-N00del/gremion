{
  "name": "@gremion/storage",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Tenant-scoped file/object storage seam for the Gremion governance kernel",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hello-N00del/gremion.git",
    "directory": "packages/storage"
  },
  "homepage": "https://github.com/Hello-N00del/gremion/tree/main/packages/storage",
  "bugs": "https://github.com/Hello-N00del/gremion/issues",
  "files": ["dist", "src", "!src/**/*.test.ts", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  }
}
