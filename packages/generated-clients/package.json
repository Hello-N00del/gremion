{
  "name": "@gremion/generated-clients",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Spec-first contract registry, compat gates (OpenAPI/AsyncAPI) and the generated TypeScript client for Gremion's first-party HTTP/event surfaces",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hello-N00del/gremion.git",
    "directory": "packages/generated-clients"
  },
  "homepage": "https://github.com/Hello-N00del/gremion/tree/main/packages/generated-clients",
  "bugs": "https://github.com/Hello-N00del/gremion/issues",
  "files": ["dist", "src", "!src/**/*.test.ts", "!src/consumer-fixture/**", "README.md", "LICENSE"],
  "exports": {
    "./registry": {
      "import": "./src/registry.ts"
    },
    "./schema": {
      "import": "./src/schema.ts"
    },
    "./oasdiff-gate": {
      "import": "./src/oasdiff-gate.ts"
    },
    "./asyncapi-compat": {
      "import": "./src/asyncapi-compat.ts"
    },
    "./codegen-drift": {
      "import": "./src/codegen-drift.ts"
    },
    "./module-contracts": {
      "import": "./src/module-contracts.ts"
    },
    "./kernel-governance-client": {
      "import": "./src/generated/kernel-governance-client.ts"
    },
    "./governance-client": {
      "import": "./src/generated/governance-client.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./registry": {
        "types": "./dist/registry.d.ts",
        "import": "./dist/registry.js"
      },
      "./schema": {
        "types": "./dist/schema.d.ts",
        "import": "./dist/schema.js"
      },
      "./oasdiff-gate": {
        "types": "./dist/oasdiff-gate.d.ts",
        "import": "./dist/oasdiff-gate.js"
      },
      "./asyncapi-compat": {
        "types": "./dist/asyncapi-compat.d.ts",
        "import": "./dist/asyncapi-compat.js"
      },
      "./codegen-drift": {
        "types": "./dist/codegen-drift.d.ts",
        "import": "./dist/codegen-drift.js"
      },
      "./module-contracts": {
        "types": "./dist/module-contracts.d.ts",
        "import": "./dist/module-contracts.js"
      },
      "./kernel-governance-client": {
        "types": "./dist/generated/kernel-governance-client.d.ts",
        "import": "./dist/generated/kernel-governance-client.js"
      },
      "./governance-client": {
        "types": "./dist/generated/governance-client.d.ts",
        "import": "./dist/generated/governance-client.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "generate": "node tools/generate.mjs",
    "contracts:check": "pnpm build && node tools/contracts-check.mjs"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "openapi-typescript": "7.13.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "typescript": "^5.4.5",
    "vitest": "^5.0.1"
  }
}
