{
  "name": "@gremion/tokens",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "DTCG 2025.10 design tokens (core -> semantic -> component) and the accent engine for the Gremion governance kernel",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hello-N00del/gremion.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/Hello-N00del/gremion/tree/main/packages/tokens",
  "bugs": "https://github.com/Hello-N00del/gremion/issues",
  "files": [
    "src",
    "tokens",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./engine": {
      "types": "./src/engine/accent.d.ts",
      "import": "./src/engine/accent.js"
    },
    "./tokens/gremion.tokens.json": "./tokens/gremion.tokens.json",
    "./tokens/modes/dark.tokens.json": "./tokens/modes/dark.tokens.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check ../../gremion-ui/src/app.css",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
