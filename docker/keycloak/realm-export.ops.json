{
  "realm": "platform",
  "displayName": "Gremion Operations",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "internationalizationEnabled": true,
  "supportedLocales": ["de", "en"],
  "defaultLocale": "de",
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyInitialCounter": 0,
  "roles": {
    "realm": [
      {
        "name": "operator",
        "description": "A Gremion operator: may sign in to the control panel (TRD-048)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "control-panel",
      "name": "Gremion Control Panel",
      "description": "The ops control panel (TASK-043 Q5): confidential, code flow + PKCE S256, exact redirect URIs on the operator's loopback origin, no wildcard host",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:3043/*"
      ],
      "webOrigins": [
        "http://127.0.0.1:3043"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:3043/*"
      },
      "fullScopeAllowed": false,
      "secret": "__CONTROL_PANEL_OIDC_CLIENT_SECRET__",
      "defaultClientScopes": [
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "acr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-acr-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-control-panel",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "control-panel",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "client": "control-panel",
      "roles": [
        "operator"
      ]
    }
  ],
  "users": [],
  "attributes": {
    "acr.loa.map": "{\"loa1\":1,\"loa2\":2}"
  }
}
