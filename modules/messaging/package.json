{
  "name": "messages-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "StuRaOS messages+video leaf service (thin Matrix/LiveKit proxy) — node:http, stateless, per-request user Matrix token",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  }
}
