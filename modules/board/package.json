{
  "name": "board-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "StuRaOS board leaf service (Deck task board extraction, T1) — node:http, single PG, byte-identical behind BOARD_BACKEND",
  "main": "dist/index.js",
  "scripts": {
    "build:manifest": "node scripts/build-migration-manifest.mjs",
    "prebuild": "node scripts/build-migration-manifest.mjs",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --external:postgres --external:zod",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gremion/tenant-store": "workspace:*",
    "postgres": "^3.4.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  }
}
