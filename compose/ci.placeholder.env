# CI-only placeholder values for the compose variables that a bare
# `cp .env.example .env` leaves unset but a compose file requires with `:?`.
#
# This is the ONE place every render-only check reads them from:
#   - gremion-ui/scripts/check-app-port-binding.mjs (`pnpm check`, CI "Type check")
#   - scripts/check-compose-latest-tags.sh           (`make lint-compose-latest`, CI "G-037")
# Both apply a value only when the caller's environment does not already set
# the variable, so an operator's real value always wins.
#
# These values are RENDER-ONLY. Nothing here is ever written into a running
# container, a host env file or a deployment; the `:?` guards in the compose
# files are untouched, so a real deployment that forgets the variable still
# fails closed. Every secret-shaped value is an obvious placeholder and is
# pinned as one by scripts/env/ci-placeholders.test.mjs.
#
# Add a line here when a compose file gains a `:?` variable that .env.example
# does not set as an active assignment; the same test fails until you do.

# Proxy-trust secret (docker-compose.app.yml kernel-api). .env.example leaves it
# commented out on purpose: unset is the byte-identical no-op for local dev.
TENANT_PROXY_SHARED_SECRET=ci-placeholder-not-a-secret

# App-tier colour (docker-compose.app.yml). The host fills it per colour; a
# render needs one of blue / green.
COLOUR=blue
