# compose/control-panel/standalone.env.tmpl — the env file of the standalone
# control panel (TASK-043 section 11). Copy to a 0600 file OUTSIDE the release
# tree and fill every CHANGE_ME_ value; no secret goes in here (the client and
# Auth.js secrets are FILES under PANEL_SECRETS_DIR).

# The image: built on the host from the kernel archive at the merged SHA
# (docker build -f apps/control-panel/Dockerfile -t ghcr.io/hello-n00del/gremion-control-panel:<tag> .).
IMAGE_TAG=CHANGE_ME_OPERATOR_image_tag

# The existing Keycloak's docker network (re-measured with `docker network ls`).
PANEL_NETWORK=CHANGE_ME_OPERATOR_keycloak_network

# Loopback port the panel is published on; the browser origin behind `ssh -L`.
PANEL_PORT=3043
PANEL_ORIGIN=http://127.0.0.1:3043

# The ops realm's PUBLIC issuer (exact: the iss of its tokens), and Keycloak's
# internal /auth base for the token, userinfo and JWKS calls.
PANEL_OIDC_ISSUER=https://CHANGE_ME_OPERATOR_platform_domain/auth/realms/platform
PANEL_OIDC_INTERNAL_BASE=http://keycloak:8080/auth
# Set when PANEL_OIDC_INTERNAL_BASE is https with an internal CA.
PANEL_NODE_EXTRA_CA_CERTS=

# client_secret (written by `gremion-tenant init --realm-only`) and auth_secret
# (openssl rand -hex 32), both 0600, read-only in the container.
PANEL_SECRETS_DIR=/opt/gremion/etc/secrets/control-panel

# The control registry, read-only role (the customer list).
CONTROL_DATABASE_URL=postgresql://CHANGE_ME_OPERATOR_control_reader@CHANGE_ME_OPERATOR_postgres_host:5432/control

# Empty until TASK-038's re-init: "Neuer Mandant" is then disabled with its reason.
PLATFORM_DATABASE_URL=
PANEL_EXECUTOR=none
