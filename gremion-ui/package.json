{
  "name": "gremion-ui",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "prebuild": "node scripts/build-module-manifest.mjs && node scripts/build-module-server-init.mjs && node scripts/build-migration-manifest.mjs && node scripts/build-migration-manifest.mjs migrations-control",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node src/lib/i18n/compile.js && node scripts/check-tenant-env-guard.mjs --enforce --root src && node scripts/check-app-port-binding.mjs && node scripts/check-tenant-secrets-dir.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser && vitest run --project browser-dsf2",
    "test:unit:watch": "vitest --project unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:deselection": "vitest run --config vitest.deselection.config.ts",
    "test:e2e": "playwright test",
    "test:all": "vitest run --project unit && playwright test",
    "coverage": "vitest run --project unit --coverage",
    "migrate": "tsx scripts/run-migrations-verified.mjs",
    "migrate:control": "tsx scripts/run-control-migrations.mjs",
    "provision": "tsx scripts/tenant-provision.mjs"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^26.6.0",
    "@types/node-cron": "^3.0.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "4.13.0",
    "msw": "^2.15.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/sveltekit": "^1.11.3",
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@gremion/db": "workspace:*",
    "@gremion/ports": "workspace:*",
    "@gremion/storage": "workspace:*",
    "@gremion/tokens": "workspace:*",
    "bits-ui": "2.19.3",
    "clsx": "^2.1.1",
    "isomorphic-dompurify": "^3.19.0",
    "jose": "^6.2.12",
    "jsdom": "^29.1.1",
    "lru-cache": "^11.5.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.1.1",
    "postgres": "^3.4.9",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.5"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0"
}
