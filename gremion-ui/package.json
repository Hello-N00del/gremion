{
  "name": "gremion-ui",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "predev": "node scripts/interim-module-overlay.mjs",
    "dev": "vite dev",
    "prebuild": "node scripts/interim-module-overlay.mjs --migrations && node scripts/build-module-manifest.mjs && node scripts/build-module-server-init.mjs && node scripts/build-migration-manifest.mjs && node scripts/build-migration-manifest.mjs migrations-control",
    "build": "vite build",
    "preview": "vite preview",
    "precheck": "node scripts/interim-module-overlay.mjs",
    "check": "node src/lib/i18n/compile.js && node scripts/check-tenant-env-guard.mjs --enforce --root src && node scripts/check-app-port-binding.mjs && node scripts/check-tenant-secrets-dir.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "pretest:unit": "node scripts/interim-module-overlay.mjs && pnpm --dir ../apps/control-panel exec svelte-kit sync",
    "test:unit": "vitest run --project unit",
    "pretest:browser": "node scripts/interim-module-overlay.mjs",
    "test:browser": "vitest run --project browser && vitest run --project browser-dsf2",
    "test:unit:watch": "vitest --project unit",
    "pretest:integration": "node scripts/interim-module-overlay.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:deselection": "vitest run --config vitest.deselection.config.ts",
    "test:e2e": "playwright test",
    "test:all": "vitest run --project unit && playwright test",
    "coverage": "vitest run --project unit --coverage",
    "migrate": "tsx scripts/run-migrations-verified.mjs",
    "migrate:control": "tsx scripts/run-control-migrations.mjs",
    "premigrate:test-fixture": "node scripts/interim-module-overlay.mjs",
    "migrate:test-fixture": "tsx scripts/migrate-test-fixture.mjs",
    "provision": "tsx scripts/tenant-provision.mjs"
  },
  "devDependencies": {
    "@gremion/edge-routers": "workspace:*",
    "@gremion/events": "workspace:*",
    "@gremion/member-import": "workspace:*",
    "@gremion/nats-auth": "workspace:*",
    "@gremion/provisioning": "workspace:*",
    "@gremion/tenant-store": "workspace:*",
    "@inlang/paraglide-js": "^2.25.4",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^26.6.0",
    "@types/node-cron": "^3.0.11",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "4.13.0",
    "msw": "^2.15.0",
    "satori": "^0.12.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/sveltekit": "^1.11.3",
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@gremion/db": "workspace:*",
    "@gremion/ports": "workspace:*",
    "@gremion/storage": "workspace:*",
    "@gremion/tenancy-core": "workspace:*",
    "@gremion/tokens": "workspace:*",
    "@xmldom/xmldom": "^0.9.10",
    "bits-ui": "2.19.3",
    "clsx": "^2.1.1",
    "google-auth-library": "^10.6.2",
    "isomorphic-dompurify": "^3.19.0",
    "jose": "^6.2.12",
    "jsdom": "^30.1.0",
    "livekit-server-sdk": "^2.15.3",
    "lru-cache": "^11.5.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.9",
    "postgres": "^3.4.9",
    "svelte-dnd-action": "^0.9.69",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0"
}
