# Keycloak OIDC
AUTH_SECRET=                    # random 32-char string: openssl rand -hex 32
AUTH_KEYCLOAK_ID=gremion-ui       # Keycloak client ID
AUTH_KEYCLOAK_SECRET=           # Keycloak client secret
AUTH_KEYCLOAK_ISSUER=           # e.g. https://council.example/auth/realms/sturaos

# Internal service URLs (Docker network)
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_ADMIN_CLIENT_SECRET=   # Keycloak admin client secret

# Public URL (used for OIDC redirect URI)
PUBLIC_BASE_URL=https://council.example

# Storage backend for attachments (src/lib/server/storage/).
# 'local' (the only backend in the governance kernel) writes under
# RECEIPT_STORAGE_DIR (dev-friendly default).
STORAGE_BACKEND=local
RECEIPT_STORAGE_DIR=./var/storage
