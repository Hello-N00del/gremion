    "schemas": {
      "EventEnvelope": {
        "type": "object",
        "required": [
          "eventId",
          "eventType",
          "tenantId",
          "occurredAt",
          "payload"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid",
            "description": "Also the Nats-Msg-Id (JetStream dedup)."
          },
          "eventType": {
            "type": "string",
            "description": "Short event type from @gremion/ports/broker's GovernanceEvent union."
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "correlationId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The aggregate's own id (meeting_id, invitation_id or motion_id)."
          },
          "payload": {
            "type": "object",
            "description": "Event-specific payload (see envelope sub-schemas)."
          }
        }
      },
      "EnvelopeMeetingScheduled": {
        "allOf": [
          {
            "$ref": "#/components/schemas/EventEnvelope"
          },
          {
            "type": "object",
            "properties": {
              "payload": {
                "allOf": [
                  {
                    "type": "object",
                    "required": [
                      "meeting_id",
                      "body_id",
                      "org_unit_id",
                      "scheduled_start",
                      "scheduled_end",
                      "aggregate_version"
                    ],
                    "properties": {
                      "meeting_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "body_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "org_unit_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "scheduled_start": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "scheduled_end": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "aggregate_version": {
                        "type": "integer"
                      }
                    },
                    "description": "DOMAIN de.gremion.gov.meeting.scheduled.v1. Deliberately carries no title and no location — consumers read those live through gov.meeting-read v1 (DB-GOV-MEETING invariant).",
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        ]
      },
      "EnvelopeMeetingRescheduled": {
        "allOf": [
          {
            "$ref": "#/components/schemas/EventEnvelope"
          },
          {
            "type": "object",
            "properties": {
              "payload": {
                "allOf": [
                  {
                    "type": "object",
                    "required": [
                      "meeting_id",
                      "scheduled_start",
                      "scheduled_end",
                      "aggregate_version"
                    ],
                    "properties": {
                      "meeting_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "scheduled_start": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "scheduled_end": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "aggregate_version": {
                        "type": "integer"
                      }
                    },
                    "description": "DOMAIN de.gremion.gov.meeting.rescheduled.v1. No title or location.",
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        ]
      },
      "EnvelopeMeetingCancelled": {
        "allOf": [
          {
            "$ref": "#/components/schemas/EventEnvelope"
          },
          {
            "type": "object",
            "properties": {
              "payload": {
                "allOf": [
                  {
                    "type": "object",
                    "required": [
                      "meeting_id",
                      "cancel_reason",
                      "aggregate_version"
                    ],
                    "properties": {
                      "meeting_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "cancel_reason": {
                        "type": "string",
                        "enum": [
                          "cancelled_by_chair",
                          "body_archived"
                        ],
                        "description": "The Meeting lifecycle's two Cancelled edges: the chair cancels, or the body is archived (DOMAIN Meeting lifecycle) [A: value names chosen here]."
                      },
                      "aggregate_version": {
                        "type": "integer"
                      }
                    },
                    "description": "DOMAIN de.gremion.gov.meeting.cancelled.v1. No title or location.",
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        ]
      },
