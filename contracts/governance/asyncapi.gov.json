                  }
                ]
              }
            }
          }
        ]
      },
      "EnvelopeInvitationIssued": {
        "allOf": [
          {
            "$ref": "#/components/schemas/EventEnvelope"
          },
          {
            "type": "object",
            "properties": {
              "payload": {
                "allOf": [
                  {
                    "type": "object",
                    "required": [
                      "invitation_id",
                      "meeting_id",
                      "version",
                      "recipient_person_ids",
                      "notice_met"
                    ],
                    "properties": {
                      "invitation_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "meeting_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "version": {
                        "type": "integer"
                      },
                      "recipient_person_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uuid"
                        }
                      },
                      "notice_met": {
                        "type": "boolean"
                      }
                    },
                    "description": "DOMAIN de.gremion.gov.invitation.issued.v1. In-app delivery only; the mail copy goes through mail.send, not this event.",
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        ]
      },
      "EnvelopeNoticeOverridden": {
        "allOf": [
          {
            "$ref": "#/components/schemas/EventEnvelope"
          },
          {
            "type": "object",
            "properties": {
              "payload": {
                "allOf": [
                  {
                    "type": "object",
                    "required": [
                      "invitation_id",
                      "meeting_id",
                      "actor_person_id",
                      "days_short",
                      "curing_basis_id",
                      "curing_basis_version"
                    ],
                    "properties": {
                      "invitation_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "meeting_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "actor_person_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "days_short": {
                        "type": "integer"
                      },
                      "curing_basis_id": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "format": "uuid",
                        "description": "Null when the body has no curing basis configured; the override then states that none is configured (DB-GOV-CURING-BASIS [A])."
                      },
                      "curing_basis_version": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "description": "Version of the curing basis as recorded; null with curing_basis_id."
                      }
                    },
                    "description": "DOMAIN de.gremion.gov.notice.overridden.v1. Deliberately carries no free-text reason — never the override's reason field — per DOMAIN [D R20-D26-5]: only OPS's log stream consumes this, and the reason is not repeated into the event bus.",
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        ]
      },
