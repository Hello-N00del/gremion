{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Gremion governance module — meeting, invitation and motion lifecycle events",
    "version": "1.0.0",
    "description": "Eleven lifecycle events emitted by the governance service (TASK-083, DOMAIN DB-GOV events table): meeting scheduled/rescheduled/cancelled/opened/closed, invitation.issued, notice.overridden, and motion submitted/withheld/admitted/deferred. Subject grammar: gremion.{tenantId}.gov.{event} — built by govSubject() in @gremion/ports/broker (single source of truth for the wire subject; TASK-079/084 add the helper and topology entry). EventEnvelope field-matched to packages/ports/src/broker.ts EventEnvelope interface. Protocol, resolution, register and poll events are P3-additive and out of scope here (DOMAIN DB-GOV events table)."
  },
  "defaultContentType": "application/json",
  "channels": {
