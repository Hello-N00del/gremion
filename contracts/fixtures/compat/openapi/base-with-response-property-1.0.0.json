{
  "openapi": "3.1.0",
  "info": {
    "title": "compat fixture (response property)",
    "version": "1.0.0",
    "description": "T3 fixture: own base for the response-property-removal case. Kept separate from base-1.0.0.json so this schema addition does not leak into the other fixtures' diffs."
  },
  "paths": {
    "/widgets/{id}": {
      "get": {
        "summary": "Get a widget",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "name"],
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "description": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
