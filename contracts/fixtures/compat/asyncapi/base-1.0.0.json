{
  "asyncapi": "3.0.0",
  "info": {
    "title": "compat fixture",
    "version": "1.0.0",
    "description": "T4 fixture: base document all the other fixtures in this directory diff against."
  },
  "channels": {
    "widget.created": {
      "address": "gremion.default.widget.created.v1"
    }
  },
  "operations": {
    "onWidgetCreated": {
      "action": "receive",
      "channel": { "$ref": "#/channels/widget.created" }
    }
  },
  "components": {
    "messages": {
      "WidgetCreated": {
        "payload": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "status": { "type": "string", "enum": ["draft", "active", "archived"] }
          }
        }
      }
    }
  }
}
