##############################################################
# Gremion — Environment Configuration Template
#
# Copy to .env, then run: ./scripts/setup.sh
# The setup script generates random secrets for all placeholder
# values and fills in the domain automatically.
#
# DO NOT commit .env to version control.
##############################################################

# ── Domain ────────────────────────────────────────────────
# Local development: leave as localhost
# Production: set to your domain (e.g. stura.example.com)
DOMAIN=localhost

# TASK-028 (TRD-039): docker-compose.app.yml binds the app's DOMAIN once, from
# PLATFORM_DOMAIN, with `:?` -- every production render aborts while it is
# unset. The host env files (infra/host/templates/env/state.env.tmpl) carry it
# directly; on a workstation / CI copy it is derived from DOMAIN above, so the
# domain setup.sh writes there is the only one. Keep this line as is.
PLATFORM_DOMAIN=${DOMAIN}

# TASK-041 (TRD-074/075): there is no wildcard tenant edge. A request is
# resolved by its WHOLE host (a tenant_domain row); DOMAIN only names the apex,
# which binds no tenant. Each tenant host gets its own Host-literal router
# (docs/runbooks/tenant-edge.md STEP 0a).

# G-082 (Mediums Cluster 4 / T2.1): IPAllowList CIDRs that may reach the
# Keycloak admin console + Admin REST API at https://${DOMAIN}/auth/admin.
# Default 127.0.0.1/32 means no external request matches — operators must
# use `docker compose exec keycloak /opt/keycloak/bin/kcadm.sh` or
# `kubectl port-forward` until they explicitly opt in.
# Set to a comma-separated CIDR list to allow bastion / VPN access, e.g.:
#   KC_ADMIN_ALLOWLIST_CIDRS=203.0.113.10/32,198.51.100.0/24
KC_ADMIN_ALLOWLIST_CIDRS=127.0.0.1/32

# ── Edge (Traefik, production profile; TASK-022) ─────────
# docker-compose.yml's x-required-env refuses every compose verb while any key
# below is unset or empty, so an empty bind address can never publish on
# 0.0.0.0. The host's values live in /opt/gremion/etc/env/state.env
# (infra/host/templates/env/state.env.tmpl); these are loopback defaults for a
# workstation. test/host/edge-env.bats keeps the two files' key sets in step.
# Stack name (the ACME volume is the external ${STACK}_traefik_acme, which
# infra/host/bootstrap.sh creates) and the root whose etc/edge directory is
# Traefik's read-only router directory.
STACK=gremion
GREMION_ROOT=/opt/gremion
# ACME (Let's Encrypt over HTTP-01). ACME_EMAIL is required whenever
# TRAEFIK_CERT_RESOLVER is non-empty; set TRAEFIK_CERT_RESOLVER= (empty) only
# where TLS terminates in front of Traefik. ACME_CA_SERVER ships as a reserved
# .invalid name so a copied template can never place a real order; a host sets
# the production directory (state.env.tmpl ships it):
#   https://acme-v02.api.letsencrypt.org/directory
# and rehearses against the staging directory first:
#   https://acme-staging-v02.api.letsencrypt.org/directory
ACME_EMAIL=
TRAEFIK_CERT_RESOLVER=le-http
ACME_CA_SERVER=https://acme.invalid/directory
# The pinned ${STACK}_edge subnets, trusted for forwarded headers.
EDGE_V4_SUBNET=10.90.0.0/24
EDGE_V6_SUBNET=fd5a:90::/64
EDGE_BIND_IP=127.0.0.1
EDGE_BIND_IP6=::1
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
# The Traefik API and the internaltest entrypoint publish on 127.0.0.1 only.
TRAEFIK_API_PORT=8080
INTERNALTEST_PORT=8081

# ── Pooled stack: profiles, image tag and the app tier (TASK-040) ─────────
# The state project's profiles. `dev` starts mailpit, the SMTP catcher, which
# is dev-only (TRD "mailpit: not deployed"); without it the dev mail capture
# silently disappears. A host renders with COMPOSE_PROFILES=production.
COMPOSE_PROFILES=dev
# Image tag for every first-party ghcr.io/hello-n00del/gremion-* image. On a
# host this is the release tag and docker-compose.pins.yml resolves each to a
# digest; `make up` / `make build` override it with `dev`.
IMAGE_TAG=dev
# The app tier (docker-compose.app.yml) refuses to render without these and
# PLATFORM_DOMAIN (bound once, near the top, from DOMAIN). On a host they
# come from app-<colour>.env; locally `make up` runs one colour, blue, as
# the project ${STACK}-app-blue (STACK=dev).
APP_V4_SUBNET=10.91.2.0/24
APP_V6_SUBNET=fd5a:192::/64

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres_root

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME_keycloak_db
KEYCLOAK_DB_NAME=keycloak

# ── Keycloak ──────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin
# Service account secret for gremion-ui → Keycloak admin API calls
KEYCLOAK_ADMIN_CLIENT_SECRET=
# RS256 public key in PEM format (single line with \n), filled after first start
KEYCLOAK_JWT_PUBLIC_KEY=
KEYCLOAK_ISSUER_URL=http://keycloak:8080/auth/realms/gremion

# B-01: the realm a dev/ops script addresses over the Keycloak Admin API.
# There is no boot-imported realm any more — every realm is created by
# tenant-create and named after the tenant slug (pipeline.ts:186).
KEYCLOAK_REALM=gremion

# OIDC client secrets. B-01 (spec B T.4): nothing is imported at boot any more —
# buildTenantRealmDoc substitutes these into the composed per-tenant realm doc
# at provisioning time (gremion-ui/src/lib/server/tenant/provisioner/realm-doc.ts).
# Both MUST be set — provisioning throws on a missing secret. Generated by
# scripts/setup.sh.
GREMION_UI_OIDC_CLIENT_SECRET=CHANGE_ME_gremion_ui_oidc
GREMION_ADMIN_OIDC_CLIENT_SECRET=CHANGE_ME_gremion_admin_oidc

# ── Chat module: Synapse on its own PostgreSQL (TASK-198) ──
# Read only with the messaging profile (COMPOSE_PROFILES=...,messaging):
# messaging-postgres and matrix. The two passwords ship EMPTY here, not as
# CHANGE_ME_ placeholders: scripts/setup.sh does not generate them, and a
# placeholder it cannot replace fails its whole run. Set both before enabling
# the profile (messaging-postgres' initdb refuses an empty SYNAPSE_DB_PASSWORD).
# A host generates them (infra/host/templates/env/state.env.tmpl). The issuer
# stays empty until the realm exists; Synapse refuses to boot without it.
MESSAGING_PG_USER=messaging
MESSAGING_PG_PASSWORD=
SYNAPSE_DB_PASSWORD=
SYNAPSE_KEYCLOAK_ISSUER_URL=
SYNAPSE_KEYCLOAK_FETCH_URL=

# ── Gremion UI (SvelteKit / Auth.js) ─────────────────────
# Generated by setup.sh (openssl rand -hex 32)
AUTH_SECRET=
AUTH_KEYCLOAK_ID=gremion-ui
# The gremion-ui client secret of the realm named below. Nothing creates that
# realm at boot any more (B-01): fill this in after tenant-create has composed
# the realm — see docs/DEVELOPMENT.md
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=http://keycloak:8080/auth/realms/gremion
PUBLIC_BASE_URL=http://localhost:3000

# G-075: shared secret used by gremion-ui's server-only `internalFetch` helper
# to authenticate same-app internal HTTP calls. Consumer routes constant-time-
# compare the `Authorization: Bearer <secret>` header against this value.
# Generated by scripts/setup.sh.
INTERNAL_PUSH_SECRET=CHANGE_ME_internal_push_secret

# P2.1c (#202): the in-container/in-cluster origin that internalFetch's
# server-to-server hop targets (resolveInternalBaseUrl in internal-fetch.ts).
# It MUST be the in-container origin (the compose service name `gremion-ui` on
# adapter-node's port 3000) and NOT the public apex: the inner hop must never
# traverse the edge. The X-Forwarded-Host it stamps (the tenant's registered
# primary host) is the ENTIRE tenant selector, so an edge that restated it
# would aim the self-call at another tenant's data plane (cross-tenant
# read+write). The compose files set this on the gremion-ui service; leave the
# value below as-is unless you change the service name/port.
INTERNAL_BASE_URL=http://gremion-ui:3000

# P2.1c T5 (#202): executable proxy-trust. When set, Traefik injects this value
# as `x-proxy-trust` on the gremion-ui routers and the tenant resolver
# (resolve.ts isProxyTrusted) 403s any request lacking a constant-time match —
# so x-forwarded-host trust no longer rests on network topology alone. Leave
# UNSET (the default) for local dev: the resolver gate is then a byte-identical
# no-op. Set it (env + the Traefik label move together) at the S4 deploy.
# Generate: openssl rand -hex 32
# TENANT_PROXY_SHARED_SECRET=

# Seeding — the one-time POST /api/setup/seed endpoint.
# SEED_TOKEN gates the endpoint; SEED_USER_PASSWORD is the password set on
# every seeded test-fixture user. Leave SEED_TOKEN empty to disable the endpoint.
SEED_TOKEN=CHANGE_ME_seed_token
SEED_USER_PASSWORD=CHANGE_ME_seed_user_pw

# ── Outgoing Email / SMTP (#162) ──────────────────────────
# By DEFAULT the stack sends mail to the Mailpit catcher service
# (host=mailpit, port=1025, no auth, TLS off). Nothing leaves the host;
# read trapped mail at http://localhost:8026 (web UI). You normally need
# NONE of the vars below for staging — the compose defaults already point
# at Mailpit. Set them only to switch to a real outbound relay.
# Full activation steps: docs/runbooks/email-smtp.md
#
# gremion-ui's host/port/from come from the Settings → E-Mail wizard (stored in
# config), NOT from env — only the SMTP password is read from EMAIL_HOST_PASSWORD.
# EMAIL_HOST_PASSWORD=
#
# SMTP_TEST_ALLOW_PRIVATE — the SMTP connection test (/api/setup/test-smtp)
# opens an outbound connection to a caller-supplied host, so it refuses every
# target that is not a demonstrably public address. Set this to 1 ONLY to test
# an internal relay (e.g. the Mailpit catcher on the container network). It
# widens the check for RFC1918 (10/8, 172.16/12, 192.168/16) and IPv6
# unique-local (fc00::/7) and nothing else — loopback, link-local, CGNAT and
# metadata addresses stay refused with it set. Leave it empty in production.
# Compose reads this file at container CREATE time:
#   docker compose up -d --force-recreate gremion-ui
# Details: docs/security/test-smtp-guard.md
# SMTP_TEST_ALLOW_PRIVATE=1
#
# PLATFORM mail (Keycloak realms: login, password reset, verify-email) is a
# separate path from the app mailer above. The provisioner reads it at
# tenant-create time from the HOST's mail.env (infra/host/templates/env/
# mail.env.tmpl), not from this file; the keys are listed here so they are not
# rediscovered in realm-doc.ts. Realm creation FAILS CLOSED when they are wrong.
#   MAIL_TRANSPORT=relay|stalwart  no default; unset is a named failure
#   PLATFORM_DOMAIN=               stalwart sender domain; relay fallback From domain
# relay mode only (ignored for stalwart):
#   RELAY_SMTP_HOST=               required
#   RELAY_SMTP_PORT=587            default 587; 465 = implicit TLS, else STARTTLS
#   RELAY_SMTP_USER=               empty = IP-allow-listed relay, no authentication
#   RELAY_SMTP_PASSWORD_REF=       REQUIRED when RELAY_SMTP_USER is set. A secret
#                                  REF, never the password: secret:<name>
#                                  (<root>/etc/secrets/<name>, mode 0600) or
#                                  file:<absolute path>. An inline RELAY_SMTP_PASSWORD
#                                  is ignored.
#   RELAY_FROM_DOMAIN=             From domain the relay signs; empty = PLATFORM_DOMAIN
# Details: docs/runbooks/email-smtp.md#platform-mail-transport-relay-or-bundled-stalwart
#
# ─────────────────────────────────────────────────────────────────────
# PRODUCTION: point at a real outbound SMTP relay. Set host/port/from in
# gremion-ui via Settings → E-Mail, and put the password in EMAIL_HOST_PASSWORD
# (NO real secrets in this template — set it on the prod host).
# ─────────────────────────────────────────────────────────────────────

# ── Gremion Application Database ────────────────────────────
GREMION_DB_USER=gremion
# Generate: openssl rand -hex 32
GREMION_DB_PASSWORD=CHANGE_ME_gremion_db
GREMION_DB_NAME=gremion

# ── Tenancy control-plane database (P2.1c T1, #202) ───────
# Tenant registry + fleet-migration ledger (gremion-ui/migrations-control/).
# Created by docker/postgres/init-databases.sh on FIRST init only — on an
# existing volume run the one-shot in docs/runbooks/tenant-edge.md step 3.
# D-CONTROLDIRECT: gremion-ui connects DIRECTLY to postgres:5432 for this DB,
# never through the production PgBouncer overlay.
CONTROL_DB_USER=control
# Generate: openssl rand -hex 32.
# Rotate: ALTER ROLE control WITH PASSWORD '<new>'; then update this value and
# `up -d --force-recreate gremion-ui postgres` (a plain `restart` will NOT
# reload .env — see docs/runbooks notes on the compose-env lesson).
CONTROL_DB_PASSWORD=CHANGE_ME_control_db
CONTROL_DB_NAME=control

# ── Platform database (TASK-043, gremion_platform) ────────
# The provisioning ledger and module catalogue (plt.*). Created by
# `gremion-tenant init` (ensurePlatformDatabase), never by init-databases.sh.
# tenant-create in docker-compose.app.yml connects DIRECTLY (never the pooler)
# as PLATFORM_DB_USER; compose refuses to render without it.
# Generate: openssl rand -hex 32.
PLATFORM_DB_USER=gremion_platform
PLATFORM_DB_PASSWORD=CHANGE_ME_platform_db
# The control panel's READ-ONLY role (SELECT on tenant, tenant_domain and
# plt.provisioning_step only), made by `gremion-tenant init`. Generate as above.
PANEL_DB_USER=gremion_panel
PANEL_DB_PASSWORD=CHANGE_ME_panel_db
# TASK-077: the kernel API's READ-ONLY role (SELECT on the control registry's tenant/tenant_domain
# and plt.module*, nothing else; ensureKernelApiReader). Generate as above.
KERNEL_API_DB_USER=gremion_kernel_api
KERNEL_API_DB_PASSWORD=CHANGE_ME_kernel_api_db
# Durable pre-migration dump dir bind-mounted into kernel-api-migrate at the same path
# (0700, owned by uid 1000). Dev: create it first (mkdir -m 700 <dir>).
GREMION_MIGRATION_DUMP_DIR=/opt/gremion/migration-dumps

# ── PgBouncer (production overlay only, P2.1b T11) ────────
# Password for the pgbouncer_auth login role (the auth_query lookup user —
# docker/pgbouncer/pgbouncer-auth.sql). NOT read by compose: it is used at
# deploy to render docker/pgbouncer/userlist.txt from userlist.txt.example
# and to create the role. See docs/runbooks/pgbouncer.md.
# Generate: openssl rand -hex 32
PGBOUNCER_AUTH_PASSWORD=CHANGE_ME_pgbouncer_auth

# ── Tenancy (P2.1b) ───────────────────────────────────────
# §7.6 per-tenant rate limit at the resolution seam; unset = disabled.
# RPS = sustained tokens/second per tenant; BURST = bucket capacity
# (defaults to ceil(RPS) when unset). See gremion-ui/src/lib/server/tenant/rate-limit.ts.
# TENANT_RATE_LIMIT_RPS=
# TENANT_RATE_LIMIT_BURST=
# P2.1c T1 (#202) D-SECMOUNT: host directory bind-mounted read-only into
# gremion-ui at /run/secrets/tenants — per-tenant secret files written by the
# provisioner appear in the running container live, no recreate needed.
# Create it before `up`: mkdir -p secrets/tenants
#
# ⚠️ MUST be a DEDICATED LEAF directory holding ONLY per-tenant secret files.
# NEVER point it at the secrets/ ROOT (or any parent) — that directory is mounted
# into the TENANT DATA-PLANE container, so it must NOT contain the §7.2
# least-privilege provisioner credential (TENANT_PROVISIONER_SECRET_FILE, default
# ./secrets/tenant_provisioner, see gremion-ui/scripts/tenant-provision.ts) nor any
# other infra secret. If the cred is inside this dir, an in-container compromise
# could read it and mint/destroy tenants. The `pnpm -C gremion-ui check` guard
# (scripts/check-tenant-secrets-dir.mjs) fails the build if the provisioner
# credential resolves inside TENANT_SECRETS_DIR.
# TENANT_SECRETS_DIR=./secrets/tenants

# ── B5 Public Portal ──────────────────────────────────────
# Read-only PostgreSQL role password for gremion-public container
# Generate: openssl rand -hex 32
PUBLIC_DB_PASSWORD=CHANGE_ME_public_reader
GREMION_PUBLIC_DB_URL=postgresql://gremion_public_reader:CHANGE_ME_public_reader@postgres:5432/gremion

# Public portal contact info for Impressum (TMG §5)
PUBLIC_CONTACT_NAME=Mustergremium
PUBLIC_CONTACT_ADDRESS=Musterstraße 1, 12345 Musterstadt
PUBLIC_CONTACT_EMAIL=rat@council.example
PUBLIC_CONTACT_PHONE=
PUBLIC_IMPRINT_RESPONSIBLE=Vorsitz des Gremiums

# v12 apex topology — where the portal is MOUNTED. Empty (default) serves it at
# `/`, which is what the committed `Host(public.${DOMAIN})` router expects. This
# is a BUILD arg, not a runtime setting: SvelteKit bakes kit.paths.base into the
# bundle, so changing it requires `docker compose build gremion-public`. Set it
# only together with a router rule that routes that prefix here.
# PUBLIC_BASE_PATH=/portal

# v12 apex topology — optional back-route from the portal up to a site ABOVE it
# (a landing / marketing site at the origin root). All four are unset by default
# and the portal then renders neither the apex strip nor the footer colophon —
# a kernel deployed on its own has no site above it, and a dangling link is
# worse than no link. Strip and colophon each need BOTH a URL and their label.
# PUBLIC_APEX_URL=https://example.org
# PUBLIC_APEX_LABEL=example.org
# PUBLIC_APEX_NOTE=Produkt & Info
# PUBLIC_APEX_COLOPHON=Läuft auf Gremion — Produkt & Info

# AGPL-3.0 section 13 — the Corresponding Source offer both app shells render in
# their footer. If you MODIFIED Gremion, set this to the repository holding your
# version: upstream is not the corresponding source of what you are serving, and
# an offer pointing there is false. Leave it unset for an unmodified deployment
# and both shells fall back to upstream. Passed to gremion-ui and gremion-public
# by docker-compose.yml; the k8s equivalent is each app's configmap.
# PUBLIC_SOURCE_URL=https://git.council.example/gremion

# ── Hardening ─────────────────────────────────────────────
# Log retention in seconds (days × 86400). GDPR-safe defaults shown.
# Operator ceiling 30 d [D R29-I6] (R29-RETENTION-30-K): no log class is kept
# longer than 30 days. The gremion-ui Settings tab and API enforce the caps in
# gremion-ui/src/lib/retention-tiers.ts (29 d where the daily purge tick
# enforces the window, 30 d for the no-PII tier). The edge files and Keycloak
# events are bound at 30 d by docker/vector/logrotate.conf + prune-retained.sh
# and the realm export (docs/log-retention-policy.md "Upper bound"). Only
# LOG_ACCESS_RETENTION_SECONDS is read by docker-compose.yml; the other three
# document the tier defaults. The application tiers without a purge consumer
# change with TASK-033.
LOG_ACCESS_RETENTION_SECONDS=1209600      # 14 days (hard cap: 2505600 = 29d)
LOG_APP_RETENTION_SECONDS=2419200         # 28 days (hard cap: 2505600 = 29d)
LOG_SECURITY_RETENTION_SECONDS=2332800    # 27 days (hard cap: 2505600 = 29d)
LOG_SECURITY_NOPII_RETENTION_SECONDS=2332800  # 27 days (hard cap: 2592000 = 30d)

# Backup (restic + rclone — provider-agnostic)
RESTIC_PASSWORD=CHANGE_ME_restic_repo_password
RCLONE_BACKEND_TYPE=s3            # s3 | sftp | b2
RCLONE_ENDPOINT=                  # provider endpoint URL
RCLONE_ACCESS_KEY_ID=
RCLONE_SECRET_ACCESS_KEY=
RCLONE_BUCKET=
